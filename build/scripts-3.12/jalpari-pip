#!python
"""The Jal Pari Language — pip-installed command wrapper.

Installed by `pip install .` alongside the repo tree under
<sys.prefix>/share/jalpari. Finds forge.py there (or under
$JALPARI_HOME) and runs it. Publishing to PyPI still needs
the maintainer's PyPI account/token — this file only makes
the local `pip install .` path work.
"""
import os
import sys


def find_repo():
    env = os.environ.get("JALPARI_HOME")
    if env and os.path.exists(os.path.join(env, "forge.py")):
        return env
    for base in (sys.prefix, "/usr/local", os.path.expanduser("~/.local")):
        cand = os.path.join(base, "share", "jalpari")
        if os.path.exists(os.path.join(cand, "forge.py")):
            return cand
    return None


def main():
    repo = find_repo()
    if repo is None:
        print("jalpari: could not find forge.py under <prefix>/share/jalpari; "
              "set JALPARI_HOME to the checkout.", file=sys.stderr)
        return 1
    os.execv(sys.executable, [sys.executable, os.path.join(repo, "forge.py")] + sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
