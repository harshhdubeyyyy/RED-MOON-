fn main() -> int {
    // Break must free the loop body's locals: 4 iterations allocate,
    // 3 exit normally and 1 exits via break, so frees must equal allocs.
    let mut i = 0;
    while i < 10 {
        let xs: [int] = [1, 2, 3];
        if i == 3 {
            break;
        }
        i = i + 1;
    }
    println("allocs =", arr_alloc_count(), "frees =", arr_free_count());
    return 0;
}
