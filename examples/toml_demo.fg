import "toml.fg";

fn main() -> int {
    let text: str = "# demo config\ntitle = \"Jal Pari\"\n[server]\nhost = \"localhost\"\nport = 8080\nratio = 1.5\nenabled = true\n";
    let cfg: Toml = toml_parse(text);
    println("title =", toml_get(cfg, "title"));
    println("host =", toml_get(cfg, "server.host"));
    println("port =", toml_get_int(cfg, "server.port"));
    println("ratio =", toml_get_float(cfg, "server.ratio"));
    println("enabled =", toml_get_bool(cfg, "server.enabled"));
    println("has missing =", toml_has(cfg, "server.missing"));
    return 0;
}
