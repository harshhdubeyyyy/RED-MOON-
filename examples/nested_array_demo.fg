fn main() -> int {
    let mut m: [[int]] = [[1, 2, 3], [4, 5, 6]];
    println("rows =", len(m), "cols =", len(m[0]));
    println("m01 =", m[0][1], "m12 =", m[1][2]);
    let mut total = 0;
    for row in m {
        for x in row {
            total = total + x;
        }
    }
    println("total =", total);
    push(m, [7, 8, 9]);
    println("after push rows =", len(m), "m20 =", m[2][0]);
    m[0][1] = 20;
    println("after set =", m[0][1]);
    let row = m[1];
    row[0] = 40;
    println("shared row =", m[1][0]);
    let r2 = [10, 20];
    m[1] = r2;
    println("after row set =", m[1][0], m[1][1]);
    return 0;
}
