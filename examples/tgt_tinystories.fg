// Tensor-GPT TinyStories training (0.5.0): the same model
// and data as gpt_tinystories.fg (2 blocks, 2 heads, d=16,
// hidden=32, seq=8 words, 500-word vocab, 12,608 params,
// 500 strided windows x 3 epochs, Adam lr 0.02, clip 1.0),
// rebuilt on tensor autograd. The comparison that matters:
// scalar forward = ~221,844 nodes; tensor forward = tens
// of nodes. Training time, memory behaviour and held-out
// perplexity are printed so the two runs can be compared
// directly. Init differs from the scalar run (weights
// uniform [-0.1, 0.1], gamma 1, biases 0 — see tgt.fg),
// so perplexities should be in the same ballpark, not
// identical.
import "tgt.fg";

fn load_vocab() -> [str] {
    let text: str = read_file("data/tinystories_vocab.txt");
    let lines: [str] = split(text, "\n");
    let mut out: [str] = [];
    for line in lines {
        if len(line) > 0 {
            push(out, line);
        }
    }
    return out;
}

fn load_ids() -> [int] {
    let text: str = read_file("data/tinystories_ids.txt");
    let parts: [str] = split(text, " ");
    let mut out: [int] = [];
    for piece in parts {
        if len(piece) > 0 {
            push(out, parse_int(piece));
        }
    }
    return out;
}

fn word_id(vocab: [str], word: str) -> int {
    let mut i: int = 0;
    while i < len(vocab) {
        if vocab[i] == word {
            return i;
        }
        i = i + 1;
    }
    return len(vocab) - 1;
}

fn build_leaves(params: [float], v: int, d: int, seq: int, hidden: int, blocks: int) -> TAg {
    let sizes: [int] = tgt_param_sizes(v, d, seq, hidden, blocks);
    let shapes: [int] = tgt_param_shapes(v, d, seq, hidden, blocks);
    let mut s: TAg = TAg { tape: ttape_new(), last: -1 };
    let mut off: int = 0;
    let mut k: int = 0;
    while k < len(sizes) {
        let rows: int = shapes[k * 2];
        let cols: int = shapes[k * 2 + 1];
        let mut shape: [int] = [];
        if cols == 0 {
            push(shape, rows);
        } else {
            push(shape, rows);
            push(shape, cols);
        }
        let data: [float] = fslice(params, off, sizes[k]);
        s = t_leaf(s.tape, shape, data);
        off = off + sizes[k];
        k = k + 1;
    }
    return s;
}

fn param_ids(count: int) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < count {
        push(out, i);
        i = i + 1;
    }
    return out;
}

fn window_loss(params: [float], ids: [int], start: int, v: int, d: int, seq: int, hidden: int, blocks: int, heads: int) -> float {
    let mut x: [int] = [];
    let mut y: [int] = [];
    let mut i: int = 0;
    while i < seq {
        push(x, ids[start + i]);
        push(y, ids[start + i + 1]);
        i = i + 1;
    }
    let mut s: TAg = build_leaves(params, v, d, seq, hidden, blocks);
    let pids: [int] = param_ids(2 + blocks * 12 + 2);
    s = tgt_logits(s, x, pids, v, d, seq, hidden, blocks, heads);
    let lg: int = s.last;
    s = t_cross_entropy(s, lg, y);
    return s.tape.vals[s.tape.voff[s.last]];
}

fn eval_loss(params: [float], ids: [int], first: int, count: int, v: int, d: int, seq: int, hidden: int, blocks: int, heads: int) -> float {
    let mut total: float = 0.0;
    let mut w: int = 0;
    while w < count {
        total = total + window_loss(params, ids, first + w, v, d, seq, hidden, blocks, heads);
        w = w + 1;
    }
    return total / count as float;
}

fn gen_words(params: [float], ctx0: [int], vocab: [str], steps: int, sampled: bool, v: int, d: int, seq: int, hidden: int, blocks: int, heads: int) -> str {
    let mut ctx: [int] = ctx0;
    let mut gen: str = vocab[ctx0[0]];
    let mut i: int = 1;
    while i < seq {
        gen = gen + " " + vocab[ctx0[i]];
        i = i + 1;
    }
    let mut seed: int = 123;
    let mut step: int = 0;
    while step < steps {
        let mut s: TAg = build_leaves(params, v, d, seq, hidden, blocks);
        let pids: [int] = param_ids(2 + blocks * 12 + 2);
        s = tgt_logits(s, ctx, pids, v, d, seq, hidden, blocks, heads);
        let lg: int = s.last;
        let logits: [float] = tvals_of(s.tape, lg);
        let mut last_row: [float] = [];
        let mut c: int = 0;
        while c < v {
            push(last_row, logits[(seq - 1) * v + c]);
            c = c + 1;
        }
        let mut best: int = 0;
        if sampled {
            let probs: [float] = tensor_softmax1(last_row);
            seed = tgt_lcg(seed);
            let r: float = seed as float / 2147483647.0;
            let mut acc: float = 0.0;
            c = 0;
            while c < v {
                acc = acc + probs[c];
                if r < acc {
                    best = c;
                    c = v;
                } else {
                    c = c + 1;
                }
            }
        } else {
            c = 1;
            while c < v {
                if last_row[c] > last_row[best] {
                    best = c;
                }
                c = c + 1;
            }
        }
        gen = gen + " " + vocab[best];
        let mut next: [int] = [];
        let mut j: int = 1;
        while j < seq {
            push(next, ctx[j]);
            j = j + 1;
        }
        push(next, best);
        ctx = next;
        step = step + 1;
    }
    return gen;
}

fn main() -> int {
    let vocab: [str] = load_vocab();
    let ids: [int] = load_ids();
    let v: int = len(vocab);
    let d: int = 16;
    let seq: int = 8;
    let hidden: int = 32;
    let blocks: int = 2;
    let heads: int = 2;
    println("words =", len(ids), "vocab =", v);
    println("params =", tgt_param_count(v, d, seq, hidden, blocks));
    let mut params: [float] = tgt_init_params(v, d, seq, hidden, blocks, 42);
    let test_before: float = eval_loss(params, ids, 20000, 20, v, d, seq, hidden, blocks, heads);
    println("test loss before =", test_before, "ppl =", exp(test_before));
    // Node count for one forward, as the headline comparison.
    let mut x0: [int] = [];
    let mut y0: [int] = [];
    let mut i: int = 0;
    while i < seq {
        push(x0, ids[i]);
        push(y0, ids[i + 1]);
        i = i + 1;
    }
    let mut s0: TAg = build_leaves(params, v, d, seq, hidden, blocks);
    let pids0: [int] = param_ids(2 + blocks * 12 + 2);
    s0 = tgt_logits(s0, x0, pids0, v, d, seq, hidden, blocks, heads);
    println("tensor forward nodes =", len(s0.tape.voff));
    let mut st: TAdam = tgt_adam_new(params);
    let t0: int = clock_micros();
    let mut epoch: int = 0;
    while epoch < 3 {
        let mut total: float = 0.0;
        let mut w: int = 0;
        while w < 500 {
            let start: int = w * 4;
            let mut x: [int] = [];
            let mut y: [int] = [];
            i = 0;
            while i < seq {
                push(x, ids[start + i]);
                push(y, ids[start + i + 1]);
                i = i + 1;
            }
            let mut s: TAg = build_leaves(st.params, v, d, seq, hidden, blocks);
            let pids: [int] = param_ids(2 + blocks * 12 + 2);
            s = tgt_logits(s, x, pids, v, d, seq, hidden, blocks, heads);
            let lg: int = s.last;
            s = t_cross_entropy(s, lg, y);
            let loss_node: int = s.last;
            total = total + s.tape.vals[s.tape.voff[loss_node]];
            let grads: [float] = t_backward(s.tape, loss_node);
            let mut flat: [float] = [];
            let mut k: int = 0;
            while k < len(pids) {
                let gk: [float] = t_grad_of(s.tape, grads, pids[k]);
                for gv in gk {
                    push(flat, gv);
                }
                k = k + 1;
            }
            let clipped: [float] = tgt_grad_clip(flat, 1.0);
            st = tgt_adam_step(st, clipped, 0.02);
            w = w + 1;
        }
        println("epoch", epoch, "avg loss =", total / 500.0);
        epoch = epoch + 1;
    }
    let t1: int = clock_micros();
    println("train micros =", t1 - t0, "per step =", (t1 - t0) as float / 1500.0);
    let test_after: float = eval_loss(st.params, ids, 20000, 20, v, d, seq, hidden, blocks, heads);
    println("test loss after =", test_after, "ppl =", exp(test_after));
    let mut ctx: [int] = [];
    push(ctx, word_id(vocab, "once"));
    push(ctx, word_id(vocab, "upon"));
    push(ctx, word_id(vocab, "a"));
    push(ctx, word_id(vocab, "time"));
    push(ctx, word_id(vocab, "there"));
    push(ctx, word_id(vocab, "was"));
    push(ctx, word_id(vocab, "a"));
    push(ctx, word_id(vocab, "little"));
    println("greedy =", gen_words(st.params, ctx, vocab, 30, false, v, d, seq, hidden, blocks, heads));
    println("sampled =", gen_words(st.params, ctx, vocab, 30, true, v, d, seq, hidden, blocks, heads));
    return 0;
}
