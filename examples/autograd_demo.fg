// Autograd demo + gradient check.
// f(x, y) = (x + y) * x + sigmoid(x). At x=3, y=4:
// f = 21 + 0.952574, df/dx = (x+y) + x + sig*(1-sig) = 7 + 3 + 0.045177
// = 10.0452 (printed with Jal Pari's float formatting), df/dy = x = 3.
// The numeric check perturbs x by 0.0001 in plain floats and must
// agree with the tape gradient to ~0.001.
import "autograd.fg";

fn f_plain(x: float, y: float) -> float {
    return (x + y) * x + 1.0 / (1.0 + exp(-x));
}

fn main() -> int {
    let mut s: Ag = ag_input(tape_new(), 3.0);
    let x: int = s.last;
    s = ag_input(s.tape, 4.0);
    let y: int = s.last;
    s = ag_add(s, x, y);
    let sum: int = s.last;
    s = ag_mul(s, sum, x);
    let prod: int = s.last;
    s = ag_sigmoid(s, x);
    let sig: int = s.last;
    s = ag_add(s, prod, sig);
    let out: int = s.last;
    s = ag_backward(s, out);
    println("f =", ag_value(s, out));
    println("dfdx =", ag_grad(s, x));
    println("dfdy =", ag_grad(s, y));
    let h: float = 0.0001;
    let num: float = (f_plain(3.0 + h, 4.0) - f_plain(3.0 - h, 4.0)) / (2.0 * h);
    println("numeric dfdx =", num);
    return 0;
}
