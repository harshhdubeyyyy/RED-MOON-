fn main() -> int {
    // Nested while loops: break exits only the inner loop.
    let mut count = 0;
    let mut a = 0;
    while a < 3 {
        let mut b = 0;
        while true {
            if b == 2 {
                break;
            }
            count = count + 1;
            b = b + 1;
        }
        a = a + 1;
    }
    return count;
}
