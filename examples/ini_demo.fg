import "ini.fg";

fn main() -> int {
    let text: str = "; demo ini\n[app]\nname = Jal Pari\nversion = 3\n[db]\nhost = localhost\n";
    let cfg: Ini = ini_parse(text);
    println("name =", ini_get(cfg, "app.name"));
    println("version =", ini_get(cfg, "app.version"));
    println("host =", ini_get(cfg, "db.host"));
    println("missing =", ini_get_or(cfg, "db.port", "5432"));
    println("has =", ini_has(cfg, "app.name"), ini_has(cfg, "app.nope"));
    return 0;
}
