// The Jal Pari Language — a real app: a tiny todo CLI.
// Usage:
//   python3 forge.py run examples/apps/todo.fg -- add "buy milk"
//   python3 forge.py run examples/apps/todo.fg -- list
//   python3 forge.py run examples/apps/todo.fg -- done 0
// Tasks are stored one per line in todo.txt, "[ ] task" or "[x] task".
import "strings.fg";

fn main() -> int {
    let argv: [str] = args();
    if len(argv) == 0 {
        println("usage: todo add <task> | todo list | todo done <index>");
        return 1;
    }
    let cmd: str = argv[0];
    let mut tasks: [str] = [];
    if file_exists("todo.txt") {
    let existing: str = read_file("todo.txt");
    if len(existing) > 0 {
        let lines: [str] = lines_of(existing);
        for line in lines {
            if len(line) > 0 {
                push(tasks, line);
            }
        }
    }
    }
    if cmd == "add" {
        if len(argv) < 2 {
            println("usage: todo add <task>");
            return 1;
        }
        push(tasks, "[ ] " + argv[1]);
        println("added:", argv[1]);
    } else {
        if cmd == "list" {
            let mut i: int = 0;
            while i < len(tasks) {
                println(i, tasks[i]);
                i = i + 1;
            }
            return 0;
        }
        if cmd == "done" {
            if len(argv) < 2 {
                println("usage: todo done <index>");
                return 1;
            }
            let idx: int = parse_int(argv[1]);
            if idx < 0 {
                println("done: bad index");
                return 1;
            }
            if idx >= len(tasks) {
                println("done: no such task");
                return 1;
            }
            tasks[idx] = "[x] " + substr(tasks[idx], 4, len(tasks[idx]) - 4);
            println("done:", tasks[idx]);
        } else {
            println("unknown command:", cmd);
            return 1;
        }
    }
    let mut out: str = "";
    for t in tasks {
        out = out + t + "\n";
    }
    if write_file("todo.txt", out) {
        return 0;
    }
    println("write failed");
    return 1;
}
