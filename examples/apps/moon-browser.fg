// Moon Browser — a TEXT browser (honest naming: Jal Pari has no
// rendering engine, no layout, and no JavaScript, so this fetches a
// page and prints its readable text, with all HTML tags stripped).
//
// Usage:
//   jalpari run moon-browser.fg <url>
//
// The URL check below mirrors JalOS's httpget command: the URL must
// start with http:// or https://. Network failures (unresolvable
// host, refused connection, malformed response) are reported by the
// language runtime itself as "jalpari: runtime error: http_get: ..."
// with exit code 1 — Jal Pari has no try/catch, so the app cannot
// intercept them, but they are a clean error line, not a crash.
// An empty page body is reported by the app itself, below.
// LIMIT: the tag stripper is naive — a literal < or > in page text
// is treated as markup, and scripts/styles are stripped as tags
// (their text content is dropped only if it sits inside <...>).

fn main() -> int {
    let mut argv: [str] = args();
    if len(argv) < 1 {
        println("usage: moon-browser <url>");
        return 1;
    }
    let mut url: str = argv[0];
    if !starts_with(url, "http://") && !starts_with(url, "https://") {
        println("moon-browser: URL must start with http:// or https://");
        return 1;
    }
    let mut body: str = http_get(url);
    if len(body) == 0 {
        println("moon-browser: fetched page is empty");
        return 1;
    }
    let mut text: str = "";
    let mut in_tag: bool = false;
    let mut i: int = 0;
    while i < len(body) {
        let mut ch: str = body[i];
        if ch == "<" {
            in_tag = true;
        } else {
            if ch == ">" {
                in_tag = false;
            } else {
                if !in_tag {
                    text = text + ch;
                }
            }
        }
        i = i + 1;
    }
    println(text);
    return 0;
}
