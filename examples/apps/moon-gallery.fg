// Moon Gallery — build a simple HTML gallery page from image paths.
//
// Usage:
//   jalpari run moon-gallery.fg <image1> [image2 ...]
//
// Writes gallery.html in the current directory, with one
// <img src="..."> per path given, and prints a line like:
//   gallery: 2 images -> gallery.html
//
// LIMIT (honest): Jal Pari has no directory-scanning builtin (no
// readdir, no mkdir), so this app CANNOT scan a folder for images.
// Pass the image paths explicitly as program arguments.

fn main() -> int {
    let mut paths: [str] = args();
    if len(paths) == 0 {
        println("usage: moon-gallery <image1> [image2 ...]");
        println("gallery: no images given, nothing written");
        return 1;
    }
    let mut html: str = "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>Moon Gallery</title>\n</head>\n<body>\n<h1>Moon Gallery</h1>\n";
    let mut i: int = 0;
    while i < len(paths) {
        html = html + "<img src=\"" + paths[i] + "\">\n";
        i = i + 1;
    }
    html = html + "</body>\n</html>\n";
    let mut ok: bool = write_file("gallery.html", html);
    if !ok {
        println("gallery: failed to write gallery.html");
        return 1;
    }
    println("gallery:", len(paths), "images -> gallery.html");
    return 0;
}
