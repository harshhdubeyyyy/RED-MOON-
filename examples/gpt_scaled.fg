// Scaled GPT (0.3.0): 2 blocks, 2 heads, d=16, hidden=32,
// seq=16, vocab from the story text below (lowercase letters,
// space, period, comma — 29 characters), 5200 params.
// Training: Adam lr 0.03, clip 1.0, 20 windows x 6 epochs.
// Evaluation: held-out windows the model never trained on,
// reported as loss AND perplexity (exp(loss)), before and
// after training — so improvement is not just training loss.
// Checkpoint: params are saved to /tmp (not the repo) and
// loaded back, and the load-back difference is printed.
// Generation: greedy + sampled from a 16-char prompt.
import "gpt2.fg";
import "nn.fg";
import "tokenizer.fg";

fn build_tape(params: [float]) -> Ag {
    let mut s: Ag = ag_input(tape_new(), params[0]);
    let mut i: int = 1;
    while i < len(params) {
        s = ag_input(s.tape, params[i]);
        i = i + 1;
    }
    return s;
}

fn window_loss(params: [float], ids: [int], start: int) -> float {
    let mut x: [int] = [];
    let mut y: [int] = [];
    let mut i: int = 0;
    while i < 16 {
        push(x, ids[start + i]);
        push(y, ids[start + i + 1]);
        i = i + 1;
    }
    let tape: Ag = build_tape(params);
    let logits: NodeVec = g2_logits(tape, x, 16, 16, 2, 32, 29, 2);
    let loss: Ag = g2_loss(logits.ag, logits.ids, y, 16, 29);
    return loss.tape.vals[loss.last];
}

fn eval_loss(params: [float], ids: [int], first: int, count: int) -> float {
    let mut total: float = 0.0;
    let mut w: int = 0;
    while w < count {
        total = total + window_loss(params, ids, first + w);
        w = w + 1;
    }
    return total / count as float;
}

fn gen_text(params: [float], ctx0: [int], vocab: str, steps: int, sampled: bool) -> str {
    let mut ctx: [int] = ctx0;
    let mut gen: str = char_decode(ctx0, vocab);
    let mut seed: int = 123;
    let mut step: int = 0;
    while step < steps {
        let tape: Ag = build_tape(params);
        let logits: NodeVec = g2_logits(tape, ctx, 16, 16, 2, 32, 29, 2);
        let base: int = 15 * 29;
        let mut best: int = 0;
        if sampled {
            let mut last_logits: [float] = [];
            let mut v: int = 0;
            while v < 29 {
                push(last_logits, logits.ag.tape.vals[base + v]);
                v = v + 1;
            }
            seed = rand_next(seed);
            best = sample_temperature(last_logits, 0.8, rand_float(seed));
        } else {
            let mut v: int = 1;
            while v < 29 {
                if logits.ag.tape.vals[base + v] > logits.ag.tape.vals[base + best] {
                    best = v;
                }
                v = v + 1;
            }
        }
        gen = gen + substr(vocab, best, 1);
        let mut next: [int] = [];
        let mut i: int = 1;
        while i < 16 {
            push(next, ctx[i]);
            i = i + 1;
        }
        push(next, best);
        ctx = next;
        step = step + 1;
    }
    return gen;
}

fn main() -> int {
    let vocab: str = "abcdefghijklmnopqrstuvwxyz .,";
    let text: str = "the sun is warm today. a small cat sits on the mat. the dog runs in the park. a bird sings in the tree. the boy reads a book. the girl plays with a ball. the fish swims in the pond. a horse runs on the hill. the cow eats green grass. the moon shines at night. the stars are bright and clear. a train runs on the track. the boat sails on the sea. the wind blows through the trees. rain falls on the roof all day.";
    let ids: [int] = char_encode(text, vocab);
    println("text len =", len(ids), "vocab =", len(vocab));
    println("params =", g2_param_count(29, 16, 16, 32, 2));
    let init: [float] = g2_init_params(29, 16, 16, 32, 2, 42);
    let test_before: float = eval_loss(init, ids, 320, 8);
    println("test loss before =", test_before, "ppl =", exp(test_before));
    let mut st: OptimState = optim_new(init);
    let mut epoch: int = 0;
    while epoch < 3 {
        let mut total: float = 0.0;
        let mut w: int = 0;
        while w < 200 {
            let mut x: [int] = [];
            let mut y: [int] = [];
            let mut i: int = 0;
            while i < 16 {
                push(x, ids[w + i]);
                push(y, ids[w + i + 1]);
                i = i + 1;
            }
            let tape: Ag = build_tape(st.params);
            let logits: NodeVec = g2_logits(tape, x, 16, 16, 2, 32, 29, 2);
            let loss: Ag = g2_loss(logits.ag, logits.ids, y, 16, 29);
            let back: Ag = ag_backward(loss, loss.last);
            total = total + back.tape.vals[loss.last];
            let mut grads: [float] = [];
            i = 0;
            while i < len(st.params) {
                push(grads, back.tape.grads[i]);
                i = i + 1;
            }
            let clipped: [float] = grad_clip(grads, 1.0);
            st = adam_step(st, clipped, 0.02, 0.9, 0.999, 0.00000001);
            w = w + 1;
        }
        println("epoch", epoch, "avg loss =", total / 200.0);
        epoch = epoch + 1;
    }
    let test_after: float = eval_loss(st.params, ids, 320, 8);
    println("test loss after =", test_after, "ppl =", exp(test_after));
    let ok: bool = checkpoint_save("/tmp/gpt_scaled_ckpt.txt", st.params);
    println("ckpt saved =", ok);
    let back_params: [float] = checkpoint_load("/tmp/gpt_scaled_ckpt.txt");
    let mut diff: float = st.params[0] - back_params[0];
    if diff < 0.0 {
        diff = -diff;
    }
    println("ckpt diff =", diff, "ckpt len =", len(back_params));
    let ctx: [int] = char_encode("the sun is warm ", vocab);
    println("greedy =", gen_text(st.params, ctx, vocab, 20, false));
    println("sampled =", gen_text(st.params, ctx, vocab, 20, true));
    return 0;
}
