import "xml.fg";

fn main() -> int {
    let doc: str = "<book title=\"Jal Pari\" year=\"2026\"><author>Jayant</author></book>";
    println("tag =", xml_tag(doc));
    println("title =", xml_attr(doc, "title"));
    println("year =", xml_attr(doc, "year"));
    println("author =", xml_child_text(doc, "author"));
    println("inner =", xml_inner(doc));
    println("missing =", xml_attr_or(doc, "isbn", "none"));
    return 0;
}
