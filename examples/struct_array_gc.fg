struct Point {
    x: int;
    y: int;
    name: str;
}

fn use_pts() -> int {
    let pts: [Point] = [Point { x: 1, y: 2, name: "a" }, Point { x: 3, y: 4, name: "b" }];
    println("inside =", len(pts), pts[0].name, pts[1].name);
    return 0;
}

fn main() -> int {
    use_pts();
    println("arr allocs =", arr_alloc_count(), "arr frees =", arr_free_count());
    println("str allocs =", alloc_count(), "str frees =", free_count());
    return 0;
}
