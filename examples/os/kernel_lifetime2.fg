// Lifetime-ordered allocator kernel, second QAIRT borrow (Phase F follow-on).
//
// The 29 Oct batch kernel proved the epoch idea (a short pool freed by
// bulk reset, a long pool that survives). This kernel applies the QAIRT
// placement insight to the real free-list allocator: free lists are
// SEGREGATED by lifetime class instead of one shared list, so short
// churn can never fragment long-lived space.
//
//   short region [0xA000, 0xB000): bump word 32832, free-list head 32836.
//   long  region [0xB000, 0xC000): bump word 32840, free-list head 32844.
//   Block header is 8 bytes [next, total_size] before the payload,
//   same as the C2 freelist kernel. alloc_life(size, life) first-fits
//   the region's own list, splits when the remainder is at least 16,
//   else takes the block whole, and falls back to that region's bump
//   pointer; it fails with 0 - 1 past the region end, never into the
//   other region. free_life(ptr) picks the list from the address
//   (ptr < 0xB000 is short, else long), inserts address-ordered,
//   and coalesces with physical neighbours — and because each list
//   holds only its own region's blocks, a merge can never cross the
//   region boundary: the split is safe by construction, not by a
//   runtime guard.
//
// Demo: short s1, long lg, short s2, short s3; free s1, realloc
// short (must reuse s1's exact block); verify the long pattern
// survived the short churn; free s2, s3, s4 (adjacent short blocks
// — must coalesce into one block); alloc 48 short (must succeed
// from the coalesced space); verify its pattern. Failures print E
// instead of K, so the transcript stays honest.
//
// Expected model UART transcript: LIFEKKKKKDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn alloc_life(size: int, life: int) -> int {
  let mut bump_a: int = 32832;
  let mut head_a: int = 32836;
  let mut reg_end: int = 45056;
  if life == 1 {
    bump_a = 32840;
    head_a = 32844;
    reg_end = 49152;
  }
  let mut need: int = (size + 3) & ~3;
  need = need + 8;
  let mut prev: int = 0;
  let mut cur: int = peek32(head_a);
  while cur != 0 {
    let bsize: int = peek32(cur + 4);
    if bsize >= need {
      let rem: int = bsize - need;
      if rem >= 16 {
        let nb: int = cur + need;
        poke32(nb, peek32(cur));
        poke32(nb + 4, rem);
        if prev == 0 {
          poke32(head_a, nb);
        } else {
          poke32(prev, nb);
        }
      } else {
        if prev == 0 {
          poke32(head_a, peek32(cur));
        } else {
          poke32(prev, peek32(cur));
        }
      }
      return cur + 8;
    }
    prev = cur;
    cur = peek32(cur);
  }
  let p: int = peek32(bump_a);
  let a: int = (p + 3) & ~3;
  if a + need > reg_end {
    return 0 - 1;
  }
  poke32(a, 0);
  poke32(a + 4, need);
  poke32(bump_a, a + need);
  return a + 8;
}

fn free_life(ptr: int) {
  let hdr: int = ptr - 8;
  let mut head_a: int = 32836;
  if ptr >= 45056 {
    head_a = 32844;
  }
  let mut hsize: int = peek32(hdr + 4);
  let mut prev: int = 0;
  let mut cur: int = peek32(head_a);
  while cur != 0 {
    if cur > hdr {
      break;
    }
    prev = cur;
    cur = peek32(cur);
  }
  poke32(hdr, cur);
  if prev == 0 {
    poke32(head_a, hdr);
  } else {
    poke32(prev, hdr);
  }
  if cur != 0 {
    if hdr + hsize == cur {
      poke32(hdr + 4, hsize + peek32(cur + 4));
      poke32(hdr, peek32(cur));
      hsize = peek32(hdr + 4);
    }
  }
  if prev != 0 {
    if prev + peek32(prev + 4) == hdr {
      poke32(prev + 4, peek32(prev + 4) + hsize);
      poke32(prev, peek32(hdr));
    }
  }
}

fn main() {
  poke32(32832, 40960);
  poke32(32836, 0);
  poke32(32840, 45056);
  poke32(32844, 0);
  put(76);
  put(73);
  put(70);
  put(69);
  let s1 = alloc_life(16, 0);
  let lg = alloc_life(16, 1);
  let s2 = alloc_life(16, 0);
  let s3 = alloc_life(16, 0);
  poke32(s1, 11);
  poke32(lg, 22);
  poke32(s2, 33);
  poke32(s3, 44);
  free_life(s1);
  let s4 = alloc_life(16, 0);
  if s4 == s1 {
    put(75);
  } else {
    put(69);
  }
  poke32(s4, 55);
  if peek32(s4) == 55 {
    put(75);
  } else {
    put(69);
  }
  if peek32(lg) == 22 {
    put(75);
  } else {
    put(69);
  }
  free_life(s2);
  free_life(s3);
  free_life(s4);
  let big = alloc_life(48, 0);
  if big != 0 - 1 {
    put(75);
  } else {
    put(69);
  }
  poke32(big, 99);
  if peek32(big) == 99 {
    put(75);
  } else {
    put(69);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
