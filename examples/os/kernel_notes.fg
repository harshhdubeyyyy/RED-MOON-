// Notes app kernel (Phase F, two stored notes).
//
// Two notes stored as zero-terminated word-per-character
// strings at 0x9000 ("call mom") and 0x9030 ("buy milk").
// The note count (2) lives in RAM scratch 0x8000. The demo
// prints the count, then both notes.
//
// Expected model UART transcript:
//   KERN\n2\ncall mom\nbuy milk\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_name(base: int) {
  let mut j = 0;
  while peek32(base + j * 4) != 0 {
    put(peek32(base + j * 4));
    j = j + 1;
  }
}

fn main() {
  poke32(36864, 99);
  poke32(36868, 97);
  poke32(36872, 108);
  poke32(36876, 108);
  poke32(36880, 32);
  poke32(36884, 109);
  poke32(36888, 111);
  poke32(36892, 109);
  poke32(36896, 0);
  poke32(36912, 98);
  poke32(36916, 117);
  poke32(36920, 121);
  poke32(36924, 32);
  poke32(36928, 109);
  poke32(36932, 105);
  poke32(36936, 108);
  poke32(36940, 107);
  poke32(36944, 0);
  poke32(32768, 2);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  put(48 + peek32(32768));
  put(10);
  put_name(36864);
  put(10);
  put_name(36912);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
