// Phase F checkpoint 9: networking — loopback stack.
//
// There is no NIC in the model or the Verilog, so the wire
// is loopback: packets sent to self are delivered to self.
// Everything else is a real stack, in the shape of a real
// one:
//   SLIP framing (RFC 1055): END 192, ESC 219, ESC_END 220,
//     ESC_ESC 221. Encoded bytes travel through the loopback
//     buffer, never the UART — the UART shows only human
//     output, so the transcript stays readable text.
//   Packet format (UDP-inspired, fixed header): [dst_port,
//     src_port, len, payload..., checksum], checksum = sum
//     of all preceding bytes mod 256. Bad checksums drop.
//   Loopback buffer at 0x9000: bytes stored as words (no
//     byte-store builtin exists in freestanding v1), linear
//     positions, no wraparound (the demo moves 29 bytes).
//   Echo service on port 7 (the real UDP echo port): a
//     packet to port 7 with payload 1 (ping) earns a reply
//     with payload 2 (pong) back to the sender.
//
// Scratch: write_pos 0x8050, read_pos 0x8054, sent 0x8060,
//   recv 0x8064, dropped 0x8068, r_dst 0x8070, r_src 0x8074,
//   r_payload 0x8078. Packet build/collect area 0x9100.
//
// Demo: (1) send a packet, flip its payload byte in transit,
//   receive -> checksum fails -> dropped (D1). (2) send a
//   packet with payload 192, exercising the ESC encode and
//   decode path end to end. (3) ping flow: send ping, receive
//   it, reply pong, receive pong, print PONG. Then stats and
//   DONE and halt. Expected model UART transcript:
//     KERN
//     PONG
//     S4R3D1
//     DONE
// halted. Stats: 4 sent (corrupt, ESC, ping, pong), 3
// received (ESC, ping, pong), 1 dropped (corrupt).

fn put(c: int) {
  poke32(268435456, c);
}

fn print_num(n: int) {
  let mut div = 1;
  while div * 10 <= n {
    div = div * 10;
  }
  while div >= 1 {
    put(48 + (n / div) % 10);
    div = div / 10;
  }
}

fn lb_put(c: int) {
  let pos = peek32(32848);
  poke32(36864 + pos * 4, c);
  poke32(32848, pos + 1);
}

fn slip_byte(c: int) {
  if c == 192 {
    lb_put(219);
    lb_put(220);
    return;
  }
  if c == 219 {
    lb_put(219);
    lb_put(221);
    return;
  }
  lb_put(c);
}

fn net_send(dst: int, src: int, payload: int) {
  lb_put(192);
  slip_byte(dst);
  slip_byte(src);
  slip_byte(1);
  slip_byte(payload);
  slip_byte((dst + src + 1 + payload) % 256);
  lb_put(192);
  poke32(32864, peek32(32864) + 1);
}

fn net_recv() -> int {
  let mut cursor = peek32(32852);
  let end = peek32(32848);
  let mut n = 0;
  let mut ok = 1;
  while cursor < end {
    let c = peek32(36864 + cursor * 4);
    cursor = cursor + 1;
    if c == 192 {
      if n > 0 {
        poke32(32852, cursor);
        if ok == 0 {
          poke32(32872, peek32(32872) + 1);
          return 0;
        }
        if n != 5 {
          poke32(32872, peek32(32872) + 1);
          return 0;
        }
        let dst = peek32(37120);
        let src = peek32(37124);
        let ln = peek32(37128);
        let pay = peek32(37132);
        let csum = peek32(37136);
        if ln != 1 {
          poke32(32872, peek32(32872) + 1);
          return 0;
        }
        if (dst + src + ln + pay) % 256 != csum {
          poke32(32872, peek32(32872) + 1);
          return 0;
        }
        poke32(32880, dst);
        poke32(32884, src);
        poke32(32888, pay);
        poke32(32868, peek32(32868) + 1);
        return 1;
      }
    } else if c == 219 {
      if cursor >= end {
        return 0;
      }
      let e = peek32(36864 + cursor * 4);
      cursor = cursor + 1;
      if e == 220 {
        poke32(37120 + n * 4, 192);
        n = n + 1;
      } else if e == 221 {
        poke32(37120 + n * 4, 219);
        n = n + 1;
      } else {
        ok = 0;
      }
    } else {
      poke32(37120 + n * 4, c);
      n = n + 1;
      if n > 16 {
        ok = 0;
      }
    }
  }
  return 0;
}

fn main() {
  poke32(32848, 0);
  poke32(32852, 0);
  poke32(32864, 0);
  poke32(32868, 0);
  poke32(32872, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  net_send(7, 9, 5);
  poke32(36864 + 4 * 4, 6);
  let r1 = net_recv();
  if r1 != 0 {
    put(69);
  }
  net_send(7, 9, 192);
  let r2 = net_recv();
  if r2 != 1 {
    put(69);
  }
  if peek32(32888) != 192 {
    put(69);
  }
  net_send(7, 9, 1);
  let r3 = net_recv();
  if r3 == 1 {
    if peek32(32880) == 7 {
      if peek32(32888) == 1 {
        net_send(peek32(32884), 7, 2);
      }
    }
  } else {
    put(69);
  }
  let r4 = net_recv();
  if r4 == 1 {
    if peek32(32888) == 2 {
      put(80);
      put(79);
      put(78);
      put(71);
      put(10);
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  put(83);
  print_num(peek32(32864));
  put(82);
  print_num(peek32(32868));
  put(68);
  print_num(peek32(32872));
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
}
