// Shell v2: commands with digit arguments (Phase F).
//
// Shell v1 dispatched on one character only. This kernel parses
// a line's first character as the command and the next two
// characters as single-digit arguments: a = add, m = multiply,
// q = quit, anything else = ?. Echo matches the terminal core:
// every input character is echoed as read.
//
// Demo input (fed by the test): a23, m34, x, q. Expected model
// UART transcript:
//   KERN\n> a23\n5\n> m34\n12\n> x\n?\n> q\nBYE\n, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 10 {
    put(48 + v / 10);
  }
  put(48 + v % 10);
}

fn main() {
  poke32(32832, 0 - 1);
  poke32(32836, 0);
  poke32(32840, 0);
  poke32(32844, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut running = 1;
  while running == 1 {
    put(62);
    put(32);
    poke32(32844, 0);
    let mut done_line = 0;
    while done_line == 0 {
      let c = peek32(268435460);
      if c != 0 - 1 {
        if c == 10 {
          put(10);
          let cmd = peek32(32832);
          let d1 = peek32(32836);
          let d2 = peek32(32840);
          poke32(32832, 0 - 1);
          if cmd == 97 {
            put_num(d1 + d2);
            put(10);
          } else if cmd == 109 {
            put_num(d1 * d2);
            put(10);
          } else if cmd == 113 {
            put(66);
            put(89);
            put(69);
            put(10);
            running = 0;
          } else {
            put(63);
            put(10);
          }
          done_line = 1;
        } else {
          put(c);
          let pos = peek32(32844);
          if pos == 0 {
            poke32(32832, c);
          } else if pos == 1 {
            poke32(32836, c - 48);
          } else if pos == 2 {
            poke32(32840, c - 48);
          }
          poke32(32844, pos + 1);
        }
      }
    }
  }
}
