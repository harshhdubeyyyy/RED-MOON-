// SBI-style dispatch demo kernel — the agent+REA loop, implemented fresh in Jal Pari.
//
// Investigation: Ghidra RISC-V analysis of the big32 SBI firmware (see
// ~/workspace/rx-proof/sbi_fw-ghidra-findings.md) decoded its trap handler:
// mscratch stack swap, mcause dispatch, and an EID compare-and-branch table
// (Base + TIME + sPI + RFENCE + SRST). This kernel reimplements that DISPATCH
// PATTERN fresh in Jal Pari — it is not a copy of the firmware, and it does
// not claim the firmware's identity (impl id here is a demo value, 7).
//
// Demo convention (documented difference from SBI): Jal Pari's ecall builtin
// carries (EID in a7, one argument in a0) — see codegen_rv.py. Real SBI puts
// the function id in a6, which needs a 3-argument ecall builtin: that is a
// named future language slice, not done here. So this demo dispatches Base
// FIDs from a0: 0 = spec version (2, 0), 1 = impl id (7, 0). TIME (EID
// 0x54494D45 = 1414022981) returns the mtime low word. Unknown EIDs return
// a0 = -2, a1 = 0, the SBI error convention.
//
// Expected model UART transcript: "2\n7\n<mtime-digits>\n-2\nDONE\n", halted.
// The mtime line is timing-dependent, so the test checks its shape, not its
// exact value. Halt uses the unified kernel's idiom: clear mtvec, then ecall.

fn put(c: int) {
  poke32(268435456, c);
}

fn print_int(v: int) {
  if v < 0 {
    put(45);
    print_int(0 - v);
    return;
  }
  if v >= 10 {
    print_int(v / 10);
  }
  put(48 + v % 10);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    // Timer interrupt: silence it by pushing mtimecmp to the far future,
    // then return to the interrupted instruction.
    poke32(268435480, 0 - 1);
    poke32(268435484, 0 - 1);
    return;
  }
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  let fid = peek32(frame + 32);
  if eid == 16 {
    if fid == 0 {
      poke32(frame + 32, 2);
      poke32(frame + 36, 0);
    } else {
      if fid == 1 {
        poke32(frame + 32, 7);
        poke32(frame + 36, 0);
      } else {
        poke32(frame + 32, 0 - 2);
        poke32(frame + 36, 0);
      }
    }
    csr_write(833, ret);
    return;
  }
  if eid == 1414022981 {
    poke32(frame + 32, peek32(268435472));
    poke32(frame + 36, 0);
    csr_write(833, ret);
    return;
  }
  poke32(frame + 32, 0 - 2);
  poke32(frame + 36, 0);
  csr_write(833, ret);
}

fn main() {
  let v = ecall(16, 0);
  print_int(v);
  put(10);
  let id = ecall(16, 1);
  print_int(id);
  put(10);
  let t = ecall(1414022981, 0);
  print_int(t);
  put(10);
  let e = ecall(99, 0);
  print_int(e);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
  csr_write(773, 0);
  let h = ecall(0, 0);
}
