// 16550 UART driver kernel — drivers item, from the stty reference analysis.
//
// Reference: REA/Ghidra analysis of /usr/bin/stty (x86-64). Its set_speed
// function (src/stty.c, found via xrefs on cfsetospeed) walks a name table,
// strcmp's the requested baud name, takes the speed_t, and calls
// cfsetispeed/cfsetospeed — stty itself holds no baud hardware logic; the
// speed lands in termios, and the hardware side is divisor programming,
// which is what this kernel implements. Plus the SOC2 facts: 16550 at
// 0x10010000, clock 1,843,200 Hz (from big32.dts). Standard 16550 programming, the part stty's termios
// layer ultimately drives: divisor = clock / (16 * baud); LCR bit 7 (DLAB)
// opens the divisor latch; LCR 0x03 = 8 data bits, no parity, 1 stop bit.
//
//   baud     divisor
//   9600     12
//   19200    6
//   38400    3
//   115200   1
//
// This kernel programs the 16550 for each baud and reports baud=divisor
// over the legacy UART (the transcript channel). NOTE on verification:
// the small big32 model has no 16550 — its stores to 0x10010000 wrap into
// low dmem harmlessly — so the model test verifies the divisor COMPUTATION
// and transcript exactly, while the actual 16550 register programming is
// verified later on the SOC2 Verilog sim (which does have the 16550),
// once no other sim is running. The two halves are kept separate on
// purpose; nothing here claims hardware verification the model cannot give.
//
// Expected model UART transcript: "9600=12\n19200=6\n38400=3\n115200=1\nDONE\n",
// halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn print_int(v: int) {
  if v < 0 {
    put(45);
    print_int(0 - v);
    return;
  }
  if v >= 10 {
    print_int(v / 10);
  }
  put(48 + v % 10);
}

fn uart16550_init(baud: int) -> int {
  let divisor = 1843200 / (16 * baud);
  let base = 268500992;
  poke32(base + 3, 128);
  poke32(base + 0, divisor % 256);
  poke32(base + 1, divisor / 256);
  poke32(base + 3, 3);
  poke32(base + 2, 1);
  return divisor;
}

fn report(baud: int) {
  let d = uart16550_init(baud);
  print_int(baud);
  put(61);
  print_int(d);
  put(10);
}

fn main() {
  report(9600);
  report(19200);
  report(38400);
  report(115200);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
}
