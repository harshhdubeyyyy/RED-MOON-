// Text-mode framebuffer kernel (SOC2-only): draws the GUI
// checkpoint's windows into VRAM instead of UART escapes.
// VRAM: 80x25 cells at 0x10004000 (= 268451840, verified
// by round-trip), 2 bytes per cell (char + attribute),
// 2 cells per word (low half = even cell, high half = odd
// cell). The kernel uses no RAM scratch, so no rebase is
// needed; build with --stack-top 0x800F0000 for SOC2.
// The UART transcript is just KERN / DONE — the real
// output is the screen, checked by the testbench.

fn put(c: int) {
  poke32(268435456, c);
}

fn fb_set_cell(x: int, y: int, ch: int, attr: int) {
  let idx = y * 80 + x;
  let widx = idx / 2;
  let addr = 268451840 + widx * 4;
  let mut word = peek32(addr);
  let cell = ch + attr * 256;
  if idx % 2 == 0 {
    word = (word & (0 - 65536)) | cell;
  } else {
    word = (word & 65535) | (cell * 65536);
  }
  poke32(addr, word);
}

fn fb_clear() {
  // One word = two cells: char 0x20 (space), attr 0x00,
  // so the clear word is 0x00200020 = 2097184.
  let mut i = 0;
  while i < 1000 {
    poke32(268451840 + i * 4, 2097184);
    i = i + 1;
  }
}

fn draw_window(x: int, y: int, w: int, h: int, title: int) {
  fb_set_cell(x, y, 43, 0);
  fb_set_cell(x + 1, y, title, 1);
  let mut i = 0;
  while i < w - 3 {
    fb_set_cell(x + 2 + i, y, 45, 0);
    i = i + 1;
  }
  fb_set_cell(x + w - 1, y, 43, 0);
  let mut r = y + 1;
  while r < y + h - 1 {
    fb_set_cell(x, r, 124, 0);
    let mut j = 0;
    while j < w - 2 {
      fb_set_cell(x + 1 + j, r, 32, 0);
      j = j + 1;
    }
    fb_set_cell(x + w - 1, r, 124, 0);
    r = r + 1;
  }
  fb_set_cell(x, y + h - 1, 43, 0);
  let mut k = 0;
  while k < w - 2 {
    fb_set_cell(x + 1 + k, y + h - 1, 45, 0);
    k = k + 1;
  }
  fb_set_cell(x + w - 1, y + h - 1, 43, 0);
}

fn main() {
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  fb_clear();
  draw_window(2, 2, 10, 4, 65);
  draw_window(5, 4, 10, 4, 66);
  draw_window(2, 2, 10, 4, 65);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
}
