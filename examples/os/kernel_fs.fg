// Phase F checkpoint 3: tiny filesystem kernel on big32.
//
// A filesystem without strings: files are identified by numeric
// id, not names (freestanding rejects string values, so names
// wait for a later checkpoint). Files are fixed-size at create
// time and stored as contiguous 256-byte blocks — the simple,
// real design early systems used.
//
// Layout: file table in scratch at 0x8060, 8 slots x 16 bytes
// [id, used, size_words, start_block]; next-free-block index in
// scratch 0x8050; data blocks at 0xD000, 16 blocks x 256 bytes
// (64 words each). This kernel is standalone (no scheduler), so
// the data region does not collide with any task stack here; a
// unified memory map is future integration work, not today's.
//
// API (status 0 ok, 0 - 1 fail):
//   fs_format() — zero the table, reset the block pointer.
//   fs_create(id, nwords) — fail on duplicate id, no free slot,
//     or not enough contiguous blocks.
//   fs_write(id, index, value) — fail when the file is missing
//     or index is out of bounds.
//   fs_read(id, index) — the word, or 0 - 1 when missing/out
//     of bounds (a sentinel: real data may also be -1, which
//     v1 accepts as ambiguous).
// Delete is NOT in v1: freed blocks are reclaimed only by
// reformat, like the bump allocator before the free-list.
//
// Demo: create file 1 (4 words), write/read back; create file 2
// (70 words, spans 2 blocks), verify words 63, 64, 69 across the
// boundary; fill the disk with file 3 (832 words = 13 blocks);
// creating file 4 must fail; an out-of-bounds write must fail;
// DONE and halt. Failures print E instead of K.
//
// Expected model UART transcript: KERNKKKKKDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn find(id: int) -> int {
  let mut s = 0;
  while s < 8 {
    let base = 32864 + s * 16;
    if peek32(base + 4) == 1 {
      if peek32(base) == id {
        return base;
      }
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_format() {
  let mut s = 0;
  while s < 8 {
    let base = 32864 + s * 16;
    poke32(base, 0);
    poke32(base + 4, 0);
    poke32(base + 8, 0);
    poke32(base + 12, 0);
    s = s + 1;
  }
  poke32(32848, 0);
}

fn fs_create(id: int, nwords: int) -> int {
  if find(id) != 0 - 1 {
    return 0 - 1;
  }
  let mut s = 0;
  while s < 8 {
    let base = 32864 + s * 16;
    if peek32(base + 4) == 0 {
      let need = (nwords + 63) / 64;
      let start = peek32(32848);
      if start + need > 16 {
        return 0 - 1;
      }
      poke32(base, id);
      poke32(base + 4, 1);
      poke32(base + 8, nwords);
      poke32(base + 12, start);
      poke32(32848, start + need);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_write(id: int, index: int, value: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let addr = 53248 + peek32(base + 12) * 256 + index * 4;
  poke32(addr, value);
  return 0;
}

fn fs_read(id: int, index: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let addr = 53248 + peek32(base + 12) * 256 + index * 4;
  return peek32(addr);
}

fn main() {
  fs_format();
  put(75);
  put(69);
  put(82);
  put(78);
  if fs_create(1, 4) == 0 {
    put(75);
  } else {
    put(69);
  }
  fs_write(1, 0, 11);
  fs_write(1, 1, 22);
  fs_write(1, 2, 33);
  fs_write(1, 3, 44);
  if fs_read(1, 0) == 11 {
    if fs_read(1, 1) == 22 {
      if fs_read(1, 2) == 33 {
        if fs_read(1, 3) == 44 {
          put(75);
        } else {
          put(69);
        }
      } else {
        put(69);
      }
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  if fs_create(2, 70) == 0 {
    fs_write(2, 63, 630);
    fs_write(2, 64, 640);
    fs_write(2, 69, 690);
    if fs_read(2, 63) == 630 {
      if fs_read(2, 64) == 640 {
        if fs_read(2, 69) == 690 {
          put(75);
        } else {
          put(69);
        }
      } else {
        put(69);
      }
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  fs_create(3, 832);
  if fs_create(4, 1) == 0 - 1 {
    put(75);
  } else {
    put(69);
  }
  if fs_write(1, 99, 1) == 0 - 1 {
    put(75);
  } else {
    put(69);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
