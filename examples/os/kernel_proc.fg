// Phase F checkpoint 5: processes — table, spawn, exit, wait.
//
// Builds on the Phase E scheduler's trap mechanism (stub saves a
// 120-byte frame, handler may hand a new frame to the stub through
// mscratch 832) but replaces timer preemption with cooperative
// switching: a task runs until it yields or exits, so the
// schedule is fully deterministic. Syscalls via ecall:
//   eid 2 = spawn: fork into a free slot (child stack tops
//     0xE000/0xC000/0xA000, 8192 apart — a task's frames must
//     stay within two nested calls, see below). Returns the
//     child pid to the parent, 0 to the child, -1 if no slot.
//   eid 3 = yield: switch to the next ready task, round-robin.
//   eid 4 = exit(code): mark the current task done, switch to
//     the next ready task; if none is ready, clear mtvec and
//     ecall, which halts (the model halts on ECALL with
//     mtvec == 0).
//
// Process table in scratch 0x8000, 4 slots x 16 bytes:
//   [state, frame, mepc, exit_code]
// states: 0 free, 1 ready, 2 running, 3 done.
// Scratch: 0x8040 current pid, 0x8044 pid of child A,
//   0x8048 pid of child B. Trap-frame slots (stub order):
//   a0 at +32, a7 at +60.
//
// THE rule this design forces (same as Phase E, sharper now
// that the parent waits on pids): fork copies only the trap
// frame, NOT main's function frame, so main's locals are shared
// with the child. The child must branch on the spawn result
// immediately — before any other statement — and never touch
// main's locals again. The parent records each pid into scratch
// right after the branch, before any yield, and waits on the
// scratch copies, never on the shared locals (the child would
// overwrite them with 0). Child bodies are helper functions:
// their frames live on the child's own stack.
//
// Demo: main spawns A and B, waits for both, prints DONE.
// Expected model UART transcript: KERNABABABDONE, halted —
// the ABABAB interleave is the proof that switching is real.

fn put(c: int) {
  poke32(268435456, c);
}

fn body_a() {
  put(65);
  let y1 = ecall(3, 0);
  put(65);
  let y2 = ecall(3, 0);
  put(65);
}

fn body_b() {
  put(66);
  let y1 = ecall(3, 0);
  put(66);
  let y2 = ecall(3, 0);
  put(66);
}

fn do_exit(code: int) {
  let x = ecall(4, code);
}

fn next_ready(cur: int) -> int {
  let mut s = cur + 1;
  while s < 4 {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  s = 0;
  while s < cur {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    return;
  }
  let cur = peek32(32832);
  let curbase = 32768 + cur * 16;
  poke32(curbase + 4, frame);
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  if eid == 2 {
    let mut s = 1;
    let mut slot = 0 - 1;
    while s < 4 {
      if peek32(32768 + s * 16) == 0 {
        slot = s;
        break;
      }
      s = s + 1;
    }
    if slot == 0 - 1 {
      poke32(frame + 32, 0 - 1);
      csr_write(833, ret);
      return;
    }
    let top = 57344 - (slot - 1) * 8192;
    let dst = top - 120;
    let mut i = 0;
    while i < 30 {
      poke32(dst + i * 4, peek32(frame + i * 4));
      i = i + 1;
    }
    poke32(frame + 32, slot);
    poke32(dst + 32, 0);
    let sbase = 32768 + slot * 16;
    poke32(sbase, 1);
    poke32(sbase + 4, dst);
    poke32(sbase + 8, ret);
    poke32(sbase + 12, 0);
    csr_write(833, ret);
    return;
  }
  if eid == 3 {
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    poke32(curbase, 1);
    let nbase = 32768 + nxt * 16;
    poke32(nbase, 2);
    csr_write(833, peek32(nbase + 8));
    csr_write(832, peek32(nbase + 4));
    poke32(32832, nxt);
    return;
  }
  if eid == 4 {
    poke32(curbase, 3);
    poke32(curbase + 12, peek32(frame + 32));
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(773, 0);
      let h = ecall(0, 0);
      return;
    }
    let nbase = 32768 + nxt * 16;
    poke32(nbase, 2);
    csr_write(833, peek32(nbase + 8));
    csr_write(832, peek32(nbase + 4));
    poke32(32832, nxt);
    return;
  }
  csr_write(833, ret);
}

fn main() {
  poke32(32768, 2);
  poke32(32772, 0);
  poke32(32776, 0);
  poke32(32780, 0);
  let mut s = 1;
  while s < 4 {
    poke32(32768 + s * 16, 0);
    s = s + 1;
  }
  poke32(32832, 0);
  poke32(32836, 0 - 1);
  poke32(32840, 0 - 1);
  put(75);
  put(69);
  put(82);
  put(78);
  let a = ecall(2, 0);
  if a == 0 {
    body_a();
    do_exit(0);
  }
  if a > 0 {
    poke32(32836, a);
  }
  let b = ecall(2, 0);
  if b == 0 {
    body_b();
    do_exit(0);
  }
  if b > 0 {
    poke32(32840, b);
  }
  let pa = peek32(32836);
  while peek32(32768 + pa * 16) != 3 {
    let y1 = ecall(3, 0);
  }
  let pb = peek32(32840);
  while peek32(32768 + pb * 16) != 3 {
    let y2 = ecall(3, 0);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
