// Phase F checkpoint 4: filesystem v2 — delete with block reclaim.
//
// v1 files were contiguous runs, so deleting one stranded its
// blocks: there was nowhere to record freed space except a bump
// pointer that only moves forward. v2 switches to indexed
// allocation (the Unix direct-blocks idea): each file owns a row
// of up to 16 block indices, and freed blocks go on a free-list
// whose links live in the freed blocks themselves (first word =
// next free block, -1 = end).
//
// Layout (standalone kernel, no scheduler):
//   scratch 0x8050: next bump block index (0..16)
//   scratch 0x8054: block free-list head (-1 = empty)
//   scratch 0x8060: file table, 8 slots x 16 bytes
//     [id, used, size_words, reserved]
//   scratch 0x8100: block map, 8 slots x 16 entries x 4 bytes
//     (entry = block index, or -1)
//   data blocks at 0xD000, 16 x 256 bytes (64 words each).
//
// API (0 ok, 0 - 1 fail):
//   fs_format, fs_create(id, nwords), fs_write, fs_read (as v1),
//   fs_delete(id) — pushes every mapped block onto the
//     free-list and marks the slot unused. Deleting a missing
//     file fails; it shares find() with the tested paths.
// create allocates blocks one by one (free-list first, then
// bump) and rolls back cleanly when a block allocation fails
// mid-create, so a failed create leaks nothing.
//
// Demo: create file 1 (70 words), verify the block boundary;
// delete it, create file 2 (70 words) — must reuse without
// moving the bump pointer; fill the disk with file 3 (896
// words); creating file 4 must fail; delete files 2 and 3,
// then create file 5 (1024 words = the whole disk) — must
// succeed, proving full reclaim; DONE and halt. Failures
// print E instead of K.
//
// Expected model UART transcript: KERNKKKKKDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn block_addr(b: int) -> int {
  return 53248 + b * 256;
}

fn find(id: int) -> int {
  let mut s = 0;
  while s < 8 {
    let base = 32864 + s * 16;
    if peek32(base + 4) == 1 {
      if peek32(base) == id {
        return base;
      }
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_format() {
  let mut s = 0;
  while s < 8 {
    let base = 32864 + s * 16;
    poke32(base, 0);
    poke32(base + 4, 0);
    poke32(base + 8, 0);
    poke32(base + 12, 0);
    s = s + 1;
  }
  let mut m = 0;
  while m < 128 {
    poke32(33024 + m * 4, 0 - 1);
    m = m + 1;
  }
  poke32(32848, 0);
  poke32(32852, 0 - 1);
}

fn alloc_block() -> int {
  let head = peek32(32852);
  if head != 0 - 1 {
    poke32(32852, peek32(block_addr(head)));
    return head;
  }
  let bump = peek32(32848);
  if bump >= 16 {
    return 0 - 1;
  }
  poke32(32848, bump + 1);
  return bump;
}

fn free_block(b: int) {
  poke32(block_addr(b), peek32(32852));
  poke32(32852, b);
}

fn fs_create(id: int, nwords: int) -> int {
  if find(id) != 0 - 1 {
    return 0 - 1;
  }
  let mut s = 0;
  while s < 8 {
    let base = 32864 + s * 16;
    if peek32(base + 4) == 0 {
      let need = (nwords + 63) / 64;
      let map = 33024 + s * 64;
      let mut k = 0;
      while k < need {
        let b = alloc_block();
        if b == 0 - 1 {
          let mut j = 0;
          while j < k {
            free_block(peek32(map + j * 4));
            j = j + 1;
          }
          return 0 - 1;
        }
        poke32(map + k * 4, b);
        k = k + 1;
      }
      while k < 16 {
        poke32(map + k * 4, 0 - 1);
        k = k + 1;
      }
      poke32(base, id);
      poke32(base + 4, 1);
      poke32(base + 8, nwords);
      poke32(base + 12, 0);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_delete(id: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  let slot = (base - 32864) / 16;
  let map = 33024 + slot * 64;
  let mut k = 0;
  while k < 16 {
    let b = peek32(map + k * 4);
    if b != 0 - 1 {
      free_block(b);
      poke32(map + k * 4, 0 - 1);
    }
    k = k + 1;
  }
  poke32(base + 4, 0);
  return 0;
}

fn fs_write(id: int, index: int, value: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 32864) / 16;
  let b = peek32(33024 + slot * 64 + (index / 64) * 4);
  let addr = 53248 + b * 256 + (index % 64) * 4;
  poke32(addr, value);
  return 0;
}

fn fs_read(id: int, index: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 32864) / 16;
  let b = peek32(33024 + slot * 64 + (index / 64) * 4);
  let addr = 53248 + b * 256 + (index % 64) * 4;
  return peek32(addr);
}

fn main() {
  fs_format();
  put(75);
  put(69);
  put(82);
  put(78);
  if fs_create(1, 70) == 0 {
    put(75);
  } else {
    put(69);
  }
  fs_write(1, 63, 630);
  fs_write(1, 64, 640);
  fs_write(1, 69, 690);
  if fs_read(1, 63) == 630 {
    if fs_read(1, 64) == 640 {
      if fs_read(1, 69) == 690 {
        put(75);
      } else {
        put(69);
      }
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  if fs_delete(1) == 0 {
    if fs_create(2, 70) == 0 {
      put(75);
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  if fs_create(3, 896) == 0 {
    if fs_create(4, 1) == 0 - 1 {
      put(75);
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  if fs_delete(2) == 0 {
    if fs_delete(3) == 0 {
      if fs_create(5, 1024) == 0 {
        put(75);
      } else {
        put(69);
      }
    } else {
      put(69);
    }
  } else {
    put(69);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
