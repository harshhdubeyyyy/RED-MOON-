// GENERATED by tools/rebase_soc2.py from examples/os/kernel_unified.fg — do not hand-edit; edit the source and regenerate.
// Integration: one unified kernel — every Phase F subsystem
// in a single program, on a single memory map.
//
// Subsystems: process table + spawn/yield/exit/sleep with
// preemptive timer ticks (checkpoints 5+8), bump allocator
// (checkpoint 1), filesystem v2 (checkpoint 4), shell REPL
// (checkpoint 6), ANSI GUI windows (checkpoint 7), loopback
// network stack (checkpoint 9).
//
// UNIFIED MEMORY MAP (the design work — every standalone
// kernel used these addresses differently, and the collisions
// are resolved here, not papered over):
//   0x8000 proc table, 4 slots x 16 bytes
//     [state, frame, mepc, exit_code-or-wake_tick]
//   0x8040 current pid, 0x8044 last spawned pid,
//     0x8048 tick count
//   0x8050 allocator bump pointer (heap below)
//   0x8060 FS next bump block, 0x8064 FS free-list head
//   0x8070 FS file table, 8 slots x 16 bytes
//   0x80F0 FS block map, 8 slots x 16 entries
//   0x82F0 net write_pos, 0x82F4 net read_pos,
//     0x82F8 net sent, 0x82FC net recv, 0x8300 net dropped,
//     0x8304 r_dst, 0x8308 r_src, 0x830C r_payload
//   0x8310 net packet area, 16 words
//   0x8400-0x8800 bump heap (1 KB)
//   0x8800-0x8C00 loopback buffer, 256 words
//   0x8C00-0x9C00 FS data blocks, 16 x 256 bytes
//   stacks: slot1 top 0xE000, slot2 top 0xC000, each 8192
//     apart; main stack top 0xFFFC.
//   All kernel data lives below 0xA000, clear of both child
//   stack regions (0xA000-0xC000 and 0xC000-0xE000).
// HONEST LIMIT, carried over: only 2 child slots fit. A
// third child stack (top 0xA000) would grow down through
// every kernel region, so spawn scans slots 1-2 only and
// returns -1 when both are busy. Slot 3 stays free forever.
// Also carried over: no idle task, so the shell never
// sleeps (a sleeping shell whose last child exits would
// halt the system); sleep stays available as a syscall.
//
// Shell commands (first character of each line):
//   h help, p procs, s spawn demo task, w wait last,
//   m bump-alloc 16 bytes and print the address,
//   f filesystem script (delete/create/write/readback),
//   g GUI demo windows, n network demo (ping flow),
//   q quit, anything else ?.
// The shell yields while waiting for input and once per
// iteration; timer ticks preempt on top of that, so tasks
// run between keystrokes and between ticks alike.

fn put(c: int) {
  poke32(268435456, c);
}

fn print_num(n: int) {
  let mut div = 1;
  while div <= n / 10 {
    div = div * 10;
  }
  while div >= 1 {
    put(48 + (n / div) % 10);
    div = div / 10;
  }
}

// Hex printing for addresses: print_num is decimal and
// assumes non-negative input, but SOC2 addresses are above
// 2^31, so they are negative in signed 32-bit arithmetic
// (0x80008400 prints as '*' through print_num, since
// -2147449856 % 10 is -6). Hex works on bit patterns via
// shifts and masks, so it is correct for any address.
fn print_hex(n: int) {
  let mut started = 0;
  let mut shift = 28;
  while shift >= 0 {
    let d = (n >> shift) & 15;
    if d != 0 {
      started = 1;
    }
    if started == 1 {
      if d < 10 {
        put(48 + d);
      } else {
        put(55 + d);
      }
    }
    shift = shift - 4;
  }
  if started == 0 {
    put(48);
  }
}

// ---- drivers: UART + timer ----

fn uart_putc(c: int) {
  poke32(268435456, c);
}

fn timer_now() -> int {
  return peek32(268435472);
}

fn timer_set_cmp(v: int) {
  poke32(268435480, v);
}

fn timer_enable() {
  csr_set(768, 8);
  csr_set(772, 128);
}

// ---- allocator: bump ----

fn bump_alloc(n: int) -> int {
  let bump = peek32(2147516496);
  if bump + n > 2147518464 {
    return 0 - 1;
  }
  poke32(2147516496, bump + n);
  return bump;
}

// ---- filesystem v2 (remapped addresses) ----

fn fs_find(id: int) -> int {
  let mut s = 0;
  while s < 8 {
    let base = 2147516528 + s * 16;
    if peek32(base + 4) == 1 {
      if peek32(base) == id {
        return base;
      }
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_format() {
  let mut s = 0;
  while s < 8 {
    let base = 2147516528 + s * 16;
    poke32(base, 0);
    poke32(base + 4, 0);
    poke32(base + 8, 0);
    poke32(base + 12, 0);
    s = s + 1;
  }
  let mut m = 0;
  while m < 128 {
    poke32(2147516656 + m * 4, 0 - 1);
    m = m + 1;
  }
  poke32(2147516504, 0);
  poke32(2147516508, 0 - 1);
}

fn fs_alloc_block() -> int {
  let head = peek32(2147516508);
  if head != 0 - 1 {
    poke32(2147516508, peek32(2147519488 + head * 256));
    return head;
  }
  let bump = peek32(2147516504);
  if bump >= 16 {
    return 0 - 1;
  }
  poke32(2147516504, bump + 1);
  return bump;
}

fn fs_free_block(b: int) {
  poke32(2147519488 + b * 256, peek32(2147516508));
  poke32(2147516508, b);
}

fn fs_create(id: int, nwords: int) -> int {
  if fs_find(id) != 0 - 1 {
    return 0 - 1;
  }
  let mut s = 0;
  while s < 8 {
    let base = 2147516528 + s * 16;
    if peek32(base + 4) == 0 {
      let need = (nwords + 63) / 64;
      let map = 2147516656 + s * 64;
      let mut k = 0;
      while k < need {
        let b = fs_alloc_block();
        if b == 0 - 1 {
          let mut j = 0;
          while j < k {
            fs_free_block(peek32(map + j * 4));
            j = j + 1;
          }
          return 0 - 1;
        }
        poke32(map + k * 4, b);
        k = k + 1;
      }
      while k < 16 {
        poke32(map + k * 4, 0 - 1);
        k = k + 1;
      }
      poke32(base, id);
      poke32(base + 4, 1);
      poke32(base + 8, nwords);
      poke32(base + 12, 0);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_delete(id: int) -> int {
  let base = fs_find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  let slot = (base - 2147516528) / 16;
  let map = 2147516656 + slot * 64;
  let mut k = 0;
  while k < 16 {
    let b = peek32(map + k * 4);
    if b != 0 - 1 {
      fs_free_block(b);
      poke32(map + k * 4, 0 - 1);
    }
    k = k + 1;
  }
  poke32(base + 4, 0);
  return 0;
}

fn fs_write(id: int, index: int, value: int) -> int {
  let base = fs_find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 2147516528) / 16;
  let b = peek32(2147516656 + slot * 64 + (index / 64) * 4);
  poke32(2147519488 + b * 256 + (index % 64) * 4, value);
  return 0;
}

fn fs_read(id: int, index: int) -> int {
  let base = fs_find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 2147516528) / 16;
  let b = peek32(2147516656 + slot * 64 + (index / 64) * 4);
  return peek32(2147519488 + b * 256 + (index % 64) * 4);
}

// ---- network stack (remapped addresses) ----

fn lb_put(c: int) {
  let pos = peek32(2147517168);
  poke32(2147518464 + pos * 4, c);
  poke32(2147517168, pos + 1);
}

fn slip_byte(c: int) {
  if c == 192 {
    lb_put(219);
    lb_put(220);
    return;
  }
  if c == 219 {
    lb_put(219);
    lb_put(221);
    return;
  }
  lb_put(c);
}

fn net_send(dst: int, src: int, payload: int) {
  lb_put(192);
  slip_byte(dst);
  slip_byte(src);
  slip_byte(1);
  slip_byte(payload);
  slip_byte((dst + src + 1 + payload) % 256);
  lb_put(192);
  poke32(2147517176, peek32(2147517176) + 1);
}

fn net_recv() -> int {
  let mut cursor = peek32(2147517172);
  let end = peek32(2147517168);
  let mut n = 0;
  let mut ok = 1;
  while cursor < end {
    let c = peek32(2147518464 + cursor * 4);
    cursor = cursor + 1;
    if c == 192 {
      if n > 0 {
        poke32(2147517172, cursor);
        if ok == 0 {
          poke32(2147517184, peek32(2147517184) + 1);
          return 0;
        }
        if n != 5 {
          poke32(2147517184, peek32(2147517184) + 1);
          return 0;
        }
        let dst = peek32(2147517200);
        let src = peek32(2147517204);
        let ln = peek32(2147517208);
        let pay = peek32(2147517212);
        let csum = peek32(2147517216);
        if ln != 1 {
          poke32(2147517184, peek32(2147517184) + 1);
          return 0;
        }
        if (dst + src + ln + pay) % 256 != csum {
          poke32(2147517184, peek32(2147517184) + 1);
          return 0;
        }
        poke32(2147517188, dst);
        poke32(2147517192, src);
        poke32(2147517196, pay);
        poke32(2147517180, peek32(2147517180) + 1);
        return 1;
      }
    } else if c == 219 {
      if cursor >= end {
        return 0;
      }
      let e = peek32(2147518464 + cursor * 4);
      cursor = cursor + 1;
      if e == 220 {
        poke32(2147517200 + n * 4, 192);
        n = n + 1;
      } else if e == 221 {
        poke32(2147517200 + n * 4, 219);
        n = n + 1;
      } else {
        ok = 0;
      }
    } else {
      poke32(2147517200 + n * 4, c);
      n = n + 1;
      if n > 16 {
        ok = 0;
      }
    }
  }
  return 0;
}

// ---- GUI windows ----

fn move_to(row: int, col: int) {
  put(27);
  put(91);
  print_num(row);
  put(59);
  print_num(col);
  put(72);
}

fn draw_window(x: int, y: int, w: int, h: int, title: int) {
  move_to(y, x);
  put(43);
  put(title);
  let mut i = 0;
  while i < w - 3 {
    put(45);
    i = i + 1;
  }
  put(43);
  let mut r = y + 1;
  while r < y + h - 1 {
    move_to(r, x);
    put(124);
    let mut j = 0;
    while j < w - 2 {
      put(32);
      j = j + 1;
    }
    put(124);
    r = r + 1;
  }
  move_to(y + h - 1, x);
  put(43);
  let mut k = 0;
  while k < w - 2 {
    put(45);
    k = k + 1;
  }
  put(43);
}

// ---- processes ----

fn demo_task() {
  put(72);
  let y1 = ecall(3, 0);
  put(73);
}

fn do_exit(code: int) {
  let x = ecall(4, code);
}

fn next_ready(cur: int) -> int {
  let mut s = cur + 1;
  while s < 4 {
    if peek32(2147516416 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  s = 0;
  while s < cur {
    if peek32(2147516416 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn switch_to(nxt: int) {
  let nbase = 2147516416 + nxt * 16;
  poke32(nbase, 2);
  csr_write(833, peek32(nbase + 8));
  csr_write(832, peek32(nbase + 4));
  poke32(2147516480, nxt);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    poke32(2147516488, peek32(2147516488) + 1);
    timer_set_cmp(timer_now() + 1000);
    let mut s = 0;
    while s < 4 {
      let base = 2147516416 + s * 16;
      if peek32(base) == 4 {
        if peek32(base + 12) <= timer_now() {
          poke32(base, 1);
        }
      }
      s = s + 1;
    }
    let cur = peek32(2147516480);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      return;
    }
    let curbase = 2147516416 + cur * 16;
    poke32(curbase + 4, frame);
    poke32(curbase + 8, csr_read(833));
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  let cur = peek32(2147516480);
  let curbase = 2147516416 + cur * 16;
  poke32(curbase + 4, frame);
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  if eid == 2 {
    let mut s = 1;
    let mut slot = 0 - 1;
    while s < 3 {
      if peek32(2147516416 + s * 16) == 0 {
        slot = s;
        break;
      }
      s = s + 1;
    }
    if slot == 0 - 1 {
      poke32(frame + 32, 0 - 1);
      csr_write(833, ret);
      return;
    }
    let top = 2147540992 - (slot - 1) * 8192;
    let dst = top - 120;
    let mut i = 0;
    while i < 30 {
      poke32(dst + i * 4, peek32(frame + i * 4));
      i = i + 1;
    }
    poke32(frame + 32, slot);
    poke32(dst + 32, 0);
    let sbase = 2147516416 + slot * 16;
    poke32(sbase, 1);
    poke32(sbase + 4, dst);
    poke32(sbase + 8, ret);
    poke32(sbase + 12, 0);
    csr_write(833, ret);
    return;
  }
  if eid == 3 {
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  if eid == 4 {
    poke32(curbase, 3);
    poke32(curbase + 12, peek32(frame + 32));
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(773, 0);
      let h = ecall(0, 0);
      return;
    }
    switch_to(nxt);
    return;
  }
  if eid == 5 {
    let ticks = peek32(frame + 32);
    poke32(curbase + 12, timer_now() + ticks * 1000);
    poke32(curbase, 4);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      poke32(curbase, 2);
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    switch_to(nxt);
    return;
  }
  csr_write(833, ret);
}

// ---- shell command bodies ----

fn cmd_fs() {
  let d = fs_delete(1);
  let c = fs_create(1, 70);
  fs_write(1, 63, 630);
  fs_write(1, 64, 640);
  fs_write(1, 69, 690);
  if c == 0 {
    if fs_read(1, 63) == 630 {
      if fs_read(1, 64) == 640 {
        if fs_read(1, 69) == 690 {
          put(70);
          put(10);
          return;
        }
      }
    }
  }
  put(69);
  put(10);
}

fn cmd_net() {
  poke32(2147517168, 0);
  poke32(2147517172, 0);
  poke32(2147517176, 0);
  poke32(2147517180, 0);
  poke32(2147517184, 0);
  net_send(7, 9, 5);
  poke32(2147518464 + 4 * 4, 6);
  let r1 = net_recv();
  if r1 != 0 {
    put(69);
    put(10);
    return;
  }
  net_send(7, 9, 192);
  let r2 = net_recv();
  if r2 != 1 {
    put(69);
    put(10);
    return;
  }
  if peek32(2147517196) != 192 {
    put(69);
    put(10);
    return;
  }
  net_send(7, 9, 1);
  let r3 = net_recv();
  if r3 == 1 {
    if peek32(2147517188) == 7 {
      if peek32(2147517196) == 1 {
        net_send(peek32(2147517192), 7, 2);
      }
    }
  } else {
    put(69);
    put(10);
    return;
  }
  let r4 = net_recv();
  if r4 == 1 {
    if peek32(2147517196) == 2 {
      put(80);
      put(79);
      put(78);
      put(71);
      put(10);
      put(83);
      print_num(peek32(2147517176));
      put(82);
      print_num(peek32(2147517180));
      put(68);
      print_num(peek32(2147517184));
      put(10);
      return;
    }
  }
  put(69);
  put(10);
}

fn cmd_gui() {
  put(27);
  put(91);
  put(50);
  put(74);
  put(27);
  put(91);
  put(72);
  draw_window(2, 2, 10, 4, 65);
  draw_window(5, 4, 10, 4, 66);
  draw_window(2, 2, 10, 4, 65);
  put(10);
}

fn main() {
  poke32(2147516416, 2);
  poke32(2147516420, 0);
  poke32(2147516424, 0);
  poke32(2147516428, 0);
  let mut s = 1;
  while s < 4 {
    poke32(2147516416 + s * 16, 0);
    s = s + 1;
  }
  poke32(2147516480, 0);
  poke32(2147516484, 0 - 1);
  poke32(2147516488, 0);
  poke32(2147516496, 2147517440);
  fs_format();
  poke32(2147517168, 0);
  poke32(2147517172, 0);
  poke32(2147517176, 0);
  poke32(2147517180, 0);
  poke32(2147517184, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  timer_set_cmp(1000);
  timer_enable();
  let mut y = 0;
  let mut running = 1;
  while running == 1 {
    put(62);
    put(32);
    let mut cmd = 0 - 1;
    while cmd == 0 - 1 {
      let c1 = peek32(268435460);
      if c1 != 0 - 1 {
        cmd = c1;
      } else {
        y = ecall(3, 0);
      }
    }
    put(cmd);
    let mut d = 0;
    while d != 10 {
      let c2 = peek32(268435460);
      if c2 != 0 - 1 {
        d = c2;
        put(c2);
      } else {
        y = ecall(3, 0);
      }
    }
    if cmd == 104 {
      put(104);
      put(32);
      put(112);
      put(32);
      put(115);
      put(32);
      put(119);
      put(32);
      put(109);
      put(32);
      put(102);
      put(32);
      put(103);
      put(32);
      put(110);
      put(32);
      put(113);
      put(10);
    } else if cmd == 112 {
      s = 0;
      while s < 4 {
        put(80);
        put(48 + s);
        put(58);
        put(48 + peek32(2147516416 + s * 16));
        put(32);
        s = s + 1;
      }
      put(10);
    } else if cmd == 115 {
      let pid = ecall(2, 0);
      if pid == 0 {
        demo_task();
        do_exit(0);
      }
      if pid > 0 {
        poke32(2147516484, pid);
      }
      if pid == 0 - 1 {
        put(63);
        put(10);
      }
    } else if cmd == 119 {
      let lp = peek32(2147516484);
      if lp >= 0 {
        while peek32(2147516416 + lp * 16) != 3 {
          y = ecall(3, 0);
        }
        put(87);
        put(48 + peek32(2147516416 + lp * 16 + 12));
        put(10);
      } else {
        put(63);
        put(10);
      }
    } else if cmd == 109 {
      let addr = bump_alloc(16);
      if addr == 0 - 1 {
        put(63);
        put(10);
      } else {
        put(77);
        print_hex(addr);
        put(10);
      }
    } else if cmd == 102 {
      cmd_fs();
    } else if cmd == 103 {
      cmd_gui();
    } else if cmd == 110 {
      cmd_net();
    } else if cmd == 113 {
      put(66);
      put(89);
      put(69);
      put(10);
      running = 0;
    } else {
      put(63);
      put(10);
    }
    y = ecall(3, 0);
  }
}
