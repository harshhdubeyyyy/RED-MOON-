// File-manager app kernel (Phase F, directory listing).
//
// A tiny directory in RAM: three file names stored as
// zero-terminated word-per-character strings at 0x9000,
// 0x9030, 0x9060, sizes at 0x9080, deleted flags at 0x9090.
// The demo lists all three files, deletes the first, and
// lists again — the deleted file is skipped.
//
// Expected model UART transcript:
//   KERN\nboot 120\nnotes 45\ngame 300\nnotes 45\ngame 300\nDONE
// , halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 100 {
    put(48 + v / 100);
  }
  if v >= 10 {
    put(48 + (v / 10) % 10);
  }
  put(48 + v % 10);
}

fn put_name(base: int) {
  let mut j = 0;
  while peek32(base + j * 4) != 0 {
    put(peek32(base + j * 4));
    j = j + 1;
  }
}

fn fm_list() {
  let mut i = 0;
  while i < 3 {
    if peek32(37008 + i * 4) == 0 {
      put_name(36864 + i * 48);
      put(32);
      put_num(peek32(36992 + i * 4));
      put(10);
    }
    i = i + 1;
  }
}

fn main() {
  poke32(36864, 98);
  poke32(36868, 111);
  poke32(36872, 111);
  poke32(36876, 116);
  poke32(36880, 0);
  poke32(36912, 110);
  poke32(36916, 111);
  poke32(36920, 116);
  poke32(36924, 101);
  poke32(36928, 115);
  poke32(36932, 0);
  poke32(36960, 103);
  poke32(36964, 97);
  poke32(36968, 109);
  poke32(36972, 101);
  poke32(36976, 0);
  poke32(36992, 120);
  poke32(36996, 45);
  poke32(37000, 300);
  poke32(37008, 0);
  poke32(37012, 0);
  poke32(37016, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  fm_list();
  poke32(37008, 1);
  fm_list();
  put(68);
  put(79);
  put(78);
  put(69);
}
