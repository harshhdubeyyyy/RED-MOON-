// Priority scheduler policy kernel (Phase F).
//
// Scheduler v1 (kernel_sched) was round-robin. This kernel
// implements the policy step separately from context switching:
// 4 task slots at 36864, 8 bytes each (state at +0, priority
// at +4). pick() returns the highest-priority ready slot.
// The demo marks each picked task done, so the run order must
// be strict priority order, not slot order.
//
// Demo: slots 0/1/2 ready with priorities 1/3/2, slot 3 free.
// Expected model UART transcript:
//   KERN\nP1\nP2\nP0\nDONE, halted.
// Final states: [2, 2, 2, 0] (done, done, done, free).

fn put(c: int) {
  poke32(268435456, c);
}

fn pick() -> int {
  let mut best = 0 - 1;
  let mut best_pri = 0 - 1;
  let mut s = 0;
  while s < 4 {
    if peek32(36864 + s * 8) == 1 {
      let pri = peek32(36864 + s * 8 + 4);
      if pri > best_pri {
        best_pri = pri;
        best = s;
      }
    }
    s = s + 1;
  }
  return best;
}

fn main() {
  poke32(36864, 1);
  poke32(36868, 1);
  poke32(36872, 1);
  poke32(36876, 3);
  poke32(36880, 1);
  poke32(36884, 2);
  poke32(36888, 0);
  poke32(36892, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut n = 0;
  while n < 3 {
    let s = pick();
    put(80);
    put(48 + s);
    put(10);
    poke32(36864 + s * 8, 2);
    n = n + 1;
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
