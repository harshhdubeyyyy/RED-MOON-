// JalOS 0.1.0 — a complete teaching operating system written in Jal Pari.
//
// What this IS: every subsystem a modern OS has — bootloader, kernel,
// scheduler, virtual memory allocator, hierarchical filesystem with
// permissions, users, devices, networking, a package manager, system
// services, logging, and a shell with ~30 commands — implemented
// faithfully and running as one Jal Pari program.
//
// What this IS NOT (honesty first): a bootable kernel. Jal Pari has
// no pointers, no inline assembly, no interrupts, and no freestanding
// mode — its programs run on top of a host OS through libc. So there
// are no hardware drivers here: devices are simulated, the network
// card goes through the host stack (http_get really fetches), and
// there is no GUI (no graphics builtins exist — the desktop is the
// text shell). What runs below is real: the scheduler makes real
// scheduling decisions, the allocator really allocates, the
// filesystem really stores, and permissions really deny.
//
// Network note: pkg install and httpget fetch over real HTTPS, which
// needs direct internet. In proxied sandboxes (like the VM this was
// built in) the binary's TLS handshake fails because it does not
// speak proxy CONNECT yet — plain HTTP works there, HTTPS needs a
// direct connection. That is a language HTTP-client gap, not an OS
// bug; see examples/os/README.md.
//
// Run it:  python3 forge.py run examples/os/jalos.fg
//   (no args: runs the built-in demo tour)
//   python3 forge.py run examples/os/jalos.fg <script-file>
//   python3 forge.py run examples/os/jalos.fg <single command...>

struct Proc {
    pid: int;
    name: str;
    prog: int;
    state: int;
    step: int;
    a: int;
    b: int;
    result: int;
    alive: bool;
    user: int;
    prio: int;
    ticks: int;
}

struct File {
    name: str;
    parent: int;
    is_dir: bool;
    content: str;
    owner: int;
    alive: bool;
}

struct User {
    name: str;
    uid: int;
    pass: str;
    alive: bool;
}

// regs slots: 0 next_pid, 1 free_head, 2 tick, 3 uid, 4 syslog_idx, 5 halted
// prog ids: 0 counter, 1 fibber, 2 sorter, 3 printer, 4 idler
// proc states: 0 ready, 1 running, 2 done, 3 killed

fn is_number(s: str) -> bool {
    if len(s) == 0 { return false; }
    let mut i: int = 0;
    while i < len(s) {
        let mut c: str = s[i];
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
            i = i + 1;
        } else {
            return false;
        }
    }
    return true;
}

fn tail(parts: [str], start: int) -> [str] {
    let mut out: [str] = [];
    let mut i: int = start;
    while i < len(parts) {
        push(out, parts[i]);
        i = i + 1;
    }
    return out;
}

fn tokenize(line: str) -> [str] {
    let mut raw: [str] = split(line, " ");
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(raw) {
        if raw[i] != "" {
            push(out, raw[i]);
        }
        i = i + 1;
    }
    return out;
}

fn path_parts(path: str) -> [str] {
    let mut raw: [str] = split(path, "/");
    let mut out: [str] = [];
    let mut i: int = 0;
    while i < len(raw) {
        if raw[i] != "" {
            push(out, raw[i]);
        }
        i = i + 1;
    }
    return out;
}

fn state_word(state: int) -> str {
    if state == 0 { return "ready"; }
    if state == 1 { return "running"; }
    if state == 2 { return "done"; }
    if state == 3 { return "killed"; }
    return "?";
}

fn prog_name(prog: int) -> str {
    if prog == 0 { return "counter"; }
    if prog == 1 { return "fibber"; }
    if prog == 2 { return "sorter"; }
    if prog == 3 { return "printer"; }
    if prog == 4 { return "idler"; }
    return "?";
}

fn prog_id_by_name(name: str) -> int {
    if name == "counter" { return 0; }
    if name == "fibber" { return 1; }
    if name == "sorter" { return 2; }
    if name == "printer" { return 3; }
    if name == "idler" { return 4; }
    return -1;
}

// ---- simulated physical memory: a first-fit free-list allocator ----
// heap words: block header = size in words (positive = free, negative
// = used, magnitude includes the header). Free blocks link through
// word header+1. Layout is fixed at 1024 words, like a real machine's
// RAM size being a hardware fact.

fn heap_init(heap: [int]) -> int {
    heap[0] = 1024;
    heap[1] = -1;
    return 0;
}

fn heap_alloc(heap: [int], regs: [int], n: int) -> int {
    let mut want: int = n + 1;
    let mut prev: int = -1;
    let mut cur: int = regs[1];
    while cur != -1 {
        let mut sz: int = heap[cur];
        if sz >= want {
            if sz - want >= 2 {
                let mut newfree: int = cur + want;
                heap[newfree] = sz - want;
                heap[newfree + 1] = heap[cur + 1];
                if prev == -1 {
                    regs[1] = newfree;
                } else {
                    heap[prev + 1] = newfree;
                }
                heap[cur] = 0 - want;
                return cur + 1;
            } else {
                let mut nxt: int = heap[cur + 1];
                if prev == -1 {
                    regs[1] = nxt;
                } else {
                    heap[prev + 1] = nxt;
                }
                heap[cur] = 0 - sz;
                return cur + 1;
            }
        }
        prev = cur;
        cur = heap[cur + 1];
    }
    return -1;
}

fn heap_rebuild(heap: [int], regs: [int]) -> int {
    let mut h: int = 0;
    let mut prev: int = -1;
    while h < 1024 {
        let mut sz: int = heap[h];
        if sz == 0 {
            return -1;
        }
        if sz > 0 {
            let mut total: int = sz;
            let mut m: int = h + sz;
            while m < 1024 && heap[m] > 0 {
                total = total + heap[m];
                m = m + heap[m];
            }
            heap[h] = total;
            if prev == -1 {
                regs[1] = h;
            } else {
                heap[prev + 1] = h;
            }
            prev = h;
            h = h + total;
        } else {
            h = h - sz;
        }
    }
    if prev != -1 {
        heap[prev + 1] = -1;
    }
    return 0;
}

fn heap_free(heap: [int], regs: [int], addr: int) -> int {
    if addr < 1 || addr >= 1024 {
        return -1;
    }
    let mut b: int = addr - 1;
    if heap[b] >= 0 {
        return -1;
    }
    heap[b] = 0 - heap[b];
    return heap_rebuild(heap, regs);
}

fn cmd_mem(heap: [int]) -> int {
    let mut total: int = len(heap);
    let mut freew: int = 0;
    let mut usedw: int = 0;
    let mut blocks: int = 0;
    let mut h: int = 0;
    while h < total {
        let mut sz: int = heap[h];
        if sz == 0 {
            h = total;
        } else {
            if sz > 0 {
                freew = freew + sz;
            } else {
                usedw = usedw - sz;
            }
            blocks = blocks + 1;
            h = h + abs(sz);
        }
    }
    println("memory: total =", total, "words, free =", freew, "used =", usedw, "blocks =", blocks);
    return 0;
}

// ---- virtual filesystem: inodes by index, directories by parent ----

fn fs_find(files: [File], parent: int, name: str) -> int {
    let mut i: int = 0;
    while i < len(files) {
        let mut f: File = files[i];
        if f.alive && f.parent == parent && f.name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn fs_resolve(files: [File], path: str) -> int {
    if path == "/" {
        return 0;
    }
    let mut parts: [str] = split(path, "/");
    let mut cur: int = 0;
    let mut i: int = 0;
    while i < len(parts) {
        if parts[i] != "" {
            let mut nxt: int = fs_find(files, cur, parts[i]);
            if nxt == -1 {
                return -1;
            }
            cur = nxt;
        }
        i = i + 1;
    }
    return cur;
}

fn path_base(path: str) -> str {
    let mut parts: [str] = path_parts(path);
    if len(parts) == 0 {
        return "/";
    }
    return parts[len(parts) - 1];
}

fn path_parent_idx(files: [File], path: str) -> int {
    let mut parts: [str] = path_parts(path);
    if len(parts) <= 1 {
        return 0;
    }
    let mut parent_path: str = "/";
    let mut j: int = 0;
    while j < len(parts) - 1 {
        parent_path = parent_path + parts[j] + "/";
        j = j + 1;
    }
    return fs_resolve(files, parent_path);
}

fn fs_free_slot(files: [File]) -> int {
    let mut i: int = 0;
    while i < len(files) {
        let mut f: File = files[i];
        if !f.alive {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn fs_mkdir(files: [File], regs: [int], path: str) -> int {
    let mut parent: int = path_parent_idx(files, path);
    if parent == -1 {
        println("mkdir: cannot create directory: No such file or directory");
        return 1;
    }
    let mut pf: File = files[parent];
    if !pf.is_dir {
        println("mkdir: not a directory");
        return 1;
    }
    if pf.owner != regs[3] && regs[3] != 0 {
        println("mkdir: permission denied");
        return 1;
    }
    let mut base: str = path_base(path);
    if fs_find(files, parent, base) != -1 {
        println("mkdir: cannot create directory: File exists");
        return 1;
    }
    let mut slot: int = fs_free_slot(files);
    if slot == -1 {
        println("mkdir: no space left on device");
        return 1;
    }
    files[slot] = File { name: base, parent: parent, is_dir: true, content: "", owner: regs[3], alive: true };
    println("created directory:", path);
    return 0;
}

fn fs_write(files: [File], regs: [int], path: str, text: str) -> int {
    let mut existing: int = fs_find(files, path_parent_idx(files, path), path_base(path));
    if existing != -1 {
        let mut f: File = files[existing];
        if f.is_dir {
            println("write: Is a directory");
            return 1;
        }
        if f.owner != regs[3] && regs[3] != 0 {
            println("write: permission denied");
            return 1;
        }
        f.content = text;
        files[existing] = f;
        println("wrote", len(text), "bytes to", path);
        return 0;
    }
    let mut parent: int = path_parent_idx(files, path);
    if parent == -1 {
        println("write: No such file or directory");
        return 1;
    }
    let mut pf: File = files[parent];
    if !pf.is_dir {
        println("write: not a directory");
        return 1;
    }
    if pf.owner != regs[3] && regs[3] != 0 {
        println("write: permission denied");
        return 1;
    }
    let mut slot: int = fs_free_slot(files);
    if slot == -1 {
        println("write: no space left on device");
        return 1;
    }
    files[slot] = File { name: path_base(path), parent: parent, is_dir: false, content: text, owner: regs[3], alive: true };
    println("wrote", len(text), "bytes to", path);
    return 0;
}

fn fs_cat(files: [File], regs: [int], procs: [Proc], path: str) -> int {
    if starts_with(path, "/proc/") {
        let mut pidstr: str = substr(path, 6, len(path) - 6);
        if !is_number(pidstr) {
            println("cat: no such process");
            return 1;
        }
        let mut pid: int = parse_int(pidstr);
        let mut i: int = 0;
        while i < len(procs) {
            let mut p: Proc = procs[i];
            if p.alive && p.pid == pid {
                println("pid:", p.pid, "name:", p.name, "state:", state_word(p.state), "prog:", prog_name(p.prog), "ticks:", p.ticks, "result:", p.result);
                return 0;
            }
            i = i + 1;
        }
        println("cat: no such process");
        return 1;
    }
    let mut idx: int = fs_resolve(files, path);
    if idx == -1 {
        println("cat: No such file or directory");
        return 1;
    }
    let mut f: File = files[idx];
    if f.is_dir {
        println("cat: Is a directory");
        return 1;
    }
    println(f.content);
    return 0;
}

fn fs_ls(files: [File], regs: [int], procs: [Proc], path: str) -> int {
    if path == "/proc" {
        let mut i: int = 0;
        while i < len(procs) {
            let mut p: Proc = procs[i];
            if p.alive {
                println(p.pid, p.name, state_word(p.state));
            }
            i = i + 1;
        }
        return 0;
    }
    let mut idx: int = fs_resolve(files, path);
    if idx == -1 {
        println("ls: No such file or directory");
        return 1;
    }
    let mut d: File = files[idx];
    if !d.is_dir {
        println("ls: Not a directory");
        return 1;
    }
    let mut i: int = 0;
    while i < len(files) {
        let mut f: File = files[i];
        if f.alive && f.parent == idx && i != idx {
            if f.is_dir {
                println(f.name, "(dir)");
            } else {
                println(f.name);
            }
        }
        i = i + 1;
    }
    return 0;
}

fn fs_rm(files: [File], regs: [int], path: str) -> int {
    let mut idx: int = fs_resolve(files, path);
    if idx == -1 {
        println("rm: No such file or directory");
        return 1;
    }
    if idx == 0 {
        println("rm: cannot remove /");
        return 1;
    }
    let mut f: File = files[idx];
    if f.owner != regs[3] && regs[3] != 0 {
        println("rm: permission denied");
        return 1;
    }
    if f.is_dir {
        let mut i: int = 0;
        while i < len(files) {
            let mut c: File = files[i];
            if c.alive && c.parent == idx {
                println("rm: Directory not empty");
                return 1;
            }
            i = i + 1;
        }
    }
    f.alive = false;
    files[idx] = f;
    println("removed:", path);
    return 0;
}

fn fs_cp(files: [File], regs: [int], src: str, dst: str) -> int {
    let mut s: int = fs_resolve(files, src);
    if s == -1 {
        println("cp: No such file or directory");
        return 1;
    }
    let mut sf: File = files[s];
    if sf.is_dir {
        println("cp: omitting directory");
        return 1;
    }
    let mut parent: int = path_parent_idx(files, dst);
    if parent == -1 {
        println("cp: No such file or directory");
        return 1;
    }
    let mut pf: File = files[parent];
    if !pf.is_dir {
        println("cp: not a directory");
        return 1;
    }
    if pf.owner != regs[3] && regs[3] != 0 {
        println("cp: permission denied");
        return 1;
    }
    let mut existing: int = fs_find(files, parent, path_base(dst));
    if existing != -1 {
        let mut d: File = files[existing];
        if d.is_dir {
            println("cp: Is a directory");
            return 1;
        }
        if d.owner != regs[3] && regs[3] != 0 {
            println("cp: permission denied");
            return 1;
        }
        d.content = sf.content;
        files[existing] = d;
    } else {
        let mut slot: int = fs_free_slot(files);
        if slot == -1 {
            println("cp: no space left on device");
            return 1;
        }
        files[slot] = File { name: path_base(dst), parent: parent, is_dir: false, content: sf.content, owner: regs[3], alive: true };
    }
    println("copied.");
    return 0;
}

fn fs_mv(files: [File], regs: [int], src: str, dst: str) -> int {
    let mut s: int = fs_resolve(files, src);
    if s == -1 {
        println("mv: No such file or directory");
        return 1;
    }
    if s == 0 {
        println("mv: cannot move /");
        return 1;
    }
    let mut sf: File = files[s];
    if sf.owner != regs[3] && regs[3] != 0 {
        println("mv: permission denied");
        return 1;
    }
    let mut parent: int = path_parent_idx(files, dst);
    if parent == -1 {
        println("mv: No such file or directory");
        return 1;
    }
    let mut pf: File = files[parent];
    if !pf.is_dir {
        println("mv: not a directory");
        return 1;
    }
    if fs_find(files, parent, path_base(dst)) != -1 {
        println("mv: File exists");
        return 1;
    }
    sf.name = path_base(dst);
    sf.parent = parent;
    files[s] = sf;
    println("moved.");
    return 0;
}

// ---- processes and the scheduler: priority scheduling in quanta ----
// Each tick runs one step of the highest-priority ready process
// (ties: lowest slot first). Steps are the quanta: a process that
// does not finish its step goes back to ready, like a preemptive
// kernel with a one-step quantum.

fn proc_find_free(procs: [Proc]) -> int {
    let mut i: int = 0;
    while i < len(procs) {
        let mut p: Proc = procs[i];
        if !p.alive {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn proc_find_by_name(procs: [Proc], name: str) -> int {
    let mut i: int = 0;
    while i < len(procs) {
        let mut p: Proc = procs[i];
        if p.alive && p.name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn proc_step(procs: [Proc], sortarr: [int], idx: int) -> int {
    let mut p: Proc = procs[idx];
    if p.prog == 0 {
        p.a = p.a + 1;
        p.step = p.step + 1;
        if p.step >= 5 {
            p.state = 2;
            p.result = p.a;
            procs[idx] = p;
            return 1;
        }
        procs[idx] = p;
        return 0;
    }
    if p.prog == 1 {
        let mut c: int = p.a + p.b;
        p.a = p.b;
        p.b = c;
        p.step = p.step + 1;
        if p.step >= 12 {
            p.state = 2;
            p.result = p.a;
            procs[idx] = p;
            return 1;
        }
        procs[idx] = p;
        return 0;
    }
    if p.prog == 2 {
        let mut pass: int = p.step;
        let mut i: int = 0;
        while i < len(sortarr) - 1 - pass {
            if sortarr[i] > sortarr[i + 1] {
                let mut tmp: int = sortarr[i];
                sortarr[i] = sortarr[i + 1];
                sortarr[i + 1] = tmp;
            }
            i = i + 1;
        }
        p.step = p.step + 1;
        if p.step >= len(sortarr) - 1 {
            p.state = 2;
            p.result = sortarr[0];
            procs[idx] = p;
            return 1;
        }
        procs[idx] = p;
        return 0;
    }
    if p.prog == 3 {
        println("printer:", p.name, "says hello", p.step);
        p.step = p.step + 1;
        if p.step >= 3 {
            p.state = 2;
            p.result = p.step;
            procs[idx] = p;
            return 1;
        }
        procs[idx] = p;
        return 0;
    }
    if p.prog == 4 {
        p.step = p.step + 1;
        if p.step >= 2 {
            p.state = 2;
            p.result = 0;
            procs[idx] = p;
            return 1;
        }
        procs[idx] = p;
        return 0;
    }
    p.state = 2;
    procs[idx] = p;
    return 1;
}

fn append_log(files: [File], regs: [int], msg: str) -> int {
    let mut idx: int = regs[4];
    let mut f: File = files[idx];
    f.content = f.content + msg + "\n";
    files[idx] = f;
    return 0;
}

fn run_scheduler(procs: [Proc], sortarr: [int], files: [File], regs: [int]) -> int {
    while true {
        let mut ready: int = 0;
        let mut i: int = 0;
        while i < len(procs) {
            let mut p: Proc = procs[i];
            if p.alive && p.state == 0 {
                ready = ready + 1;
            }
            i = i + 1;
        }
        if ready == 0 {
            println("scheduler: all processes finished");
            return 0;
        }
        if regs[2] >= 200 {
            println("scheduler: tick limit reached");
            return 0;
        }
        let mut best: int = -1;
        let mut bestprio: int = -1;
        i = 0;
        while i < len(procs) {
            let mut p: Proc = procs[i];
            if p.alive && p.state == 0 && p.prio > bestprio {
                bestprio = p.prio;
                best = i;
            }
            i = i + 1;
        }
        let mut p: Proc = procs[best];
        p.state = 1;
        procs[best] = p;
        let mut done: int = proc_step(procs, sortarr, best);
        p = procs[best];
        p.ticks = p.ticks + 1;
        regs[2] = regs[2] + 1;
        if done == 1 {
            println("tick", regs[2], ": pid", p.pid, p.name, "step", p.step, "done");
        } else {
            p.state = 0;
            println("tick", regs[2], ": pid", p.pid, p.name, "step", p.step, "running");
        }
        procs[best] = p;
        if regs[2] % 5 == 0 {
            let mut d: int = append_log(files, regs, "cron: heartbeat");
        }
    }
    return 0;
}

// ---- users ----

fn user_find(users: [User], name: str) -> int {
    let mut i: int = 0;
    while i < len(users) {
        let mut u: User = users[i];
        if u.alive && u.name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn user_name(users: [User], uid: int) -> str {
    let mut i: int = 0;
    while i < len(users) {
        let mut u: User = users[i];
        if u.alive && u.uid == uid {
            return u.name;
        }
        i = i + 1;
    }
    return "unknown";
}

fn rebuild_passwd(files: [File], users: [User]) -> int {
    let mut content: str = "";
    let mut i: int = 0;
    while i < len(users) {
        let mut u: User = users[i];
        if u.alive {
            content = content + u.name + "\n";
        }
        i = i + 1;
    }
    let mut idx: int = fs_resolve(files, "/etc/passwd");
    if idx == -1 {
        return 1;
    }
    let mut f: File = files[idx];
    f.content = content;
    files[idx] = f;
    return 0;
}

// ---- the shell: one big dispatch, like a real shell's builtin table ----

// ---- ai demo: a perceptron that learns the OR gate (pure ints, deterministic) ----
fn cmd_ai() -> int {
    let mut w0: int = 0;
    let mut w1: int = 0;
    let mut b: int = 0;
    let mut xs0: [int] = [0, 0, 1, 1];
    let mut xs1: [int] = [0, 1, 0, 1];
    let mut ts: [int] = [0, 1, 1, 1];
    let mut epoch: int = 0;
    let mut used: int = 0;
    while epoch < 10 {
        let mut errors: int = 0;
        let mut i: int = 0;
        while i < 4 {
            let mut sum: int = w0 * xs0[i] + w1 * xs1[i] + b;
            let mut y: int = 0;
            if sum > 0 {
                y = 1;
            }
            let mut err: int = ts[i] - y;
            if err != 0 {
                w0 = w0 + err * xs0[i];
                w1 = w1 + err * xs1[i];
                b = b + err;
                errors = errors + 1;
            }
            i = i + 1;
        }
        used = epoch + 1;
        if errors == 0 {
            break;
        }
        epoch = epoch + 1;
    }
    println("ai: perceptron learned OR in", used, "epochs");
    println("ai: weights =", w0, w1, "bias =", b);
    let mut j: int = 0;
    while j < 4 {
        let mut sum: int = w0 * xs0[j] + w1 * xs1[j] + b;
        let mut y: int = 0;
        if sum > 0 {
            y = 1;
        }
        println(xs0[j], "OR", xs1[j], "=", y);
        j = j + 1;
    }
    return 0;
}

// ---- security audit: counts live objects, reports the permission model ----
fn cmd_audit(files: [File], procs: [Proc]) -> int {
    let mut nfiles: int = 0;
    let mut ndirs: int = 0;
    let mut root_owned: int = 0;
    let mut guest_owned: int = 0;
    let mut i: int = 0;
    while i < len(files) {
        if files[i].alive {
            if files[i].is_dir {
                ndirs = ndirs + 1;
            } else {
                nfiles = nfiles + 1;
            }
            if files[i].owner == 0 {
                root_owned = root_owned + 1;
            } else {
                guest_owned = guest_owned + 1;
            }
        }
        i = i + 1;
    }
    let mut nprocs: int = 0;
    let mut j: int = 0;
    while j < len(procs) {
        if procs[j].alive {
            nprocs = nprocs + 1;
        }
        j = j + 1;
    }
    println("audit: files =", nfiles, "dirs =", ndirs, "procs =", nprocs);
    println("audit: root-owned =", root_owned, "guest-owned =", guest_owned);
    println("audit: OK - permission model is owner-or-root only (no world-writable files exist)");
    return 0;
}

fn cmd_dispatch(parts: [str], procs: [Proc], files: [File], users: [User], heap: [int], sortarr: [int], regs: [int], history: [str]) -> int {
    if len(parts) == 0 {
        return 0;
    }
    let mut cmd: str = parts[0];
    if cmd == "help" {
        println("JalOS commands:");
        println("  help, echo, ls, cat, write, mkdir, rm, cp, mv");
        println("  ps, top, run, sched, kill, mem, malloc, free, df");
        println("  uname, hostname, whoami, su, useradd, env");
        println("  ping, ifconfig, httpget, pkg, services, logger");
        println("  history, uptime, shutdown");
        println("  ai, audit (perceptron demo, security audit)");
        return 0;
    }
    if cmd == "echo" {
        println(join(tail(parts, 1), " "));
        return 0;
    }
    if cmd == "ls" {
        let mut path: str = "/";
        if len(parts) >= 2 {
            path = parts[1];
        }
        let mut d: int = fs_ls(files, regs, procs, path);
        return 0;
    }
    if cmd == "cat" {
        if len(parts) < 2 {
            println("usage: cat <path>");
            return 1;
        }
        let mut d: int = fs_cat(files, regs, procs, parts[1]);
        return 0;
    }
    if cmd == "write" {
        if len(parts) < 2 {
            println("usage: write <path> <text...>");
            return 1;
        }
        let mut d: int = fs_write(files, regs, parts[1], join(tail(parts, 2), " "));
        return 0;
    }
    if cmd == "mkdir" {
        if len(parts) < 2 {
            println("usage: mkdir <path>");
            return 1;
        }
        let mut d: int = fs_mkdir(files, regs, parts[1]);
        return 0;
    }
    if cmd == "rm" {
        if len(parts) < 2 {
            println("usage: rm <path>");
            return 1;
        }
        let mut d: int = fs_rm(files, regs, parts[1]);
        return 0;
    }
    if cmd == "cp" {
        if len(parts) < 3 {
            println("usage: cp <src> <dst>");
            return 1;
        }
        let mut d: int = fs_cp(files, regs, parts[1], parts[2]);
        return 0;
    }
    if cmd == "mv" {
        if len(parts) < 3 {
            println("usage: mv <src> <dst>");
            return 1;
        }
        let mut d: int = fs_mv(files, regs, parts[1], parts[2]);
        return 0;
    }
    if cmd == "ps" {
        let mut i: int = 0;
        while i < len(procs) {
            let mut p: Proc = procs[i];
            if p.alive {
                println("pid", p.pid, p.name, state_word(p.state), "ticks", p.ticks, "result", p.result, "user", user_name(users, p.user));
            }
            i = i + 1;
        }
        return 0;
    }
    if cmd == "top" {
        let mut idxs: [int] = [];
        let mut i: int = 0;
        while i < len(procs) {
            let mut p: Proc = procs[i];
            if p.alive {
                push(idxs, i);
            }
            i = i + 1;
        }
        let mut a: int = 0;
        while a < len(idxs) {
            let mut b: int = 0;
            while b < len(idxs) - 1 - a {
                let mut pa: Proc = procs[idxs[b]];
                let mut pb: Proc = procs[idxs[b + 1]];
                if pa.ticks < pb.ticks {
                    let mut tmp: int = idxs[b];
                    idxs[b] = idxs[b + 1];
                    idxs[b + 1] = tmp;
                }
                b = b + 1;
            }
            a = a + 1;
        }
        i = 0;
        while i < len(idxs) {
            let mut p: Proc = procs[idxs[i]];
            println("pid", p.pid, p.name, state_word(p.state), "ticks", p.ticks, "result", p.result, "user", user_name(users, p.user));
            i = i + 1;
        }
        return 0;
    }
    if cmd == "run" {
        if len(parts) < 2 {
            println("usage: run <counter|fibber|sorter|printer|idler>");
            return 1;
        }
        let mut prog: int = prog_id_by_name(parts[1]);
        if prog == -1 {
            println("run: unknown program:", parts[1]);
            return 1;
        }
        let mut slot: int = proc_find_free(procs);
        if slot == -1 {
            println("run: process table full");
            return 1;
        }
        let mut prio: int = 5;
        if prog == 3 {
            prio = 8;
        }
        if prog == 2 {
            prio = 3;
        }
        if prog == 4 {
            prio = 1;
        }
        let mut pid: int = regs[0];
        regs[0] = pid + 1;
        let mut a0: int = 0;
        let mut b0: int = 0;
        if prog == 1 {
            b0 = 1;
        }
        procs[slot] = Proc { pid: pid, name: parts[1], prog: prog, state: 0, step: 0, a: a0, b: b0, result: 0, alive: true, user: regs[3], prio: prio, ticks: 0 };
        println("spawned pid", pid, parts[1], "prio", prio);
        return 0;
    }
    if cmd == "sched" {
        let mut d: int = run_scheduler(procs, sortarr, files, regs);
        return 0;
    }
    if cmd == "kill" {
        if len(parts) < 2 {
            println("usage: kill <name>");
            return 1;
        }
        let mut idx: int = proc_find_by_name(procs, parts[1]);
        if idx == -1 {
            println("kill: no such process:", parts[1]);
            return 1;
        }
        let mut p: Proc = procs[idx];
        p.state = 3;
        procs[idx] = p;
        println("killed pid", p.pid);
        return 0;
    }
    if cmd == "mem" {
        let mut d: int = cmd_mem(heap);
        return 0;
    }
    if cmd == "malloc" {
        if len(parts) < 2 || !is_number(parts[1]) {
            println("usage: malloc <words>");
            return 1;
        }
        let mut addr: int = heap_alloc(heap, regs, parse_int(parts[1]));
        if addr == -1 {
            println("malloc: out of memory");
            return 1;
        }
        println("malloc:", parts[1], "words at", addr);
        return 0;
    }
    if cmd == "free" {
        if len(parts) < 2 || !is_number(parts[1]) {
            println("usage: free <addr>");
            return 1;
        }
        let mut rc: int = heap_free(heap, regs, parse_int(parts[1]));
        if rc != 0 {
            println("free: not allocated");
            return 1;
        }
        println("freed", parts[1]);
        return 0;
    }
    if cmd == "df" {
        let mut n: int = 0;
        let mut chars: int = 0;
        let mut i: int = 0;
        while i < len(files) {
            let mut f: File = files[i];
            if f.alive {
                n = n + 1;
                chars = chars + len(f.content);
            }
            i = i + 1;
        }
        println("filesystem: files =", n, "content chars =", chars);
        return 0;
    }
    if cmd == "uname" {
        println("JalOS jalpari-kernel 0.1.0 x86_64-sim");
        return 0;
    }
    if cmd == "hostname" {
        println("jalos");
        return 0;
    }
    if cmd == "whoami" {
        println(user_name(users, regs[3]));
        return 0;
    }
    if cmd == "su" {
        if len(parts) < 3 {
            println("usage: su <user> <pass>");
            return 1;
        }
        let mut idx: int = user_find(users, parts[1]);
        if idx == -1 {
            println("su: authentication failure");
            return 1;
        }
        let mut u: User = users[idx];
        if u.pass != parts[2] {
            println("su: authentication failure");
            return 1;
        }
        regs[3] = u.uid;
        println("switched to", parts[1]);
        return 0;
    }
    if cmd == "useradd" {
        if regs[3] != 0 {
            println("useradd: only root may add users");
            return 1;
        }
        if len(parts) < 3 {
            println("usage: useradd <name> <pass>");
            return 1;
        }
        if user_find(users, parts[1]) != -1 {
            println("useradd: user exists");
            return 1;
        }
        let mut slot: int = -1;
        let mut i: int = 0;
        while i < len(users) {
            let mut u: User = users[i];
            if !u.alive {
                slot = i;
                i = len(users);
            } else {
                i = i + 1;
            }
        }
        if slot == -1 {
            println("useradd: user table full");
            return 1;
        }
        let mut maxuid: int = 0;
        i = 0;
        while i < len(users) {
            let mut u: User = users[i];
            if u.alive && u.uid > maxuid {
                maxuid = u.uid;
            }
            i = i + 1;
        }
        users[slot] = User { name: parts[1], uid: maxuid + 1, pass: parts[2], alive: true };
        let mut d: int = rebuild_passwd(files, users);
        println("user added:", parts[1]);
        return 0;
    }
    if cmd == "ping" {
        if len(parts) < 2 {
            println("usage: ping <host>");
            return 1;
        }
        if parts[1] == "localhost" || parts[1] == "127.0.0.1" {
            println("reply from 127.0.0.1: bytes=32 time<1ms TTL=64");
            println("reply from 127.0.0.1: bytes=32 time<1ms TTL=64");
            println("reply from 127.0.0.1: bytes=32 time<1ms TTL=64");
            println("reply from 127.0.0.1: bytes=32 time<1ms TTL=64");
            println("ping statistics: 4 transmitted, 4 received, 0% loss (loopback, simulated)");
            return 0;
        }
        println("ping: connect: Network is unreachable");
        return 1;
    }
    if cmd == "ifconfig" {
        println("lo: inet 127.0.0.1 (loopback)");
        println("eth0: inet 10.0.2.15 (via host NAT, simulated)");
        return 0;
    }
    if cmd == "httpget" {
        if len(parts) < 2 {
            println("usage: httpget <url>");
            return 1;
        }
        if !starts_with(parts[1], "http://") && !starts_with(parts[1], "https://") {
            println("httpget: URL must start with http:// or https://");
            return 1;
        }
        let mut body: str = http_get(parts[1]);
        println("fetched", len(body), "bytes:");
        println(substr(body, 0, 200));
        return 0;
    }
    if cmd == "pkg" {
        if len(parts) < 2 {
            println("usage: pkg <list|search|install|remove|info> [name]");
            return 1;
        }
        let mut sub: str = parts[1];
        if sub == "list" {
            let mut d: int = fs_ls(files, regs, procs, "/pkg");
            return 0;
        }
        if sub == "search" {
            let mut catalog: [str] = ["units 0.1.0", "money 0.1.0", "geometry 0.1.0", "interest 0.1.0", "roman 0.1.0", "bases 0.1.0", "dice 0.1.0", "percentages 0.1.0", "loans 0.1.0", "bmi 0.1.0", "colors 0.1.0", "sorting 0.1.0", "search 0.1.0", "primes 0.1.0", "factors 0.1.0", "statistics 0.1.0", "grades 0.1.0", "tax 0.1.0", "cooking 0.1.0", "budget 0.1.0", "checks 0.1.0", "morse 0.1.0", "textstats 0.1.0", "speed 0.1.0", "data 0.1.0", "angle 0.1.0", "fractions 0.1.0", "vectors 0.1.0", "matrices 0.1.0", "polynomials 0.1.0"];
            let mut i: int = 0;
            while i < len(catalog) {
                println(catalog[i]);
                i = i + 1;
            }
            return 0;
        }
        if sub == "install" || sub == "info" || sub == "remove" {
            if len(parts) < 3 {
                println("usage: pkg <install|info|remove> <name>");
                return 1;
            }
            let mut name: str = parts[2];
            let mut catalog: [str] = ["units 0.1.0", "money 0.1.0", "geometry 0.1.0", "interest 0.1.0", "roman 0.1.0", "bases 0.1.0", "dice 0.1.0", "percentages 0.1.0", "loans 0.1.0", "bmi 0.1.0", "colors 0.1.0", "sorting 0.1.0", "search 0.1.0", "primes 0.1.0", "factors 0.1.0", "statistics 0.1.0", "grades 0.1.0", "tax 0.1.0", "cooking 0.1.0", "budget 0.1.0", "checks 0.1.0", "morse 0.1.0", "textstats 0.1.0", "speed 0.1.0", "data 0.1.0", "angle 0.1.0", "fractions 0.1.0", "vectors 0.1.0", "matrices 0.1.0", "polynomials 0.1.0"];
            let mut found: bool = false;
            let mut i: int = 0;
            while i < len(catalog) {
                let mut ep: [str] = split(catalog[i], " ");
                if ep[0] == name {
                    found = true;
                }
                i = i + 1;
            }
            if !found {
                println("pkg: package not found:", name);
                return 1;
            }
            if sub == "info" {
                println(name, "0.1.0 (from the Jal Pari registry)");
                return 0;
            }
            if sub == "remove" {
                let mut d: int = fs_rm(files, regs, "/pkg/" + name + ".fg");
                return 0;
            }
            let mut url: str = "https://cdn.jsdelivr.net/gh/jayantt1dubeyy/RED-MOON-@main/packages/" + name + "/src/" + name + ".fg";
            let mut body: str = http_get(url);
            let mut d: int = fs_write(files, regs, "/pkg/" + name + ".fg", body);
            println("installed:", name);
            return 0;
        }
        println("pkg: unknown subcommand:", sub);
        return 1;
    }
    if cmd == "services" {
        println("cron    running  (system scheduler daemon)");
        println("syslog  running  (logging daemon, /var/log/syslog)");
        println("netd    running  (network daemon, loopback + host NAT)");
        println("pkgd    stopped  (package daemon, starts on pkg install)");
        return 0;
    }
    if cmd == "logger" {
        let mut d: int = append_log(files, regs, join(tail(parts, 1), " "));
        return 0;
    }
    if cmd == "history" {
        let mut i: int = 0;
        while i < len(history) {
            println(i, history[i]);
            i = i + 1;
        }
        return 0;
    }
    if cmd == "uptime" {
        println("uptime =", clock_micros() / 1000000, "s");
        return 0;
    }
    if cmd == "env" {
        let mut uname: str = user_name(users, regs[3]);
        println("USER=" + uname);
        println("HOSTNAME=jalos");
        println("SHELL=/bin/jalos");
        if regs[3] == 0 {
            println("HOME=/root");
        } else {
            println("HOME=/home/" + uname);
        }
        return 0;
    }
    if cmd == "ai" {
        let mut d: int = cmd_ai();
        return 0;
    }
    if cmd == "audit" {
        let mut d: int = cmd_audit(files, procs);
        return 0;
    }
    if cmd == "shutdown" {
        println("JalOS halted. Goodbye.");
        regs[5] = 1;
        return 0;
    }
    println("jalos: command not found:", cmd);
    return 1;
}

// ---- the shell loop + boot + demo ----

fn run_lines(lines: [str], procs: [Proc], files: [File], users: [User], heap: [int], sortarr: [int], regs: [int]) -> int {
    let mut history: [str] = [];
    let mut i: int = 0;
    while i < len(lines) {
        let mut line: str = trim(lines[i]);
        if line != "" && !starts_with(line, "#") {
            push(history, line);
            println(user_name(users, regs[3]) + "@jalos:~#", line);
            let mut parts: [str] = tokenize(line);
            let mut d: int = cmd_dispatch(parts, procs, files, users, heap, sortarr, regs, history);
            if regs[5] == 1 {
                return 0;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn main() -> int {
    let mut heap: [int] = [];
    let mut i: int = 0;
    while i < 1024 {
        push(heap, 0);
        i = i + 1;
    }
    let mut d0: int = heap_init(heap);
    let mut procs: [Proc] = [];
    i = 0;
    while i < 16 {
        push(procs, Proc { pid: 0, name: "", prog: 0, state: 0, step: 0, a: 0, b: 0, result: 0, alive: false, user: 0, prio: 0, ticks: 0 });
        i = i + 1;
    }
    let mut files: [File] = [];
    i = 0;
    while i < 64 {
        push(files, File { name: "", parent: 0, is_dir: false, content: "", owner: 0, alive: false });
        i = i + 1;
    }
    let mut users: [User] = [];
    i = 0;
    while i < 8 {
        push(users, User { name: "", uid: 0, pass: "", alive: false });
        i = i + 1;
    }
    let mut sortarr: [int] = [5, 2, 8, 1, 9, 3, 7, 4];
    let mut regs: [int] = [1, 0, 0, 0, 0, 0];
    files[0] = File { name: "/", parent: 0, is_dir: true, content: "", owner: 0, alive: true };
    users[0] = User { name: "root", uid: 0, pass: "root", alive: true };
    users[1] = User { name: "guest", uid: 1, pass: "guest", alive: true };
    println("JalOS 0.1.0 -- a teaching OS in Jal Pari");
    if heap[0] == 1024 {
        println("[  OK  ] memory test: 1024 words");
    } else {
        println("[ FAIL ] memory test");
    }
    let mut d: int = fs_mkdir(files, regs, "/etc");
    d = fs_mkdir(files, regs, "/var");
    d = fs_mkdir(files, regs, "/var/log");
    d = fs_mkdir(files, regs, "/home");
    d = fs_mkdir(files, regs, "/home/guest");
    d = fs_mkdir(files, regs, "/pkg");
    d = fs_write(files, regs, "/etc/passwd", "");
    d = rebuild_passwd(files, users);
    d = fs_write(files, regs, "/var/log/syslog", "");
    regs[4] = fs_resolve(files, "/var/log/syslog");
    d = fs_write(files, regs, "/README", "Welcome to JalOS.\nA complete teaching OS written in Jal Pari.\nTry: help, ls, ps, run counter, sched, mem, pkg search\n");
    println("[  OK  ] mounted rootfs");
    d = append_log(files, regs, "boot: kernel started");
    d = append_log(files, regs, "boot: init done");
    println("[  OK  ] init: syslogd, cron, netd started");
    println("jalos login: root (uid 0)");
    let mut a: [str] = args();
    if len(a) == 0 {
        let mut demo: [str] = ["echo Welcome to JalOS", "uname", "hostname", "whoami", "env", "ls /", "ls /etc", "cat /etc/passwd", "cat /README", "mkdir /home/guest/docs", "write /home/guest/docs/note.txt Hello from JalOS", "ls /home/guest/docs", "cat /home/guest/docs/note.txt", "cp /home/guest/docs/note.txt /home/guest/docs/copy.txt", "ls /home/guest/docs", "mv /home/guest/docs/copy.txt /home/guest/docs/moved.txt", "ls /home/guest/docs", "su guest guest", "whoami", "write /README hacked", "su root root", "whoami", "mem", "malloc 16", "malloc 32", "mem", "free 1", "mem", "run counter", "run fibber", "run sorter", "run printer", "run idler", "ps", "sched", "ps", "top", "df", "ping localhost", "ifconfig", "pkg search", "pkg list", "services", "logger JalOS demo finished", "cat /var/log/syslog", "history", "shutdown"];
        let mut r: int = run_lines(demo, procs, files, users, heap, sortarr, regs);
    } else if len(a) == 1 && file_exists(a[0]) {
        let mut text: str = read_file(a[0]);
        let mut lines: [str] = split(text, "\n");
        let mut r: int = run_lines(lines, procs, files, users, heap, sortarr, regs);
    } else {
        let mut lines: [str] = [join(a, " ")];
        let mut r: int = run_lines(lines, procs, files, users, heap, sortarr, regs);
    }
    return 0;
}
