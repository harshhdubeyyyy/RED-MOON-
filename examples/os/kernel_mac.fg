  if ch == 84 {
    return glyph_capT(row);
  }
  if ch == 86 {
    return glyph_capV(row);
  }
  if ch == 87 {
    return glyph_capW(row);
  }
  if ch == 97 {
    return glyph_a(row);
  }
  if ch == 99 {
    return glyph_c(row);
  }
  if ch == 100 {
    return glyph_d(row);
  }
  if ch == 101 {
    return glyph_e(row);
  }
  if ch == 104 {
    return glyph_h(row);
  }
  if ch == 105 {
    return glyph_i(row);
  }
  if ch == 108 {
    return glyph_l(row);
  }
  if ch == 109 {
    return glyph_m(row);
  }
  if ch == 110 {
    return glyph_n(row);
  }
  if ch == 111 {
    return glyph_o(row);
  }
  if ch == 112 {
    return glyph_p(row);
  }
  if ch == 114 {
    return glyph_r(row);
  }
  if ch == 115 {
    return glyph_s(row);
  }
  if ch == 116 {
    return glyph_t(row);
  }
  if ch == 117 {
    return glyph_u(row);
  }
  if ch == 119 {
    return glyph_w(row);
  }
  if ch == 48 {
    return glyph_d0(row);
  }
  if ch == 49 {
    return glyph_d1(row);
  }
  if ch == 50 {
    return glyph_d2(row);
  }
  if ch == 51 {
    return glyph_d3(row);
  }
  if ch == 52 {
    return glyph_d4(row);
  }
  if ch == 53 {
    return glyph_d5(row);
  }
  if ch == 54 {
    return glyph_d6(row);
  }
  if ch == 55 {
    return glyph_d7(row);
  }
  if ch == 56 {
    return glyph_d8(row);
  }
  if ch == 57 {
    return glyph_d9(row);
  }
  if ch == 32 {
    return glyph_space(row);
  }
  if ch == 58 {
    return glyph_colon(row);
  }
  if ch == 46 {
    return glyph_dot(row);
  }
  if ch == 45 {
    return glyph_minus(row);
  }
  if ch == 47 {
    return glyph_slash(row);
  }
  if ch == 40 {
    return glyph_lparen(row);
  }
  if ch == 41 {
    return glyph_rparen(row);
  }
  return 0;
}
// macOS-look desktop, static shot (SOC2-only, 640x480).
// Palette indices: 0 black, 1 white, 2 light gray (menu
// bar, title bars), 3 dark gray (dock), 4 red, 5 yellow,
// 6 green, 7 deep blue, 8 mid blue, 9 light blue.
// The clock reads 21:22 as a STATIC mock in this shot —
// a live ticking clock comes with the event loop, where
// its value is time-dependent and can't be checked
// exactly. No pointer interaction yet either: this is
// the desktop as a picture; dragging, focus, and clicks
// are the next slice. Build with --stack-top 0x800F0000.
// UART transcript is MAC / DONE; the screen is the output.

fn put(c: int) {
  poke32(268435456, c);
}

fn pix_set(x: int, y: int, color: int) {
  let idx = y * 640 + x;
  let widx = idx / 4;
  let addr = 268566528 + widx * 4;
  let mut word = peek32(addr);
  let shift = (idx % 4) * 8;
  let mask = 255 << shift;
  word = (word & ~mask) | (color << shift);
  poke32(addr, word);
}

fn pix_hline(x0: int, x1: int, y: int, color: int) {
  let mut x = x0;
  while x <= x1 {
    pix_set(x, y, color);
    x = x + 1;
  }
}

fn pix_vline(x: int, y0: int, y1: int, color: int) {
  let mut y = y0;
  while y <= y1 {
    pix_set(x, y, color);
    y = y + 1;
  }
}

fn pix_fill_rect(x: int, y: int, w: int, h: int, color: int) {
  let cword = color | (color << 8) | (color << 16) | (color << 24);
  let mut r = y;
  while r < y + h {
    let mut xx = x;
    while xx < x + w {
      if xx % 4 == 0 {
        let mut addr = 268566528 + ((r * 640 + xx) / 4) * 4;
        while xx + 3 < x + w {
          poke32(addr, cword);
          addr = addr + 4;
          xx = xx + 4;
        }
        if xx < x + w {
          pix_set(xx, r, color);
          xx = xx + 1;
        }
      } else {
        pix_set(xx, r, color);
        xx = xx + 1;
      }
    }
    r = r + 1;
  }
}

fn mac_draw_char(x: int, y: int, ch: int, ink: int, paper: int) {
  let mut row = 0;
  let mut bits = 0;
  while row < 8 {
    bits = mac_font_row(ch, row);
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, ink);
      } else {
        pix_set(x + col, y + row, paper);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn draw_circle8(x: int, y: int, color: int) {
  let mut row = 0;
  while row < 8 {
    let mut bits = 0;
    if row == 0 {
      bits = 60;
    }
    if row == 1 {
      bits = 126;
    }
    if row == 2 {
      bits = 255;
    }
    if row == 3 {
      bits = 255;
    }
    if row == 4 {
      bits = 255;
    }
    if row == 5 {
      bits = 255;
    }
    if row == 6 {
      bits = 126;
    }
    if row == 7 {
      bits = 60;
    }
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, color);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn mac_window(x: int, y: int, w: int, h: int, body: int) {
  pix_fill_rect(x + 1, y + 17, w - 2, h - 18, body);
  pix_fill_rect(x + 1, y + 1, w - 2, 15, 2);
  pix_hline(x, x + w - 1, y, 0);
  pix_hline(x, x + w - 1, y + h - 1, 0);
  pix_vline(x, y, y + h - 1, 0);
  pix_vline(x + w - 1, y, y + h - 1, 0);
  draw_circle8(x + 6, y + 4, 4);
  draw_circle8(x + 18, y + 4, 5);
  draw_circle8(x + 30, y + 4, 6);
}

fn main() {
  pix_fill_rect(0, 0, 640, 160, 9);
  pix_fill_rect(0, 160, 640, 160, 8);
  pix_fill_rect(0, 320, 640, 160, 7);
  pix_fill_rect(0, 0, 640, 16, 2);
  mac_draw_char(8, 4, 70, 0, 2);
  mac_draw_char(16, 4, 105, 0, 2);
  mac_draw_char(24, 4, 110, 0, 2);
  mac_draw_char(32, 4, 100, 0, 2);
  mac_draw_char(40, 4, 101, 0, 2);
