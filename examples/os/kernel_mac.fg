  mac_draw_char(408, 456, 84, 0, 2);
  mac_window(80, 60, 320, 240, 1);
  mac_draw_char(124, 64, 70, 0, 2);
  mac_draw_char(132, 64, 105, 0, 2);
  mac_draw_char(140, 64, 110, 0, 2);
