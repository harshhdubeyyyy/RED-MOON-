// System monitor kernel (Phase F, fake-but-computed stats).
//
// A monitor that computes percentages from raw counters in
// RAM scratch: CPU busy 370 of 1000 ticks (37%), memory used
// 640 of 1024 words (62%), 3 of 8 tasks running. The memory
// percentage is stored at 0x8000.
//
// Expected model UART transcript:
//   KERN\nCPU 37\nMEM 62\nTASK 3\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 10 {
    put(48 + v / 10);
  }
  put(48 + v % 10);
}

fn main() {
  let cpu = 370 * 100 / 1000;
  let mem = 640 * 100 / 1024;
  poke32(32768, mem);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  put(67);
  put(80);
  put(85);
  put(32);
  put_num(cpu);
  put(10);
  put(77);
  put(69);
  put(77);
  put(32);
  put_num(mem);
  put(10);
  put(84);
  put(65);
  put(83);
  put(75);
  put(32);
  put_num(3);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
