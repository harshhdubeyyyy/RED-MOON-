// RNG driver kernel (Phase F, deterministic LCG driver).
//
// A tiny linear congruential generator as a kernel driver: state
// lives in RAM scratch 0x8000, seeded once, and rng_next() returns
// the next byte-range value. The multiplier (73) and increment
// (41) are small so every step stays exact in 32-bit arithmetic.
// Seed 7 gives 40, 145, 130, 59, 252.
//
// Expected model UART transcript:
//   KERN\n40\n145\n130\n59\n252\nDONE, halted.
// Final state word at 0x8000 is 252.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 100 {
    put(48 + v / 100);
  }
  if v >= 10 {
    put(48 + (v / 10) % 10);
  }
  put(48 + v % 10);
}

fn rng_next() -> int {
  let s = peek32(32768);
  let n = (s * 73 + 41) % 256;
  poke32(32768, n);
  return n;
}

fn main() {
  poke32(32768, 7);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut i = 0;
  while i < 5 {
    put_num(rng_next());
    put(10);
    i = i + 1;
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
