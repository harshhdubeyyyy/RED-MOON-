// Phase F checkpoint 2: free-list allocator kernel on big32.
//
// Checkpoint 1 could only bump-allocate; freed memory was lost.
// This kernel adds a real free-list: every block carries an
// 8-byte header [next, total_size] before its payload, and freed
// blocks live in an address-ordered singly linked list.
//
// alloc(size): align the payload size up to 4, add the 8-byte
// header, first-fit search the free list; split the block when
// the remainder is at least 16 bytes (header + 8 payload), else
// take it whole; fall back to bump allocation when nothing fits;
// fail with 0 - 1 past the heap end. free(ptr): read the header
// at ptr - 8, insert address-ordered, coalesce with the next
// physical neighbour first, then with the previous one.
//
// Layout: heap [0xA000, 0xC000); bump pointer in scratch 0x8040,
// free-list head in scratch 0x8044 (0 = empty). Header offsets
// are raw address arithmetic — no pointers exist in the language,
// addresses are plain ints.
//
// Demo: alloc a, b, c; free b; alloc d (must reuse b's exact
// block: d == b); verify d's pattern; free a, c, d (adjacent —
// must coalesce into one block); alloc 48 (must succeed from
// the coalesced space); verify its pattern; DONE and halt.
// Failures print E instead of K, so the transcript stays honest.
//
// Expected model UART transcript: KERNKKKKDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn alloc(size: int) -> int {
  let mut need = (size + 3) & ~3;
  need = need + 8;
  let mut prev = 0;
  let mut cur = peek32(32836);
  while cur != 0 {
    let bsize = peek32(cur + 4);
    if bsize >= need {
      let rem = bsize - need;
      if rem >= 16 {
        let nb = cur + need;
        poke32(nb, peek32(cur));
        poke32(nb + 4, rem);
        if prev == 0 {
          poke32(32836, nb);
        } else {
          poke32(prev, nb);
        }
      } else {
        if prev == 0 {
          poke32(32836, peek32(cur));
        } else {
          poke32(prev, peek32(cur));
        }
      }
      return cur + 8;
    }
    prev = cur;
    cur = peek32(cur);
  }
  let p = peek32(32832);
  let a = (p + 3) & ~3;
  if a + need > 49152 {
    return 0 - 1;
  }
  poke32(a, 0);
  poke32(a + 4, need);
  poke32(32832, a + need);
  return a + 8;
}

fn free(ptr: int) {
  let hdr = ptr - 8;
  let mut hsize = peek32(hdr + 4);
  let mut prev = 0;
  let mut cur = peek32(32836);
  while cur != 0 {
    if cur > hdr {
      break;
    }
    prev = cur;
    cur = peek32(cur);
  }
  poke32(hdr, cur);
  if prev == 0 {
    poke32(32836, hdr);
  } else {
    poke32(prev, hdr);
  }
  if cur != 0 {
    if hdr + hsize == cur {
      poke32(hdr + 4, hsize + peek32(cur + 4));
      poke32(hdr, peek32(cur));
      hsize = peek32(hdr + 4);
    }
  }
  if prev != 0 {
    if prev + peek32(prev + 4) == hdr {
      poke32(prev + 4, peek32(prev + 4) + hsize);
      poke32(prev, peek32(hdr));
    }
  }
}

fn main() {
  poke32(32832, 40960);
  poke32(32836, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  let a = alloc(16);
  let b = alloc(16);
  let c = alloc(16);
  free(b);
  let d = alloc(16);
  if d == b {
    put(75);
  } else {
    put(69);
  }
  poke32(d, 123);
  if peek32(d) == 123 {
    put(75);
  } else {
    put(69);
  }
  free(a);
  free(c);
  free(d);
  let e = alloc(48);
  if e != 0 - 1 {
    put(75);
  } else {
    put(69);
  }
  poke32(e, 99);
  if peek32(e) == 99 {
    put(75);
  } else {
    put(69);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
