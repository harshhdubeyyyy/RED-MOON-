// Clock app kernel (Phase F, timer-tick counting).
//
// Tick kernel (kernel_tick) printed one T per timer interrupt.
// This kernel is the clock app built on the same mechanism: the
// trap handler bumps the tick count at 32768 and prints the new
// count as a digit, so the UART output reads as a running clock
// (1, 2, 3, 4, 5) instead of undifferentiated ticks. main arms
// the timer, spins until 5 ticks, prints DONE, and returns.
// Timer interrupts here are the Python model's Phase E CLINT;
// the Verilog has no CLINT yet, so this is model-verified only
// for the interrupt path, like kernel_tick itself.
//
// Expected model UART transcript: KERN12345DONE, halted.
// Final tick count word is 5.

fn put(c: int) {
  poke32(268435456, c);
}

fn trap_handler() {
  let n = peek32(32768);
  poke32(32768, n + 1);
  poke32(268435456, 48 + n + 1);
  let now = peek32(268435472);
  poke32(268435480, now + 1000);
}

fn main() {
  poke32(32768, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  let now = peek32(268435472);
  poke32(268435480, now + 1000);
  csr_set(772, 128);
  csr_set(768, 8);
  while peek32(32768) < 5 {
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
