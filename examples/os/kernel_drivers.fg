// Phase F checkpoint 8: drivers — UART + timer drivers.
//
// A driver is the layer between kernel code and hardware
// registers: all MMIO goes through these functions, never raw
// addresses in task code. The UART driver is thin (this UART
// has no configuration registers): putc/getc over TX/RX. The
// timer driver is the real work: it programs mtimecmp, enables
// timer interrupts, and implements sleep() — a task that
// blocks until its wake time, woken by the timer interrupt,
// not by spinning.
//
// Hardware facts (model; the Verilog has no CLINT yet, so the
// timer half is model-only, like Phase E):
//   UART TX 0x10000000, RX 0x10000004 (-1 when empty).
//   mtime 0x10000010, mtimecmp 0x10000018, both 32-bit.
//   Delivery needs mtvec != 0 + mstatus.MIE (bit 3) +
//   mie.MTIE (bit 7). Tick period: 1000 model steps.
//   Interrupts resume at mepc (NO +4); ecalls resume at
//   mepc + 4. Mixing those up is the classic bug here.
//
// Process table in scratch 0x8000, 4 slots x 16 bytes:
//   [state, frame, mepc, exit_code-or-wake_tick]
// states: 0 free, 1 ready, 2 running, 3 done, 4 sleeping.
// The +12 field doubles as wake_tick while sleeping (a task
// is never both done and sleeping). Scratch: 0x8040 current
// pid, 0x8044/0x8048 child pids, 0x804C tick count.
// Syscalls: 2 spawn, 3 yield, 4 exit (checkpoint 5),
//   5 sleep(ticks).
//
// Known limitation, stated plainly: there is no idle task
// yet, so sleep() with no other ready task degrades to an
// immediate resume instead of blocking. The demo never hits
// it: main never sleeps, so a ready task always exists.
//
// Demo: main spawns A (sleeps 6 ticks, prints A) and B
// (sleeps 1 tick, prints B), then waits for both. B's wake
// time is strictly before A's: the gap between the two sleeps
// is ~1900 steps of spawn + tick-handler overhead (measured
// 27 Oct 2026 — the first version used 3 vs 1 ticks and the
// two wake times landed in the same tick interval, so the
// wake scan's slot order decided it and A printed first).
// Sleep differences must exceed scheduling jitter; 6 vs 1
// ticks gives a ~3000-step margin. Expected model UART
// transcript: KERNBADONE, halted.

fn uart_putc(c: int) {
  poke32(268435456, c);
}

fn uart_getc() -> int {
  return peek32(268435460);
}

fn timer_now() -> int {
  return peek32(268435472);
}

fn timer_set_cmp(v: int) {
  poke32(268435480, v);
}

fn timer_enable() {
  csr_set(768, 8);
  csr_set(772, 128);
}

fn task_sleep(ticks: int) {
  let x = ecall(5, ticks);
}

fn do_exit(code: int) {
  let x = ecall(4, code);
}

fn body_a() {
  task_sleep(6);
  uart_putc(65);
}

fn body_b() {
  task_sleep(1);
  uart_putc(66);
}

fn next_ready(cur: int) -> int {
  let mut s = cur + 1;
  while s < 4 {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  s = 0;
  while s < cur {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn switch_to(nxt: int) {
  let nbase = 32768 + nxt * 16;
  poke32(nbase, 2);
  csr_write(833, peek32(nbase + 8));
  csr_write(832, peek32(nbase + 4));
  poke32(32832, nxt);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    poke32(32844, peek32(32844) + 1);
    timer_set_cmp(timer_now() + 1000);
    let mut s = 0;
    while s < 4 {
      let base = 32768 + s * 16;
      if peek32(base) == 4 {
        if peek32(base + 12) <= timer_now() {
          poke32(base, 1);
        }
      }
      s = s + 1;
    }
    let cur = peek32(32832);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      return;
    }
    let curbase = 32768 + cur * 16;
    poke32(curbase + 4, frame);
    poke32(curbase + 8, csr_read(833));
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  let cur = peek32(32832);
  let curbase = 32768 + cur * 16;
  poke32(curbase + 4, frame);
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  if eid == 2 {
    let mut s = 1;
    let mut slot = 0 - 1;
    while s < 4 {
      if peek32(32768 + s * 16) == 0 {
        slot = s;
        break;
      }
      s = s + 1;
    }
    if slot == 0 - 1 {
      poke32(frame + 32, 0 - 1);
      csr_write(833, ret);
      return;
    }
    let top = 57344 - (slot - 1) * 8192;
    let dst = top - 120;
    let mut i = 0;
    while i < 30 {
      poke32(dst + i * 4, peek32(frame + i * 4));
      i = i + 1;
    }
    poke32(frame + 32, slot);
    poke32(dst + 32, 0);
    let sbase = 32768 + slot * 16;
    poke32(sbase, 1);
    poke32(sbase + 4, dst);
    poke32(sbase + 8, ret);
    poke32(sbase + 12, 0);
    csr_write(833, ret);
    return;
  }
  if eid == 3 {
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  if eid == 4 {
    poke32(curbase, 3);
    poke32(curbase + 12, peek32(frame + 32));
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(773, 0);
      let h = ecall(0, 0);
      return;
    }
    switch_to(nxt);
    return;
  }
  if eid == 5 {
    let ticks = peek32(frame + 32);
    poke32(curbase + 12, timer_now() + ticks * 1000);
    poke32(curbase, 4);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      poke32(curbase, 2);
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    switch_to(nxt);
    return;
  }
  csr_write(833, ret);
}

fn main() {
  poke32(32768, 2);
  poke32(32772, 0);
  poke32(32776, 0);
  poke32(32780, 0);
  let mut s = 1;
  while s < 4 {
    poke32(32768 + s * 16, 0);
    s = s + 1;
  }
  poke32(32832, 0);
  poke32(32836, 0 - 1);
  poke32(32840, 0 - 1);
  poke32(32844, 0);
  uart_putc(75);
  uart_putc(69);
  uart_putc(82);
  uart_putc(78);
  timer_set_cmp(1000);
  timer_enable();
  let a = ecall(2, 0);
  if a == 0 {
    body_a();
    do_exit(0);
  }
  if a > 0 {
    poke32(32836, a);
  }
  let b = ecall(2, 0);
  if b == 0 {
    body_b();
    do_exit(0);
  }
  if b > 0 {
    poke32(32840, b);
  }
  let pa = peek32(32836);
  while peek32(32768 + pa * 16) != 3 {
    let y1 = ecall(3, 0);
  }
  let pb = peek32(32840);
  while peek32(32768 + pb * 16) != 3 {
    let y2 = ecall(3, 0);
  }
  uart_putc(68);
  uart_putc(79);
  uart_putc(78);
  uart_putc(69);
}
