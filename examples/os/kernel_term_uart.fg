// Terminal command core over UART (Terminal in a window, step 1).
//
// The SOC2 window draw is still pending (the 28 Oct TB failed on
// draw pixels while the prompt/clock passed), so this kernel
// verifies the part the model CAN check: the terminal's line
// discipline over real UART RX — prompt, echo, backspace, and
// first-character dispatch. Commands: h = help, f = list the
// three boot files, c = clear marker, q = quit. Anything else
// prints ?. Backspace erases the buffered command character and
// echoes backspace-space-backspace. No VRAM is touched here, so
// this is the command core, not the window — stated, not hidden.
//
// Demo input (fed by the test): h, then h+backspace+f, then c,
// then x (unknown), then q. Expected model UART transcript:
//   KERN\n> h\nh f c q\n> h\x08 \x08f\nFILE 1\nFILE 2\nFILE 3\n
//   > c\n[CLR]\n> x\n?\n> q\nBYE\n, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_str_help() {
  put(104);
  put(32);
  put(102);
  put(32);
  put(99);
  put(32);
  put(113);
  put(10);
}

fn put_files() {
  put(70);
  put(73);
  put(76);
  put(69);
  put(32);
  put(49);
  put(10);
  put(70);
  put(73);
  put(76);
  put(69);
  put(32);
  put(50);
  put(10);
  put(70);
  put(73);
  put(76);
  put(69);
  put(32);
  put(51);
  put(10);
}

fn main() {
  poke32(32832, 0 - 1);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut running = 1;
  while running == 1 {
    put(62);
    put(32);
    let mut done_line = 0;
    while done_line == 0 {
      let c = peek32(268435460);
      if c != 0 - 1 {
        if c == 10 {
          put(10);
          let cmd = peek32(32832);
          poke32(32832, 0 - 1);
          if cmd == 104 {
            put_str_help();
          } else if cmd == 102 {
            put_files();
          } else if cmd == 99 {
            put(91);
            put(67);
            put(76);
            put(82);
            put(93);
            put(10);
          } else if cmd == 113 {
            put(66);
            put(89);
            put(69);
            put(10);
            running = 0;
          } else {
            put(63);
            put(10);
          }
          done_line = 1;
        } else if c == 8 {
          if peek32(32832) != 0 - 1 {
            poke32(32832, 0 - 1);
            put(8);
            put(32);
            put(8);
          }
        } else {
          if peek32(32832) == 0 - 1 {
            poke32(32832, c);
          }
          put(c);
        }
      }
    }
  }
}
