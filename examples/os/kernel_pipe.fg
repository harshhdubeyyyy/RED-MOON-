// Pipe IPC kernel (Phase F, byte-stream pipe).
//
// Distinct from kernel_ipc (a message queue): this is a
// byte pipe — an 8-byte ring at 0x9000 with head at 0x8000,
// tail at 0x8004, count at 0x8008. pipe_write stores a byte,
// pipe_read returns the next byte or -1 when empty. The
// demo writes HELLO, reads it back, then shows that a read
// on the drained pipe returns empty.
//
// Expected model UART transcript:
//   KERN\nHELLO\nEMPTY\nDONE, halted.
// Final pipe count word at 0x8008 is 0.

fn put(c: int) {
  poke32(268435456, c);
}

fn pipe_write(v: int) {
  let tail = peek32(32772);
  poke32(36864 + tail * 4, v);
  poke32(32772, (tail + 1) % 8);
  poke32(32776, peek32(32776) + 1);
}

fn pipe_read() -> int {
  if peek32(32776) == 0 {
    return 0 - 1;
  }
  let head = peek32(32768);
  let v = peek32(36864 + head * 4);
  poke32(32768, (head + 1) % 8);
  poke32(32776, peek32(32776) - 1);
  return v;
}

fn main() {
  poke32(32768, 0);
  poke32(32772, 0);
  poke32(32776, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  pipe_write(72);
  pipe_write(69);
  pipe_write(76);
  pipe_write(76);
  pipe_write(79);
  let mut i = 0;
  while i < 5 {
    put(pipe_read());
    i = i + 1;
  }
  put(10);
  if pipe_read() == 0 - 1 {
    put(69);
    put(77);
    put(80);
    put(84);
    put(89);
    put(10);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
