// Text editor app kernel (Phase F, in-memory buffer editing).
//
// A minimal editor: the buffer lives in RAM at 0x9000 (one
// word per character), its length at 0x8000. The demo script
// types HELLO, presses backspace once (dropping the O), then
// types !, and prints the buffer — HELL!
//
// Expected model UART transcript:
//   KERN\nHELL!\nDONE, halted.
// Final length word at 0x8000 is 5.

fn put(c: int) {
  poke32(268435456, c);
}

fn ed_insert(c: int) {
  let n = peek32(32768);
  poke32(36864 + n * 4, c);
  poke32(32768, n + 1);
}

fn ed_backspace() {
  let n = peek32(32768);
  if n > 0 {
    poke32(32768, n - 1);
  }
}

fn main() {
  poke32(32768, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  ed_insert(72);
  ed_insert(69);
  ed_insert(76);
  ed_insert(76);
  ed_insert(79);
  ed_backspace();
  ed_insert(33);
  let mut i = 0;
  while i < peek32(32768) {
    put(peek32(36864 + i * 4));
    i = i + 1;
  }
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
