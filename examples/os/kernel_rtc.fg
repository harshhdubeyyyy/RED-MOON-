// RTC clock app kernel (Phase F, seconds-to-time conversion).
//
// Distinct from kernel_clock (which counts timer interrupts):
// this is the RTC app, converting a seconds-since-midnight
// counter in RAM scratch 0x8000 into HH:MM:SS. It starts at
// 3661 s (01:01:01), prints the time, advances by exactly
// 3661 s, and prints again (02:02:02).
//
// Expected model UART transcript:
//   KERN\n01:01:01\n02:02:02\nDONE, halted.
// Final seconds word at 0x8000 is 7322.

fn put(c: int) {
  poke32(268435456, c);
}

fn put2d(v: int) {
  put(48 + v / 10);
  put(48 + v % 10);
}

fn print_time() {
  let sec = peek32(32768);
  put2d(sec / 3600);
  put(58);
  put2d((sec % 3600) / 60);
  put(58);
  put2d(sec % 60);
  put(10);
}

fn main() {
  poke32(32768, 3661);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  print_time();
  poke32(32768, peek32(32768) + 3661);
  print_time();
  put(68);
  put(79);
  put(78);
  put(69);
}
