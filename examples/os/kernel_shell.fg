// Phase F checkpoint 6: shell — a REPL over UART.
//
// Reads lines from UART RX (0x10000004, polled; -1 means empty)
// and dispatches on the first character, echoing input the way a
// real terminal shell does. Commands (single characters, because
// freestanding rejects string values, so there are no command
// names to compare):
//   h = help (prints the command list)
//   p = procs (prints every slot as P<id>:<state>)
//   s = spawn the demo task (prints H, yields, prints I, exits)
//   w = wait for the last spawned task, then print W<exit code>
//   q = quit (prints BYE and halts; live children are abandoned)
//   anything else = ? (unknown command)
// Lines are newline-terminated. The shell yields while waiting
// for input and once per iteration, so spawned tasks genuinely
// run between keystrokes — that is the cooperative system's
// answer to blocking input. Process machinery (table, spawn,
// yield, exit) is checkpoint 5's, reused unchanged.
//
// Demo input (fed by the test through the model's new
// input_bytes queue — the model previously had no RX input at
// all, so this checkpoint extends the model, not the language):
//   h, x, s, w, p, q — one command per line.
// Expected model UART transcript:
//   KERN
//   > h
//   h p s w q
//   > x
//   ?
//   > s
//   H> w
//   IW0
//   > p
//   P0:2 P1:3 P2:0 P3:0 (trailing space: the loop prints a space
//   after every slot, including the last)
//   > q
//   BYE
// halted. The H and I land between prompts because the shell
// yields; the p output proves the child went ready -> done.

fn put(c: int) {
  poke32(268435456, c);
}

fn demo_task() {
  put(72);
  let y = ecall(3, 0);
  put(73);
}

fn do_exit(code: int) {
  let x = ecall(4, code);
}

fn next_ready(cur: int) -> int {
  let mut s = cur + 1;
  while s < 4 {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  s = 0;
  while s < cur {
    if peek32(32768 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    return;
  }
  let cur = peek32(32832);
  let curbase = 32768 + cur * 16;
  poke32(curbase + 4, frame);
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  if eid == 2 {
    let mut s = 1;
    let mut slot = 0 - 1;
    while s < 4 {
      if peek32(32768 + s * 16) == 0 {
        slot = s;
        break;
      }
      s = s + 1;
    }
    if slot == 0 - 1 {
      poke32(frame + 32, 0 - 1);
      csr_write(833, ret);
      return;
    }
    let top = 57344 - (slot - 1) * 8192;
    let dst = top - 120;
    let mut i = 0;
    while i < 30 {
      poke32(dst + i * 4, peek32(frame + i * 4));
      i = i + 1;
    }
    poke32(frame + 32, slot);
    poke32(dst + 32, 0);
    let sbase = 32768 + slot * 16;
    poke32(sbase, 1);
    poke32(sbase + 4, dst);
    poke32(sbase + 8, ret);
    poke32(sbase + 12, 0);
    csr_write(833, ret);
    return;
  }
  if eid == 3 {
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    poke32(curbase, 1);
    let nbase = 32768 + nxt * 16;
    poke32(nbase, 2);
    csr_write(833, peek32(nbase + 8));
    csr_write(832, peek32(nbase + 4));
    poke32(32832, nxt);
    return;
  }
  if eid == 4 {
    poke32(curbase, 3);
    poke32(curbase + 12, peek32(frame + 32));
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(773, 0);
      let h = ecall(0, 0);
      return;
    }
    let nbase = 32768 + nxt * 16;
    poke32(nbase, 2);
    csr_write(833, peek32(nbase + 8));
    csr_write(832, peek32(nbase + 4));
    poke32(32832, nxt);
    return;
  }
  csr_write(833, ret);
}

fn main() {
  poke32(32768, 2);
  poke32(32772, 0);
  poke32(32776, 0);
  poke32(32780, 0);
  let mut s = 0;
  s = 1;
  while s < 4 {
    poke32(32768 + s * 16, 0);
    s = s + 1;
  }
  poke32(32832, 0);
  poke32(32836, 0 - 1);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut y = 0;
  let mut running = 1;
  while running == 1 {
    put(62);
    put(32);
    let mut cmd = 0 - 1;
    while cmd == 0 - 1 {
      let c1 = peek32(268435460);
      if c1 != 0 - 1 {
        cmd = c1;
      } else {
        y = ecall(3, 0);
      }
    }
    put(cmd);
    let mut d = 0;
    while d != 10 {
      let c2 = peek32(268435460);
      if c2 != 0 - 1 {
        d = c2;
        put(c2);
      } else {
        y = ecall(3, 0);
      }
    }
    if cmd == 104 {
      put(104);
      put(32);
      put(112);
      put(32);
      put(115);
      put(32);
      put(119);
      put(32);
      put(113);
      put(10);
    } else if cmd == 112 {
      s = 0;
      while s < 4 {
        put(80);
        put(48 + s);
        put(58);
        put(48 + peek32(32768 + s * 16));
        put(32);
        s = s + 1;
      }
      put(10);
    } else if cmd == 115 {
      let pid = ecall(2, 0);
      if pid == 0 {
        demo_task();
        do_exit(0);
      }
      if pid > 0 {
        poke32(32836, pid);
      }
      if pid == 0 - 1 {
        put(63);
        put(10);
      }
    } else if cmd == 119 {
      let lp = peek32(32836);
      if lp >= 0 {
        while peek32(32768 + lp * 16) != 3 {
          y = ecall(3, 0);
        }
        put(87);
        put(48 + peek32(32768 + lp * 16 + 12));
        put(10);
      } else {
        put(63);
        put(10);
      }
    } else if cmd == 113 {
      put(66);
      put(89);
      put(69);
      put(10);
      running = 0;
    } else {
      put(63);
      put(10);
    }
    y = ecall(3, 0);
  }
}
