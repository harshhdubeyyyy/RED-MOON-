// Filesystem v3: delete + rename (Phase F).
//
// FS v2 (kernel_fs2) could create and list. This kernel adds
// the two mutations a real FS needs: delete (frees the slot)
// and rename (changes the name code in place). The table is
// 4 entries at 36864, 8 bytes each (name code at +0, size at
// +4; name 0 means empty). Names are single characters here
// because freestanding rejects strings — the table mechanics,
// not the naming, are what this kernel verifies.
//
// Demo: create A1, B2, C3; list; delete B; list; rename A to Z;
// list. Expected model UART transcript:
//   KERN\nA1\nB2\nC3\nA1\nC3\nZ1\nC3\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn create_file(code: int, size: int) -> int {
  let mut s = 0;
  while s < 4 {
    if peek32(36864 + s * 8) == 0 {
      poke32(36864 + s * 8, code);
      poke32(36864 + s * 8 + 4, size);
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn delete_file(code: int) -> int {
  let mut s = 0;
  while s < 4 {
    if peek32(36864 + s * 8) == code {
      poke32(36864 + s * 8, 0);
      poke32(36864 + s * 8 + 4, 0);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn rename_file(old_code: int, new_code: int) -> int {
  let mut s = 0;
  while s < 4 {
    if peek32(36864 + s * 8) == old_code {
      poke32(36864 + s * 8, new_code);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn list_files() {
  let mut s = 0;
  while s < 4 {
    let code = peek32(36864 + s * 8);
    if code != 0 {
      put(code);
      put(48 + peek32(36864 + s * 8 + 4));
      put(10);
    }
    s = s + 1;
  }
}

fn main() {
  let mut s = 0;
  while s < 4 {
    poke32(36864 + s * 8, 0);
    poke32(36864 + s * 8 + 4, 0);
    s = s + 1;
  }
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let a = create_file(65, 1);
  let b = create_file(66, 2);
  let c = create_file(67, 3);
  if a >= 0 && b >= 0 && c >= 0 {
    list_files();
  }
  let d = delete_file(66);
  if d == 0 {
    list_files();
  }
  let r = rename_file(65, 90);
  if r == 0 {
    list_files();
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
