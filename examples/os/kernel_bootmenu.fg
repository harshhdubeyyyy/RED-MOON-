// Boot menu kernel (Phase F, menu table + selection).
//
// A boot menu: three entries stored as zero-terminated
// word-per-character strings at 0x9000, 0x9030, 0x9060.
// The demo prints the numbered menu, then boots the entry
// selected in RAM scratch 0x8000 (2 = editor).
//
// Expected model UART transcript:
//   KERN\n1 shell\n2 editor\n3 game\nBOOT editor\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_name(base: int) {
  let mut j = 0;
  while peek32(base + j * 4) != 0 {
    put(peek32(base + j * 4));
    j = j + 1;
  }
}

fn main() {
  poke32(36864, 115);
  poke32(36868, 104);
  poke32(36872, 101);
  poke32(36876, 108);
  poke32(36880, 108);
  poke32(36884, 0);
  poke32(36912, 101);
  poke32(36916, 100);
  poke32(36920, 105);
  poke32(36924, 116);
  poke32(36928, 111);
  poke32(36932, 114);
  poke32(36936, 0);
  poke32(36960, 103);
  poke32(36964, 97);
  poke32(36968, 109);
  poke32(36972, 101);
  poke32(36976, 0);
  poke32(32768, 2);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut i = 0;
  while i < 3 {
    put(48 + i + 1);
    put(32);
    put_name(36864 + i * 48);
    put(10);
    i = i + 1;
  }
  put(66);
  put(79);
  put(79);
  put(84);
  put(32);
  let sel = peek32(32768);
  put_name(36864 + (sel - 1) * 48);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
