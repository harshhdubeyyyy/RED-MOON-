// Network loopback checksum kernel (Phase F).
//
// A packet is 4 payload words at 36864 plus a checksum word at
// 36880 (sum of payload mod 65536). verify() recomputes the sum
// and compares: a loopback packet that survives intact verifies
// OK, and flipping one payload word must flip the verdict to
// BAD. This is the integrity half of a network stack; no real
// wire is involved, and none is claimed.
//
// Demo: fill 10, 20, 30, 40 (sum 100), verify OK, corrupt word
// 2 to 999, verify BAD. Expected model UART transcript:
//   KERN\nOK\nBAD\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn pkt_sum() -> int {
  let mut s = 0;
  let mut i = 0;
  while i < 4 {
    s = s + peek32(36864 + i * 4);
    i = i + 1;
  }
  return s % 65536;
}

fn verify() -> int {
  if pkt_sum() == peek32(36880) {
    return 1;
  }
  return 0;
}

fn main() {
  poke32(36864, 10);
  poke32(36868, 20);
  poke32(36872, 30);
  poke32(36876, 40);
  poke32(36880, pkt_sum());
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  if verify() == 1 {
    put(79);
    put(75);
    put(10);
  }
  poke32(36872, 999);
  if verify() == 0 {
    put(66);
    put(65);
    put(68);
    put(10);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
