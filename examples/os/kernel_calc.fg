// Calculator app kernel (Phase F, OS app logic over UART).
//
// Reads lines of the form <digits><op><digits> over UART RX,
// echoes input like the terminal core, and prints the result:
// + - * / on integers, with a leading '-' for negative results.
// Division by zero prints ? instead of trapping.
//
// Demo input (fed by the test): 12+34, 50-8, 6*7, 20/4.
// Expected model UART transcript:
//   KERN\n> 12+34\n46\n> 50-8\n42\n> 6*7\n42\n> 20/4\n5\nDONE
// , halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  let mut w = v;
  if w < 0 {
    put(45);
    w = 0 - w;
  }
  if w >= 100 {
    put(48 + w / 100);
  }
  if w >= 10 {
    put(48 + (w / 10) % 10);
  }
  put(48 + w % 10);
}

fn main() {
  poke32(32832, 0);
  poke32(32836, 0);
  poke32(32840, 0);
  poke32(32844, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut lines = 0;
  while lines < 4 {
    put(62);
    put(32);
    poke32(32832, 0);
    poke32(32836, 0);
    poke32(32840, 0);
    poke32(32844, 0);
    let mut done_line = 0;
    while done_line == 0 {
      let c = peek32(268435460);
      if c != 0 - 1 {
        if c == 10 {
          put(10);
          let left = peek32(32832);
          let right = peek32(32836);
          let op = peek32(32840);
          if op == 43 {
            put_num(left + right);
          } else if op == 45 {
            put_num(left - right);
          } else if op == 42 {
            put_num(left * right);
          } else if op == 47 {
            if right == 0 {
              put(63);
            } else {
              put_num(left / right);
            }
          }
          put(10);
          done_line = 1;
        } else if c == 43 || c == 45 || c == 42 || c == 47 {
          put(c);
          poke32(32840, c);
          poke32(32844, 1);
        } else {
          put(c);
          let d = c - 48;
          if peek32(32844) == 0 {
            poke32(32832, peek32(32832) * 10 + d);
          } else {
            poke32(32836, peek32(32836) * 10 + d);
          }
        }
      }
    }
    lines = lines + 1;
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
