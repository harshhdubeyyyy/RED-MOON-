  if ch == 84 {
    return glyph_capT(row);
  }
  if ch == 86 {
    return glyph_capV(row);
  }
  if ch == 87 {
    return glyph_capW(row);
  }
  if ch == 97 {
    return glyph_a(row);
  }
  if ch == 99 {
    return glyph_c(row);
  }
  if ch == 100 {
    return glyph_d(row);
  }
  if ch == 101 {
    return glyph_e(row);
  }
  if ch == 104 {
    return glyph_h(row);
  }
  if ch == 105 {
    return glyph_i(row);
  }
  if ch == 108 {
    return glyph_l(row);
  }
  if ch == 109 {
    return glyph_m(row);
  }
  if ch == 110 {
    return glyph_n(row);
  }
  if ch == 111 {
    return glyph_o(row);
  }
  if ch == 112 {
    return glyph_p(row);
  }
  if ch == 114 {
    return glyph_r(row);
  }
  if ch == 115 {
    return glyph_s(row);
  }
  if ch == 116 {
    return glyph_t(row);
  }
  if ch == 117 {
    return glyph_u(row);
  }
  if ch == 119 {
    return glyph_w(row);
  }
  if ch == 48 {
    return glyph_d0(row);
  }
  if ch == 49 {
    return glyph_d1(row);
  }
  if ch == 50 {
    return glyph_d2(row);
  }
  if ch == 51 {
    return glyph_d3(row);
  }
  if ch == 52 {
    return glyph_d4(row);
  }
  if ch == 53 {
    return glyph_d5(row);
  }
  if ch == 54 {
    return glyph_d6(row);
  }
  if ch == 55 {
    return glyph_d7(row);
  }
  if ch == 56 {
    return glyph_d8(row);
  }
  if ch == 57 {
    return glyph_d9(row);
  }
  if ch == 32 {
    return glyph_space(row);
  }
  if ch == 58 {
    return glyph_colon(row);
  }
  if ch == 46 {
    return glyph_dot(row);
  }
  if ch == 45 {
    return glyph_minus(row);
  }
  if ch == 47 {
    return glyph_slash(row);
  }
  if ch == 40 {
    return glyph_lparen(row);
  }
  if ch == 41 {
    return glyph_rparen(row);
  }
  return 0;
}
// macOS-look desktop, INTERACTIVE draft (SOC2-only, 640x480).
// DRAFT ONLY — lives in /tmp until the static push lands; do not push as-is.
// Reuses the static kernel's pix/font/window functions, plus a redraw-based
// desktop: draw_desktop() repaints everything in z-order (focused window last).
// Event loop polls the pointer device (no interrupts): PTR_X 268460032,
// PTR_Y 268460036, PTR_BTN 268460040 (verified by hex round-trip).
// Clock: mtime low word at 268435472, TB clock 10 ns = 100 MHz, so
// seconds = mtime / 100000000. Signed 32-bit low word wraps after ~21 s;
// the TB checks clock format/position only, never its value.
// This kernel NEVER halts (an interactive desktop has no DONE): the TB must
// script the pointer and check pixels without waiting for halt. UART prints
// MAC once after the first draw, for TB sync.
fn put(c: int) {
  poke32(268435456, c);
}

fn pix_set(x: int, y: int, color: int) {
  let idx = y * 640 + x;
  let widx = idx / 4;
  let addr = 268566528 + widx * 4;
  let mut word = peek32(addr);
  let shift = (idx % 4) * 8;
  let mask = 255 << shift;
  word = (word & ~mask) | (color << shift);
  poke32(addr, word);
}

fn pix_hline(x0: int, x1: int, y: int, color: int) {
  let mut x = x0;
  while x <= x1 {
    pix_set(x, y, color);
    x = x + 1;
  }
}

fn pix_vline(x: int, y0: int, y1: int, color: int) {
  let mut y = y0;
  while y <= y1 {
    pix_set(x, y, color);
    y = y + 1;
  }
}

fn pix_fill_rect(x: int, y: int, w: int, h: int, color: int) {
  let cword = color | (color << 8) | (color << 16) | (color << 24);
  let mut r = y;
  while r < y + h {
    let mut xx = x;
    while xx < x + w {
      if xx % 4 == 0 {
        let mut addr = 268566528 + ((r * 640 + xx) / 4) * 4;
        while xx + 3 < x + w {
          poke32(addr, cword);
          addr = addr + 4;
          xx = xx + 4;
        }
        if xx < x + w {
          pix_set(xx, r, color);
          xx = xx + 1;
        }
      } else {
        pix_set(xx, r, color);
        xx = xx + 1;
      }
    }
    r = r + 1;
  }
}

fn mac_draw_char(x: int, y: int, ch: int, ink: int, paper: int) {
  let mut row = 0;
  let mut bits = 0;
  while row < 8 {
    bits = mac_font_row(ch, row);
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, ink);
      } else {
        pix_set(x + col, y + row, paper);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn draw_circle8(x: int, y: int, color: int) {
  let mut row = 0;
  while row < 8 {
    let mut bits = 0;
    if row == 0 {
      bits = 60;
    }
    if row == 1 {
      bits = 126;
    }
    if row == 2 {
      bits = 255;
    }
    if row == 3 {
      bits = 255;
    }
    if row == 4 {
      bits = 255;
    }
    if row == 5 {
      bits = 255;
    }
    if row == 6 {
      bits = 126;
    }
    if row == 7 {
      bits = 60;
    }
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, color);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn mac_window(x: int, y: int, w: int, h: int, body: int) {
  pix_fill_rect(x + 1, y + 17, w - 2, h - 18, body);
  pix_fill_rect(x + 1, y + 1, w - 2, 15, 2);
  pix_hline(x, x + w - 1, y, 0);
  pix_hline(x, x + w - 1, y + h - 1, 0);
  pix_vline(x, y, y + h - 1, 0);
  pix_vline(x + w - 1, y, y + h - 1, 0);
  draw_circle8(x + 6, y + 4, 4);
  draw_circle8(x + 18, y + 4, 5);
  draw_circle8(x + 30, y + 4, 6);
}

fn draw_finder_window(x: int, y: int) {
  mac_window(x, y, 320, 240, 1);
  mac_draw_char(x + 44, y + 4, 70, 0, 2);
  mac_draw_char(x + 52, y + 4, 105, 0, 2);
  mac_draw_char(x + 60, y + 4, 110, 0, 2);
  mac_draw_char(x + 68, y + 4, 100, 0, 2);
  mac_draw_char(x + 76, y + 4, 101, 0, 2);
  mac_draw_char(x + 84, y + 4, 114, 0, 2);
}

fn draw_term_window(x: int, y: int) {
  mac_window(x, y, 320, 240, 0);
  mac_draw_char(x + 44, y + 4, 84, 0, 2);
  mac_draw_char(x + 52, y + 4, 101, 0, 2);
  mac_draw_char(x + 60, y + 4, 114, 0, 2);
  mac_draw_char(x + 68, y + 4, 109, 0, 2);
  mac_draw_char(x + 76, y + 4, 105, 0, 2);
  mac_draw_char(x + 84, y + 4, 110, 0, 2);
  mac_draw_char(x + 92, y + 4, 97, 0, 2);
  mac_draw_char(x + 100, y + 4, 108, 0, 2);
  mac_draw_char(x + 16, y + 24, 75, 1, 0);
  mac_draw_char(x + 24, y + 24, 69, 1, 0);
  mac_draw_char(x + 32, y + 24, 82, 1, 0);
  mac_draw_char(x + 40, y + 24, 78, 1, 0);
}


fn hit_window(px: int, py: int, x: int, y: int, closed: int) -> int {
  if closed == 1 {
    return 0;
  }
  if px >= x + 6 && px < x + 14 && py >= y + 4 && py < y + 12 {
    return 1;
  }
  if px >= x && px < x + 320 && py >= y && py < y + 16 {
    return 2;
  }
  if px >= x && px < x + 320 && py >= y && py < y + 240 {
    return 3;
  }
  return 0;
}

fn draw_clock(h: int, m: int) {
  mac_draw_char(592, 4, 48 + h / 10, 0, 2);
  mac_draw_char(600, 4, 48 + h % 10, 0, 2);
  mac_draw_char(608, 4, 58, 0, 2);
  mac_draw_char(616, 4, 48 + m / 10, 0, 2);
  mac_draw_char(624, 4, 48 + m % 10, 0, 2);
}

fn draw_desktop(fx: int, fy: int, tx: int, ty: int, state: int, h: int, m: int) {
  let focus = state % 2;
  let fclosed = (state / 2) % 2;
  let tclosed = (state / 4) % 2;
  pix_fill_rect(0, 0, 640, 160, 9);
  pix_fill_rect(0, 160, 640, 160, 8);
  pix_fill_rect(0, 320, 640, 160, 7);
  pix_fill_rect(0, 0, 640, 16, 2);
  mac_draw_char(8, 4, 70, 0, 2);
  mac_draw_char(16, 4, 105, 0, 2);
  mac_draw_char(24, 4, 110, 0, 2);
  mac_draw_char(32, 4, 100, 0, 2);
  mac_draw_char(40, 4, 101, 0, 2);
  mac_draw_char(48, 4, 114, 0, 2);
  mac_draw_char(72, 4, 70, 0, 2);
  mac_draw_char(80, 4, 105, 0, 2);
  mac_draw_char(88, 4, 108, 0, 2);
  mac_draw_char(96, 4, 101, 0, 2);
  mac_draw_char(120, 4, 69, 0, 2);
  mac_draw_char(128, 4, 100, 0, 2);
  mac_draw_char(136, 4, 105, 0, 2);
  mac_draw_char(144, 4, 116, 0, 2);
  mac_draw_char(168, 4, 86, 0, 2);
  mac_draw_char(176, 4, 105, 0, 2);
  mac_draw_char(184, 4, 101, 0, 2);
  mac_draw_char(192, 4, 119, 0, 2);
  mac_draw_char(216, 4, 87, 0, 2);
  mac_draw_char(224, 4, 105, 0, 2);
  mac_draw_char(232, 4, 110, 0, 2);
  mac_draw_char(240, 4, 100, 0, 2);
  mac_draw_char(248, 4, 111, 0, 2);
  mac_draw_char(256, 4, 119, 0, 2);
  mac_draw_char(280, 4, 72, 0, 2);
  mac_draw_char(288, 4, 101, 0, 2);
  mac_draw_char(296, 4, 108, 0, 2);
  mac_draw_char(304, 4, 112, 0, 2);
  draw_clock(h, m);
  pix_fill_rect(196, 440, 248, 40, 3);
  pix_fill_rect(204, 444, 32, 32, 7);
  mac_draw_char(216, 456, 70, 1, 7);
  pix_fill_rect(252, 444, 32, 32, 0);
  mac_draw_char(264, 456, 84, 1, 0);
  pix_fill_rect(300, 444, 32, 32, 1);
  mac_draw_char(312, 456, 78, 0, 1);
  pix_fill_rect(348, 444, 32, 32, 5);
  mac_draw_char(360, 456, 67, 0, 5);
  pix_fill_rect(396, 444, 32, 32, 2);
  mac_draw_char(408, 456, 84, 0, 2);
  if focus == 1 {
    if fclosed == 0 {
      draw_finder_window(fx, fy);
    }
    if tclosed == 0 {
      draw_term_window(tx, ty);
    }
  } else {
    if tclosed == 0 {
      draw_term_window(tx, ty);
    }
    if fclosed == 0 {
      draw_finder_window(fx, fy);
    }
  }
}

fn main() {
  let mut fx = 80;
  let mut fy = 60;
  let mut tx = 200;
  let mut ty = 140;
  let mut focus = 1;
  let mut fclosed = 0;
  let mut tclosed = 0;
  let mut dragging = 0;
  let mut drag_win = 0;
  let mut grab_dx = 0;
  let mut grab_dy = 0;
  let mut prev_btn = 0;
  let mut px = 0;
  let mut py = 0;
  let mut btn = 0;
  let mut mt = 0;
  let mut secs = 0;
  let mut hours = 0;
  let mut mins = 0;
  let mut last_min = 0;
  let mut running = 1;
  let mut nx = 0;
  let mut ny = 0;
  let mut act = 0;
  let mut win = 0;
  let mut oldf = 0;
  mt = peek32(268435472);
  secs = mt / 100000000;
  hours = (secs / 3600) % 24;
  mins = (secs / 60) % 60;
  last_min = mins;
  draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4, hours, mins);
  put(77);
  put(65);
  put(67);
  put(10);
  while running == 1 {
    px = peek32(268460032);
    py = peek32(268460036);
    btn = peek32(268460040);
    if btn == 1 && prev_btn == 0 {
      oldf = focus;
      if focus == 1 {
        act = hit_window(px, py, tx, ty, tclosed);
        win = 2;
        if act == 0 {
          act = hit_window(px, py, fx, fy, fclosed);
          win = 1;
        }
      } else {
        act = hit_window(px, py, fx, fy, fclosed);
        win = 1;
        if act == 0 {
          act = hit_window(px, py, tx, ty, tclosed);
          win = 2;
        }
      }
      if act == 1 {
        if win == 1 {
          fclosed = 1;
        } else {
          tclosed = 1;
        }
        dragging = 0;
        draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4, hours, mins);
      } else {
        if act == 2 {
          focus = win - 1;
          dragging = 1;
          drag_win = win;
          if win == 1 {
            grab_dx = px - fx;
            grab_dy = py - fy;
          } else {
            grab_dx = px - tx;
            grab_dy = py - ty;
          }
          if focus != oldf {
            draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4, hours, mins);
          }
        } else {
          if act == 3 {
            focus = win - 1;
            if focus != oldf {
              draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4, hours, mins);
            }
          }
        }
      }
    }
    if btn == 1 && prev_btn == 1 && dragging == 1 {
      if drag_win == 1 {
        nx = px - grab_dx;
        ny = py - grab_dy;
        if nx != fx || ny != fy {
          fx = nx;
          fy = ny;
          draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4, hours, mins);
        }
      } else {
        if drag_win == 2 {
          nx = px - grab_dx;
          ny = py - grab_dy;
          if nx != tx || ny != ty {
            tx = nx;
            ty = ny;
            draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4, hours, mins);
          }
        }
      }
    }
    if btn == 0 && prev_btn == 1 {
      dragging = 0;
      drag_win = 0;
    }
    mt = peek32(268435472);
    secs = mt / 100000000;
    hours = (secs / 3600) % 24;
    mins = (secs / 60) % 60;
    if mins != last_min {
      draw_clock(hours, mins);
      last_min = mins;
    }
    prev_btn = btn;
  }
}
