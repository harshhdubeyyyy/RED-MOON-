// IPC message queue kernel (Phase F).
//
// A 4-slot ring at 36864: head at 32832, tail at 32836. One slot
// stays empty so head == tail unambiguously means empty, and
// (tail + 1) % 4 == head means full. send returns -1 when full,
// recv returns -1 when empty; neither blocks.
//
// Demo: send 11, 22, 33; recv all three; send 44, 55, 66, 77
// (77 must fail: only 3 usable slots); recv the three that fit.
// Expected model UART transcript:
//   KERN\nR11\nR22\nR33\nF\nR44\nR55\nR66\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 10 {
    put(48 + v / 10);
  }
  put(48 + v % 10);
}

fn send_msg(v: int) -> int {
  let head = peek32(32832);
  let tail = peek32(32836);
  if (tail + 1) % 4 == head {
    return 0 - 1;
  }
  poke32(36864 + tail * 4, v);
  poke32(32836, (tail + 1) % 4);
  return 0;
}

fn recv_msg() -> int {
  let head = peek32(32832);
  let tail = peek32(32836);
  if head == tail {
    return 0 - 1;
  }
  let v = peek32(36864 + head * 4);
  poke32(32832, (head + 1) % 4);
  return v;
}

fn recv_print() {
  let v = recv_msg();
  put(82);
  put_num(v);
  put(10);
}

fn main() {
  poke32(32832, 0);
  poke32(32836, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let x = send_msg(11);
  let y = send_msg(22);
  let z = send_msg(33);
  if x == 0 && y == 0 && z == 0 {
    recv_print();
    recv_print();
    recv_print();
  }
  let a = send_msg(44);
  let b = send_msg(55);
  let c = send_msg(66);
  let d = send_msg(77);
  if a == 0 && b == 0 && c == 0 && d == 0 - 1 {
    put(70);
    put(10);
  }
  recv_print();
  recv_print();
  recv_print();
  put(68);
  put(79);
  put(78);
  put(69);
}
