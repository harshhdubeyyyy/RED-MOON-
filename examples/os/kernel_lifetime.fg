// Lifetime-ordered allocator kernel (first QAIRT borrow, Phase F).
//
// Two pools, split by lifetime class instead of one bump:
//   short pool [40960, 45056), bump word at 32832 — freed in bulk
//     at epoch end (all short-lived blocks die together);
//   long pool [45056, 49152), bump word at 32836 — survives epochs.
// Freeing short blocks one by one is deliberately NOT offered:
// the epoch reset is the reclaim operation, and claiming a
// per-block short free would hide the design's real trade-off.
//
// Demo: allocate short + long, verify both patterns, reset the
// short epoch, re-allocate short (must reuse the same base),
// verify the long pattern survived. Expected model UART
// transcript: KERNKKKDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn alloc_short(size: int) -> int {
  let p = peek32(32832);
  let a = (p + 3) & ~3;
  if a + size > 45056 {
    return 0 - 1;
  }
  poke32(32832, a + size);
  return a;
}

fn alloc_long(size: int) -> int {
  let p = peek32(32836);
  let a = (p + 3) & ~3;
  if a + size > 49152 {
    return 0 - 1;
  }
  poke32(32836, a + size);
  return a;
}

fn short_epoch() {
  poke32(32832, 40960);
}

fn main() {
  poke32(32832, 40960);
  poke32(32836, 45056);
  put(75);
  put(69);
  put(82);
  put(78);
  let s1 = alloc_short(16);
  poke32(s1, 111);
  let l1 = alloc_long(16);
  poke32(l1, 222);
  if peek32(s1) == 111 {
    if peek32(l1) == 222 {
      put(75);
    }
  }
  short_epoch();
  let s2 = alloc_short(16);
  if s2 == s1 {
    put(75);
  }
  if peek32(l1) == 222 {
    put(75);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
