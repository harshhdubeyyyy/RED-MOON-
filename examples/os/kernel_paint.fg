// Paint / draw app kernel (Phase F, 8x8 framebuffer).
//
// A framebuffer in RAM at 0x9000 (one word per pixel, 8x8).
// The demo draws a border plus a diagonal, counts the filled
// pixels (34, stored at 0x8000), then prints the canvas as
// * / . rows followed by the count.
//
// Expected model UART transcript:
//   KERN\n********\n**.....*\n*.*....*\n*..*...*\n*...*..*\n*....*.*\n*.....**\n********\n34\nDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 10 {
    put(48 + v / 10);
  }
  put(48 + v % 10);
}

fn main() {
  let mut y = 0;
  while y < 8 {
    let mut x = 0;
    while x < 8 {
      let mut on = 0;
      if x == 0 || x == 7 || y == 0 || y == 7 || x == y {
        on = 1;
      }
      poke32(36864 + (y * 8 + x) * 4, on);
      x = x + 1;
    }
    y = y + 1;
  }
  let mut count = 0;
  y = 0;
  while y < 8 {
    let mut x = 0;
    while x < 8 {
      if peek32(36864 + (y * 8 + x) * 4) == 1 {
        count = count + 1;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  poke32(32768, count);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  y = 0;
  while y < 8 {
    let mut x = 0;
    while x < 8 {
      if peek32(36864 + (y * 8 + x) * 4) == 1 {
        put(42);
      } else {
        put(46);
      }
      x = x + 1;
    }
    put(10);
    y = y + 1;
  }
  put_num(count);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
