// Phase E checkpoint 2: preemptive round-robin scheduler on big32.
//
// Two tasks, one timer. main forks via ecall(2, 0): the handler copies
// the 120-byte trap frame onto a fresh stack (top 0xE000), sets the
// child's saved-a0 slot to 0 and the parent's to 1, records the child
// in TCB[1], and advances mepc past the ecall for BOTH (the parent
// resumes after its ecall too — forgetting that re-executes the
// ecall forever). Parent runs task_a, child runs task_b; every timer
// tick the handler saves the current task's frame+mepc into its TCB,
// loads the next task's, and hands the next frame to the stub through
// mscratch (832) — the stub switches stacks before restoring.
//
// Two rules this design forces, stated plainly:
//  * Tasks are helper functions, never code inline in main after the
//    fork: main's locals live in main's frame, which the fork does
//    NOT copy (only the trap frame is copied). The single shared
//    local is the fork result itself, read once per task right after
//    the fork, before any switch can interleave.
//  * Yield (ecall with an unknown id) is NOT a switch yet: the
//    handler advances mepc past it and returns to the same task.
//    Preemptive ticks do all the switching in this checkpoint.
//
// Scheduler state in RAM scratch (freestanding has no globals):
//   0x8000 tick count, 0x8004 ready flag, 0x8008 current task,
//   0x8010/0x8014 TCB[0] frame/mepc, 0x8018/0x801C TCB[1] frame/mepc.
// Trap-frame slots (stub order): a0 at +32, a7 at +60.
//
// Expected model run: transcript starts KERN, then interleaved runs
// of A and B (both tasks print until tick 20, when the handler clears
// mtvec and the next ecall halts), halted, tick count exactly 20.

fn put(c: int) {
  poke32(268435456, c);
}

fn switch_task(frame: int, mepc: int) {
  let cur = peek32(32776);
  if cur == 0 {
    poke32(32816, frame);
    poke32(32820, mepc);
    poke32(32776, 1);
    csr_write(833, peek32(32828));
    csr_write(832, peek32(32824));
  } else {
    poke32(32824, frame);
    poke32(32828, mepc);
    poke32(32776, 0);
    csr_write(833, peek32(32820));
    csr_write(832, peek32(32816));
  }
}

fn fork_task(frame: int) {
  let dst = 57224;
  let mut i = 0;
  while i < 30 {
    poke32(dst + i * 4, peek32(frame + i * 4));
    i = i + 1;
  }
  poke32(frame + 32, 1);
  poke32(dst + 32, 0);
  let ret = csr_read(833) + 4;
  csr_write(833, ret);
  poke32(32824, dst);
  poke32(32828, ret);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    let t = peek32(32768);
    poke32(32768, t + 1);
    let now = peek32(268435472);
    poke32(268435480, now + 1000);
    if t + 1 >= 20 {
      csr_write(773, 0);
    }
    if peek32(32772) == 1 {
      switch_task(frame, csr_read(833));
    }
  } else {
    let eid = peek32(frame + 60);
    if eid == 2 {
      fork_task(frame);
    } else {
      csr_write(833, csr_read(833) + 4);
    }
  }
}

fn task_a() {
  while peek32(32768) < 20 {
    poke32(268435456, 65);
  }
  let _h = ecall(0, 0);
}

fn task_b() {
  while peek32(32768) < 20 {
    poke32(268435456, 66);
  }
  let _h = ecall(0, 0);
}

fn main() {
  poke32(32768, 0);
  poke32(32772, 0);
  poke32(32776, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  let now = peek32(268435472);
  poke32(268435480, now + 1000);
  csr_set(772, 128);
  csr_set(768, 8);
  let f = ecall(2, 0);
  poke32(32772, 1);
  if f == 0 {
    task_b();
  } else {
    task_a();
  }
}
