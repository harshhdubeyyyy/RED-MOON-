// Beep / sound driver kernel (Phase F, note-table driver).
//
// A sound driver over a fake note register: the note table lives
// in RAM at 0x9000 (440, 523, 659, 880 Hz), and beep_play()
// writes each frequency to the current-note register at 0x9010
// with a fixed duration at 0x9014, then the kernel prints the
// frequency it just played. No real audio hardware exists on
// the model; the register writes are the driver contract.
//
// Expected model UART transcript:
//   KERN\n440\n523\n659\n880\nDONE, halted.
// Final current-note word at 0x9010 is 880.

fn put(c: int) {
  poke32(268435456, c);
}

fn put_num(v: int) {
  if v >= 100 {
    put(48 + v / 100);
  }
  if v >= 10 {
    put(48 + (v / 10) % 10);
  }
  put(48 + v % 10);
}

fn beep_play(freq: int) {
  poke32(36880, freq);
  poke32(36884, 200);
}

fn main() {
  poke32(36864, 440);
  poke32(36868, 523);
  poke32(36872, 659);
  poke32(36876, 880);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  let mut i = 0;
  while i < 4 {
    let f = peek32(36864 + i * 4);
    beep_play(f);
    put_num(f);
    put(10);
    i = i + 1;
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
