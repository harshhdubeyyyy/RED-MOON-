// INTEGRATED MEMORY MAP (model addresses; rebase adds
// 0x80000000 for SOC2, MMIO untouched):
//   0x8000 proc table, 4 slots x 16 bytes
//     [state, frame, mepc, exit_code-or-wake_tick]
//   0x8040 current pid, 0x8044 last spawned pid,
//     0x8048 tick count
//   0x8050 allocator bump pointer (heap below)
//   0x8060 FS next bump block, 0x8064 FS free-list head
//   0x8070 FS file table, 8 slots x 16 bytes
//   0x80F0 FS block map, 8 slots x 16 entries
//   0x82F0 net area, unused (loopback positions retired),
//     0x82F4 unused
//   0x82F8 net sent, 0x82FC net recv, 0x8300 net dropped,
//     0x8304 r_dst, 0x8308 r_src, 0x830C r_payload
