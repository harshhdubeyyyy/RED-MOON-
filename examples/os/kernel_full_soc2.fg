  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 2147516528) / 16;
  let b = peek32(2147516656 + slot * 64 + (index / 64) * 4);
  return peek32(2147519488 + b * 256 + (index % 64) * 4);
}

// ---- network stack over the serial device ----
// Scratch remapped onto the unified net area: sent 0x82F8,
// recv 0x82FC, dropped 0x8300, r_dst 0x8304, r_src 0x8308,
// r_payload 0x830C, packet area 0x8310.

fn net_put(c: int) {
  poke32(268447744, c);
}

fn net_get() -> int {
  return peek32(268447748);
}

fn dev_slip_byte(c: int) {
  if c == 192 {
    net_put(219);
    net_put(220);
    return;
  }
  if c == 219 {
    net_put(219);
    net_put(221);
    return;
  }
  net_put(c);
}

fn dev_send(dst: int, src: int, payload: int) {
  net_put(192);
  dev_slip_byte(dst);
  dev_slip_byte(src);
  dev_slip_byte(1);
  dev_slip_byte(payload);
  dev_slip_byte((dst + src + 1 + payload) % 256);
  net_put(192);
  poke32(2147517176, peek32(2147517176) + 1);
}

fn dev_recv_wait() -> int {
  let mut n = 0;
  let mut ok = 1;
  let mut idle = 0;
  while idle < 200000 {
    let c = net_get();
    if c == 0 - 1 {
      idle = idle + 1;
    } else {
      idle = 0;
      if c == 192 {
        if n > 0 {
          if ok == 0 {
            poke32(2147517184, peek32(2147517184) + 1);
            return 0;
          }
          if n != 5 {
            poke32(2147517184, peek32(2147517184) + 1);
            return 0;
          }
          let dst = peek32(2147517200);
          let src = peek32(2147517204);
          let ln = peek32(2147517208);
          let pay = peek32(2147517212);
          let csum = peek32(2147517216);
          if ln != 1 {
            poke32(2147517184, peek32(2147517184) + 1);
            return 0;
          }
          if (dst + src + ln + pay) % 256 != csum {
            poke32(2147517184, peek32(2147517184) + 1);
            return 0;
          }
          poke32(2147517188, dst);
          poke32(2147517192, src);
          poke32(2147517196, pay);
          poke32(2147517180, peek32(2147517180) + 1);
          return 1;
        }
      } else if c == 219 {
        let mut eidle = 0;
        let mut e = 0 - 1;
        while eidle < 200000 {
          e = net_get();
          if e == 0 - 1 {
            eidle = eidle + 1;
          } else {
            break;
          }
        }
        if e == 220 {
          poke32(2147517200 + n * 4, 192);
          n = n + 1;
        } else if e == 221 {
          poke32(2147517200 + n * 4, 219);
          n = n + 1;
        } else {
          ok = 0;
        }
      } else {
        poke32(2147517200 + n * 4, c);
        n = n + 1;
        if n > 16 {
          ok = 0;
        }
      }
    }
  }
  return 0;
}

// ---- ANSI GUI windows (over UART) ----

fn move_to(row: int, col: int) {
  put(27);
  put(91);
  print_num(row);
  put(59);
  print_num(col);
  put(72);
}

fn draw_window(x: int, y: int, w: int, h: int, title: int) {
  move_to(y, x);
  put(43);
  put(title);
  let mut i = 0;
  while i < w - 3 {
    put(45);
    i = i + 1;
  }
  put(43);
  let mut r = y + 1;
  while r < y + h - 1 {
    move_to(r, x);
    put(124);
    let mut j = 0;
    while j < w - 2 {
      put(32);
      j = j + 1;
    }
    put(124);
    r = r + 1;
  }
  move_to(y + h - 1, x);
  put(43);
  let mut k = 0;
  while k < w - 2 {
    put(45);
    k = k + 1;
  }
  put(43);
}

// ---- text VRAM windows ----

fn fb_set_cell(x: int, y: int, ch: int, attr: int) {
  let idx = y * 80 + x;
  let widx = idx / 2;
  let addr = 268451840 + widx * 4;
  let mut word = peek32(addr);
  let cell = ch + attr * 256;
  if idx % 2 == 0 {
    word = (word & (0 - 65536)) | cell;
  } else {
    word = (word & 2147549183) | (cell * 65536);
  }
  poke32(addr, word);
}

fn fb_clear() {
  let mut i = 0;
  while i < 1000 {
    poke32(268451840 + i * 4, 2097184);
    i = i + 1;
  }
}

fn fb_window(x: int, y: int, w: int, h: int, title: int) {
  fb_set_cell(x, y, 43, 0);
  fb_set_cell(x + 1, y, title, 1);
  let mut i = 0;
  while i < w - 3 {
    fb_set_cell(x + 2 + i, y, 45, 0);
    i = i + 1;
  }
  fb_set_cell(x + w - 1, y, 43, 0);
  let mut r = y + 1;
  while r < y + h - 1 {
    fb_set_cell(x, r, 124, 0);
    let mut j = 0;
    while j < w - 2 {
      fb_set_cell(x + 1 + j, r, 32, 0);
      j = j + 1;
    }
    fb_set_cell(x + w - 1, r, 124, 0);
    r = r + 1;
  }
  fb_set_cell(x, y + h - 1, 43, 0);
  let mut k = 0;
  while k < w - 2 {
    fb_set_cell(x + 1 + k, y + h - 1, 45, 0);
    k = k + 1;
  }
  fb_set_cell(x + w - 1, y + h - 1, 43, 0);
}

// ---- pixel screen: pixels, font, windows ----

fn pix_set(x: int, y: int, color: int) {
  let idx = y * 320 + x;
  let widx = idx / 4;
  let addr = 268566528 + widx * 4;
  let mut word = peek32(addr);
  let shift = (idx % 4) * 8;
  let mask = 255 << shift;
  word = (word & ~mask) | (color << shift);
  poke32(addr, word);
}

fn pix_clear(color: int) {
  let word = color | (color << 8) | (color << 16) | (color << 24);
  let mut i = 0;
  while i < 16000 {
    poke32(268566528 + i * 4, word);
    i = i + 1;
  }
}

fn pix_hline(x0: int, x1: int, y: int, color: int) {
  let mut x = x0;
  while x <= x1 {
    pix_set(x, y, color);
    x = x + 1;
  }
}

fn pix_vline(x: int, y0: int, y1: int, color: int) {
  let mut y = y0;
  while y <= y1 {
    pix_set(x, y, color);
    y = y + 1;
  }
}

fn glyph_k(row: int) -> int {
  if row == 0 {
    return 130;
  }
  if row == 1 {
    return 132;
  }
  if row == 2 {
    return 136;
  }
  if row == 3 {
    return 144;
  }
  if row == 4 {
    return 144;
  }
  if row == 5 {
    return 136;
  }
  if row == 6 {
    return 132;
  }
  if row == 7 {
    return 130;
  }
  return 0;
}

