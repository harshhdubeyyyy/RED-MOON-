//   0x8800-0x8C00 FREE (loopback buffer retired)
//   0x8C00-0x9C00 FS data blocks, 16 x 256 bytes
//   stacks: slot1 top 0xE000, slot2 top 0xC000, each 8192
//     apart; main stack top 0xFFFC.
//   MMIO: UART 0x10000000 TX / 0x10000004 RX,
//     timer 0x10000010 / 0x10000018,
//     net device 0x10003000 TX / 0x10003004 RX,
//     text VRAM 0x10004000, pixel VRAM 0x10020000.
// HONEST LIMITS, carried over: only 2 child slots fit;
// no idle task, so the shell never sleeps (sleep stays
// available as a syscall); the pixel palette is indices
// only (0 black, 1 white).
//
// Shell commands (first character of each line):
//   h help, p procs, s spawn demo task, w wait last,
//   m bump-alloc 16 bytes and print the address,
//   f filesystem script (delete/create/write/readback),
//   g ANSI GUI demo windows, n network demo (device
//     exchange), t text-VRAM windows, v pixel windows,
//   q quit, anything else ?.

fn put(c: int) {
  poke32(268435456, c);
}

fn print_num(n: int) {
  let mut div = 1;
  while div <= n / 10 {
    div = div * 10;
  }
  while div >= 1 {
    put(48 + (n / div) % 10);
    div = div / 10;
  }
}

fn print_hex(n: int) {
  let mut started = 0;
  let mut shift = 28;
  while shift >= 0 {
    let d = (n >> shift) & 15;
    if d != 0 {
      started = 1;
    }
    if started == 1 {
      if d < 10 {
        put(48 + d);
      } else {
        put(55 + d);
      }
    }
    shift = shift - 4;
  }
  if started == 0 {
    put(48);
  }
}

