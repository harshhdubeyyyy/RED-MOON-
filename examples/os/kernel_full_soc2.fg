fn fs_find(id: int) -> int {
  let mut s = 0;
  while s < 8 {
    let base = 2147516528 + s * 16;
    if peek32(base + 4) == 1 {
      if peek32(base) == id {
        return base;
      }
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_format() {
  let mut s = 0;
  while s < 8 {
    let base = 2147516528 + s * 16;
    poke32(base, 0);
    poke32(base + 4, 0);
    poke32(base + 8, 0);
    poke32(base + 12, 0);
    s = s + 1;
  }
  let mut m = 0;
  while m < 128 {
    poke32(2147516656 + m * 4, 0 - 1);
    m = m + 1;
  }
  poke32(2147516504, 0);
  poke32(2147516508, 0 - 1);
}

fn fs_alloc_block() -> int {
  let head = peek32(2147516508);
  if head != 0 - 1 {
    poke32(2147516508, peek32(2147519488 + head * 256));
    return head;
  }
  let bump = peek32(2147516504);
  if bump >= 16 {
    return 0 - 1;
  }
  poke32(2147516504, bump + 1);
  return bump;
}

fn fs_free_block(b: int) {
  poke32(2147519488 + b * 256, peek32(2147516508));
  poke32(2147516508, b);
}

fn fs_create(id: int, nwords: int) -> int {
  if fs_find(id) != 0 - 1 {
    return 0 - 1;
  }
  let mut s = 0;
  while s < 8 {
    let base = 2147516528 + s * 16;
    if peek32(base + 4) == 0 {
      let need = (nwords + 63) / 64;
      let map = 2147516656 + s * 64;
      let mut k = 0;
      while k < need {
        let b = fs_alloc_block();
        if b == 0 - 1 {
          let mut j = 0;
          while j < k {
            fs_free_block(peek32(map + j * 4));
            j = j + 1;
          }
          return 0 - 1;
        }
        poke32(map + k * 4, b);
        k = k + 1;
      }
      while k < 16 {
        poke32(map + k * 4, 0 - 1);
        k = k + 1;
      }
      poke32(base, id);
      poke32(base + 4, 1);
      poke32(base + 8, nwords);
      poke32(base + 12, 0);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_delete(id: int) -> int {
  let base = fs_find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  let slot = (base - 2147516528) / 16;
  let map = 2147516656 + slot * 64;
  let mut k = 0;
  while k < 16 {
    let b = peek32(map + k * 4);
    if b != 0 - 1 {
      fs_free_block(b);
      poke32(map + k * 4, 0 - 1);
    }
    k = k + 1;
  }
  poke32(base + 4, 0);
  return 0;
}

fn fs_write(id: int, index: int, value: int) -> int {
  let base = fs_find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 2147516528) / 16;
  let b = peek32(2147516656 + slot * 64 + (index / 64) * 4);
  poke32(2147519488 + b * 256 + (index % 64) * 4, value);
  return 0;
}

fn fs_read(id: int, index: int) -> int {
  let base = fs_find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
