fn font_row(ch: int, row: int) -> int {
  if ch == 75 {
    return glyph_k(row);
  }
  if ch == 69 {
    return glyph_e(row);
  }
  if ch == 82 {
    return glyph_r(row);
  }
  if ch == 78 {
    return glyph_n(row);
  }
  if ch == 65 {
    return glyph_a(row);
  }
  if ch == 66 {
    return glyph_b(row);
  }
  return 0;
}

fn draw_char(x: int, y: int, ch: int, ink: int, paper: int) {
  let mut row = 0;
  let mut bits = 0;
  while row < 8 {
    bits = font_row(ch, row);
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, ink);
      } else {
        pix_set(x + col, y + row, paper);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn pix_fill_rect(x: int, y: int, w: int, h: int, color: int) {
  let cword = color | (color << 8) | (color << 16) | (color << 24);
  let mut r = y;
  while r < y + h {
    let mut xx = x;
    while xx < x + w {
      if xx % 4 != 0 {
        pix_set(xx, r, color);
        xx = xx + 1;
      } else {
        if xx + 3 < x + w {
          poke32(268566528 + ((r * 320 + xx) / 4) * 4, cword);
          xx = xx + 4;
        } else {
          pix_set(xx, r, color);
          xx = xx + 1;
        }
      }
    }
    r = r + 1;
  }
}

fn pix_window(x: int, y: int, w: int, h: int, title: int, color: int) {
  pix_fill_rect(x + 1, y + 1, w - 2, h - 2, 0);
  pix_hline(x, x + w - 1, y, color);
  pix_hline(x, x + w - 1, y + h - 1, color);
  pix_vline(x, y, y + h - 1, color);
  pix_vline(x + w - 1, y, y + h - 1, color);
  draw_char(x + 2, y + 2, title, color, 0);
}

// ---- processes ----

fn demo_task() {
  put(72);
  let y1 = ecall(3, 0);
  put(73);
}

fn do_exit(code: int) {
  let x = ecall(4, code);
}

fn next_ready(cur: int) -> int {
  let mut s = cur + 1;
  while s < 4 {
    if peek32(2147516416 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  s = 0;
  while s < cur {
    if peek32(2147516416 + s * 16) == 1 {
      return s;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn switch_to(nxt: int) {
  let nbase = 2147516416 + nxt * 16;
  poke32(nbase, 2);
  csr_write(833, peek32(nbase + 8));
  csr_write(832, peek32(nbase + 4));
  poke32(2147516480, nxt);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    poke32(2147516488, peek32(2147516488) + 1);
    timer_set_cmp(timer_now() + 1000);
    let mut s = 0;
    while s < 4 {
      let base = 2147516416 + s * 16;
      if peek32(base) == 4 {
        if peek32(base + 12) <= timer_now() {
          poke32(base, 1);
        }
      }
      s = s + 1;
    }
    let cur = peek32(2147516480);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      return;
    }
    let curbase = 2147516416 + cur * 16;
    poke32(curbase + 4, frame);
    poke32(curbase + 8, csr_read(833));
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  let cur = peek32(2147516480);
  let curbase = 2147516416 + cur * 16;
  poke32(curbase + 4, frame);
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  if eid == 2 {
    let mut s = 1;
    let mut slot = 0 - 1;
    while s < 3 {
      if peek32(2147516416 + s * 16) == 0 {
        slot = s;
        break;
      }
      s = s + 1;
    }
    if slot == 0 - 1 {
      poke32(frame + 32, 0 - 1);
      csr_write(833, ret);
      return;
    }
    let top = 2147540992 - (slot - 1) * 8192;
    let dst = top - 120;
    let mut i = 0;
    while i < 30 {
      poke32(dst + i * 4, peek32(frame + i * 4));
      i = i + 1;
    }
    poke32(frame + 32, slot);
    poke32(dst + 32, 0);
    let sbase = 2147516416 + slot * 16;
    poke32(sbase, 1);
    poke32(sbase + 4, dst);
    poke32(sbase + 8, ret);
    poke32(sbase + 12, 0);
    csr_write(833, ret);
    return;
  }
  if eid == 3 {
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    poke32(curbase, 1);
    switch_to(nxt);
    return;
  }
  if eid == 4 {
    poke32(curbase, 3);
    poke32(curbase + 12, peek32(frame + 32));
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      csr_write(773, 0);
      let h = ecall(0, 0);
      return;
    }
    switch_to(nxt);
    return;
  }
  if eid == 5 {
    let ticks = peek32(frame + 32);
    poke32(curbase + 12, timer_now() + ticks * 1000);
    poke32(curbase, 4);
    let nxt = next_ready(cur);
    if nxt == 0 - 1 {
      poke32(curbase, 2);
      csr_write(833, ret);
      return;
    }
    poke32(curbase + 8, ret);
    switch_to(nxt);
    return;
  }
  csr_write(833, ret);
}

// ---- shell command bodies ----

fn cmd_fs() {
  let d = fs_delete(1);
  let c = fs_create(1, 70);
  fs_write(1, 63, 630);
  fs_write(1, 64, 640);
  fs_write(1, 69, 690);
  if c == 0 {
    if fs_read(1, 63) == 630 {
      if fs_read(1, 64) == 640 {
        if fs_read(1, 69) == 690 {
          put(70);
          put(10);
          return;
        }
      }
    }
  }
  put(69);
  put(10);
}

fn cmd_net() {
  poke32(2147517176, 0);
  poke32(2147517180, 0);
  poke32(2147517184, 0);
  dev_send(9, 7, 192);
  let r1 = dev_recv_wait();
  if r1 != 1 {
    put(69);
    put(10);
    return;
  }
  if peek32(2147517196) != 192 {
    put(69);
    put(10);
    return;
  }
  dev_send(7, 9, 1);
  let mut r2 = 0;
  let mut tries = 0;
  while tries < 3 {
    r2 = dev_recv_wait();
    if r2 == 1 {
      break;
    }
    tries = tries + 1;
  }
  if r2 != 1 {
    put(69);
    put(10);
    return;
  }
  if peek32(2147517196) != 2 {
    put(69);
    put(10);
    return;
  }
  put(80);
  put(79);
  put(78);
  put(71);
  put(10);
  put(83);
  print_num(peek32(2147517176));
  put(82);
  print_num(peek32(2147517180));
  put(68);
  print_num(peek32(2147517184));
  put(10);
}

fn cmd_gui() {
  put(27);
  put(91);
  put(50);
  put(74);
  put(27);
  put(91);
  put(72);
  draw_window(2, 2, 10, 4, 65);
  draw_window(5, 4, 10, 4, 66);
  draw_window(2, 2, 10, 4, 65);
  put(10);
}

fn cmd_text() {
  fb_window(2, 2, 10, 4, 65);
  fb_window(5, 4, 10, 4, 66);
  fb_window(2, 2, 10, 4, 65);
  put(84);
  put(10);
}

fn cmd_pix() {
  pix_window(20, 20, 100, 60, 65, 1);
  pix_window(60, 50, 100, 60, 66, 1);
  pix_window(20, 20, 100, 60, 65, 1);
  put(86);
  put(10);
}

fn main() {
  poke32(2147516416, 2);
  poke32(2147516420, 0);
  poke32(2147516424, 0);
  poke32(2147516428, 0);
  let mut s = 1;
  while s < 4 {
    poke32(2147516416 + s * 16, 0);
    s = s + 1;
  }
  poke32(2147516480, 0);
  poke32(2147516484, 0 - 1);
  poke32(2147516488, 0);
  poke32(2147516496, 2147517440);
  fs_format();
  poke32(2147517168, 0);
  poke32(2147517172, 0);
  poke32(2147517176, 0);
  poke32(2147517180, 0);
  poke32(2147517184, 0);
  fb_clear();
  pix_clear(0);
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  timer_set_cmp(1000);
  timer_enable();
  let mut y = 0;
  let mut running = 1;
  while running == 1 {
    put(62);
    put(32);
    let mut cmd = 0 - 1;
    while cmd == 0 - 1 {
      let c1 = peek32(268435460);
      if c1 != 0 - 1 {
        cmd = c1;
      } else {
        y = ecall(3, 0);
      }
    }
    put(cmd);
    let mut d = 0;
    while d != 10 {
      let c2 = peek32(268435460);
      if c2 != 0 - 1 {
        d = c2;
        put(c2);
      } else {
        y = ecall(3, 0);
      }
    }
    if cmd == 104 {
      put(104);
      put(32);
      put(112);
      put(32);
      put(115);
      put(32);
      put(119);
      put(32);
      put(109);
      put(32);
      put(102);
      put(32);
      put(103);
      put(32);
      put(110);
      put(32);
      put(116);
      put(32);
      put(118);
      put(32);
      put(113);
      put(10);
    } else if cmd == 112 {
      s = 0;
      while s < 4 {
        put(80);
        put(48 + s);
        put(58);
        put(48 + peek32(2147516416 + s * 16));
        put(32);
        s = s + 1;
      }
      put(10);
    } else if cmd == 115 {
      let pid = ecall(2, 0);
      if pid == 0 {
        demo_task();
        do_exit(0);
      }
      if pid > 0 {
        poke32(2147516484, pid);
      }
      if pid == 0 - 1 {
        put(63);
        put(10);
      }
    } else if cmd == 119 {
      let lp = peek32(2147516484);
      if lp >= 0 {
        while peek32(2147516416 + lp * 16) != 3 {
          y = ecall(3, 0);
        }
        put(87);
        put(48 + peek32(2147516416 + lp * 16 + 12));
        put(10);
      } else {
        put(63);
        put(10);
      }
    } else if cmd == 109 {
      let addr = bump_alloc(16);
      if addr == 0 - 1 {
        put(63);
        put(10);
      } else {
        put(77);
        print_hex(addr);
        put(10);
      }
    } else if cmd == 102 {
      cmd_fs();
    } else if cmd == 103 {
      cmd_gui();
    } else if cmd == 110 {
      cmd_net();
    } else if cmd == 116 {
      cmd_text();
    } else if cmd == 118 {
      cmd_pix();
    } else if cmd == 113 {
      put(66);
      put(89);
      put(69);
      put(10);
      running = 0;
    } else {
      put(63);
      put(10);
    }
    y = ecall(3, 0);
  }
}
