// Page bitmap allocator kernel (Phase F).
//
// 16 pages, one bitmap word at 32832 (bit i = page i used).
// alloc_page scans for the first clear bit; free_page clears it.
// Reuse is the point: freeing the middle page and allocating
// again must return that same page, not the next fresh one.
//
// Demo: allocate 3 pages (0, 1, 2), free page 1, allocate again
// (must be 1). Expected model UART transcript:
//   KERNA012\nR1\nDONE, halted. Final bitmap word is 7.

fn put(c: int) {
  poke32(268435456, c);
}

fn alloc_page() -> int {
  let mut i = 0;
  while i < 16 {
    let bm = peek32(32832);
    let mut k = 0;
    let mut mask = 1;
    while k < i {
      mask = mask * 2;
      k = k + 1;
    }
    if (bm / mask) % 2 == 0 {
      poke32(32832, bm + mask);
      return i;
    }
    i = i + 1;
  }
  return 0 - 1;
}

fn free_page(p: int) {
  let mut mask = 1;
  let mut k = 0;
  while k < p {
    mask = mask * 2;
    k = k + 1;
  }
  poke32(32832, peek32(32832) - mask);
}

fn main() {
  poke32(32832, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  let p0 = alloc_page();
  let p1 = alloc_page();
  let p2 = alloc_page();
  put(65);
  put(48 + p0);
  put(48 + p1);
  put(48 + p2);
  put(10);
  free_page(p1);
  let p3 = alloc_page();
  put(82);
  put(48 + p3);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
}
