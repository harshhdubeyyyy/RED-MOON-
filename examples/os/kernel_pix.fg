// Pixel framebuffer kernel (SOC2-only): 640x480, 8 bits per
// pixel, at 0x10020000 (= 268566528, verified by round-trip).
// Byte 0 of a word is the leftmost of its 4 pixels. Palette
// indices only: 0 = black, 1 = white; a real palette is a
// later step, not this one. The kernel uses no RAM scratch,
// so no rebase is needed; build with --stack-top 0x800F0000.
// Scene: black screen, white border, white filled rectangle,
// "KERN" in black on the rectangle. UART transcript is just
// KERN / DONE — the real output is the pixels, checked by
// the testbench.

fn put(c: int) {
  poke32(268435456, c);
}

fn pix_set(x: int, y: int, color: int) {
  let idx = y * 640 + x;
  let widx = idx / 4;
  let addr = 268566528 + widx * 4;
  let mut word = peek32(addr);
  let shift = (idx % 4) * 8;
  let mask = 255 << shift;
  word = (word & ~mask) | (color << shift);
  poke32(addr, word);
}

fn pix_clear(color: int) {
  let word = color | (color << 8) | (color << 16) | (color << 24);
  let mut i = 0;
  let mut addr = 268566528;
  while i < 76800 {
    poke32(addr, word);
    addr = addr + 4;
    i = i + 1;
  }
}

fn pix_hline(x0: int, x1: int, y: int, color: int) {
  let mut x = x0;
  while x <= x1 {
    pix_set(x, y, color);
    x = x + 1;
  }
}

fn pix_vline(x: int, y0: int, y1: int, color: int) {
  let mut y = y0;
  while y <= y1 {
    pix_set(x, y, color);
    y = y + 1;
  }
}

fn pix_fill_rect(x: int, y: int, w: int, h: int, color: int) {
  let cword = color | (color << 8) | (color << 16) | (color << 24);
  let mut r = y;
  while r < y + h {
    let mut xx = x;
    while xx < x + w {
      if xx % 4 == 0 {
        let mut addr = 268566528 + ((r * 640 + xx) / 4) * 4;
        while xx + 3 < x + w {
          poke32(addr, cword);
          addr = addr + 4;
          xx = xx + 4;
        }
        if xx < x + w {
          pix_set(xx, r, color);
          xx = xx + 1;
        }
      } else {
        pix_set(xx, r, color);
        xx = xx + 1;
      }
    }
    r = r + 1;
  }
}

fn glyph_k(row: int) -> int {
  if row == 0 {
    return 130;
  }
  if row == 1 {
    return 132;
  }
  if row == 2 {
    return 136;
  }
  if row == 3 {
    return 144;
  }
  if row == 4 {
    return 144;
  }
  if row == 5 {
    return 136;
  }
  if row == 6 {
    return 132;
  }
  if row == 7 {
    return 130;
  }
  return 0;
}

fn glyph_e(row: int) -> int {
  if row == 0 {
    return 254;
  }
  if row == 1 {
    return 128;
  }
  if row == 2 {
    return 128;
  }
  if row == 3 {
    return 248;
  }
  if row == 4 {
    return 128;
  }
  if row == 5 {
    return 128;
  }
  if row == 6 {
    return 128;
  }
  if row == 7 {
    return 254;
  }
  return 0;
}

fn glyph_r(row: int) -> int {
  if row == 0 {
    return 248;
  }
  if row == 1 {
    return 132;
  }
  if row == 2 {
    return 132;
  }
  if row == 3 {
    return 248;
  }
  if row == 4 {
    return 144;
  }
  if row == 5 {
    return 136;
  }
  if row == 6 {
    return 132;
  }
  if row == 7 {
    return 130;
  }
  return 0;
}

fn glyph_n(row: int) -> int {
  if row == 0 {
    return 129;
  }
  if row == 1 {
    return 193;
  }
  if row == 2 {
    return 161;
  }
  if row == 3 {
    return 145;
  }
  if row == 4 {
    return 137;
  }
  if row == 5 {
    return 133;
  }
  if row == 6 {
    return 131;
  }
  if row == 7 {
    return 129;
  }
  return 0;
}

fn font_row(ch: int, row: int) -> int {
  if ch == 75 {
    return glyph_k(row);
  }
  if ch == 69 {
    return glyph_e(row);
  }
  if ch == 82 {
    return glyph_r(row);
  }
  if ch == 78 {
    return glyph_n(row);
  }
  return 0;
}

fn draw_char(x: int, y: int, ch: int, ink: int, paper: int) {
  let mut row = 0;
  let mut bits = 0;
  while row < 8 {
    bits = font_row(ch, row);
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, ink);
      } else {
        pix_set(x + col, y + row, paper);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn main() {
  put(75);
  put(69);
  put(82);
  put(78);
  put(10);
  pix_clear(0);
  pix_hline(10, 629, 10, 1);
  pix_hline(10, 629, 469, 1);
  pix_vline(10, 10, 469, 1);
  pix_vline(629, 10, 469, 1);
  pix_fill_rect(100, 180, 440, 120, 1);
  draw_char(304, 236, 75, 0, 1);
  draw_char(312, 236, 69, 0, 1);
  draw_char(320, 236, 82, 0, 1);
  draw_char(328, 236, 78, 0, 1);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
}
