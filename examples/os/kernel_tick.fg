// First kernel (Phase E checkpoint 1): timer-tick demo on big32.
//
// Runs freestanding on the Python big32 model, which gained a minimal
// timer for Phase E: mtime at 0x10000010, mtimecmp at 0x10000018
// (32-bit halves), mip.MTIP level-sensitive while mtime >= mtimecmp.
//
// The kernel enables ONLY the machine timer interrupt, so the trap
// handler needs no mcause dispatch: every trap that reaches it is a
// tick. Handler state lives in RAM scratch (0x8000) because
// freestanding programs have no globals: the handler bumps the tick
// count, prints 'T', and reprograms mtimecmp past mtime (reprogramming
// before mret is what clears the pending level — otherwise the model
// re-traps immediately, correctly). main prints KERN, arms the timer,
// spins until 5 ticks, prints DONE, and returns; returning halts
// (main's ending clears mtvec before the final ecall).
//
// Expected model UART transcript: KERNTTTTTDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn trap_handler() {
  let n = peek32(32768);
  poke32(32768, n + 1);
  poke32(268435456, 84);
  let now = peek32(268435472);
  poke32(268435480, now + 1000);
}

fn main() {
  poke32(32768, 0);
  put(75);
  put(69);
  put(82);
  put(78);
  let now = peek32(268435472);
  poke32(268435480, now + 1000);
  csr_set(772, 128);
  csr_set(768, 8);
  while peek32(32768) < 5 {
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
