// Phase F checkpoint 7: GUI — terminal windows over UART.
//
// There is no framebuffer hardware in the model or the
// Verilog, so the display this OS actually has is the UART
// terminal. The GUI is therefore a text windowing system in
// the ncurses spirit: windows are ANSI-drawn boxes, and the
// terminal does the rendering. No back-buffer exists
// (freestanding rejects array values), so drawing is
// immediate: focus changes and moves redraw the window, and
// anything underneath is redrawn by drawing it again.
//
// Primitives:
//   print_num(n): decimal digits for 0..99 (positions on an
//     80x25 screen never need more; no recursion, no arrays).
//   move_to(row, col): ESC[<row>;<col>H (1-based, ANSI).
//   draw_window(x, y, w, h, title): box with '+' corners,
//     '-' top/bottom, '|' sides, spaces inside, and the title
//     as a single character in the top border (freestanding
//     rejects string values, so titles are characters).
//   clear_screen(): ESC[2J + ESC[H.
//
// Demo: clear, window A at (2,2,10,4), window B at (5,4,10,4)
// overlapping A, then A again (bring A to front — a redraw,
// which is all "focus" means without a back-buffer), then
// DONE and halt. Expected model UART transcript: the exact
// ANSI byte stream (see the test), halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn print_num(n: int) {
  if n >= 10 {
    put(48 + n / 10);
  }
  put(48 + n % 10);
}

fn move_to(row: int, col: int) {
  put(27);
  put(91);
  print_num(row);
  put(59);
  print_num(col);
  put(72);
}

fn draw_window(x: int, y: int, w: int, h: int, title: int) {
  move_to(y, x);
  put(43);
  put(title);
  let mut i = 0;
  while i < w - 3 {
    put(45);
    i = i + 1;
  }
  put(43);
  let mut r = y + 1;
  while r < y + h - 1 {
    move_to(r, x);
    put(124);
    let mut j = 0;
    while j < w - 2 {
      put(32);
      j = j + 1;
    }
    put(124);
    r = r + 1;
  }
  move_to(y + h - 1, x);
  put(43);
  let mut k = 0;
  while k < w - 2 {
    put(45);
    k = k + 1;
  }
  put(43);
}

fn main() {
  put(27);
  put(91);
  put(50);
  put(74);
  put(27);
  put(91);
  put(72);
  draw_window(2, 2, 10, 4, 65);
  draw_window(5, 4, 10, 4, 66);
  draw_window(2, 2, 10, 4, 65);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
}
