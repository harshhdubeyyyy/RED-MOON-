// Phase F checkpoint 1: bump allocator kernel on big32.
//
// The OS needs memory management before anything else, and an
// allocator does not need pointers: addresses are plain ints, and
// peek32/poke32 are the read/write. The heap is a fixed region
// [0xA000, 0xC000) — clear of the scheduler scratch (0x8000s),
// the task stacks (0xE000, main stack from 0xFFFC down), and the
// statics (below 0x8000). The bump pointer lives in RAM scratch
// 0x8040 (freestanding has no globals).
//
// alloc(size): align the bump pointer up to 4, fail with 0 - 1
// when the block would pass the heap end, else advance the bump
// pointer and return the block address. free is deliberately a
// no-op here: a free-list is checkpoint 2, and claiming otherwise
// would be dishonest.
//
// Demo: allocate three blocks, write a pattern through poke32,
// read it back through peek32, and print K per verified block;
// allocate past the end (must fail with -1) for another K; then
// DONE and halt. Output uses poke32 UART bytes only — freestanding
// rejects print.
//
// Expected model UART transcript: KERNKKKKDONE, halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn alloc(size: int) -> int {
  let p = peek32(32832);
  let a = (p + 3) & ~3;
  if a + size > 49152 {
    return 0 - 1;
  }
  poke32(32832, a + size);
  return a;
}

fn main() {
  poke32(32832, 40960);
  put(75);
  put(69);
  put(82);
  put(78);
  let b1 = alloc(16);
  poke32(b1, 111);
  poke32(b1 + 4, 222);
  poke32(b1 + 8, 333);
  poke32(b1 + 12, 444);
  if peek32(b1) == 111 {
    if peek32(b1 + 4) == 222 {
      if peek32(b1 + 8) == 333 {
        if peek32(b1 + 12) == 444 {
          put(75);
        }
      }
    }
  }
  let b2 = alloc(5);
  if b2 % 4 == 0 {
    poke32(b2, 77);
    if peek32(b2) == 77 {
      put(75);
    }
  }
  let b3 = alloc(8);
  poke32(b3, 55);
  if peek32(b3) == 55 {
    put(75);
  }
  let big = alloc(8192);
  if big == 0 - 1 {
    put(75);
  }
  put(68);
  put(79);
  put(78);
  put(69);
}
