// ecall3 demo kernel — proves the three-argument ecall builtin.
//
// ecall3(eid, arg0, arg1) puts the extension id in a7, arg0 in a0 and
// arg1 in a1, and returns a0. The trap handler below dispatches Base
// (EID 16) with the function id in a0 and the argument in a1: fid 0
// returns the spec version (2), fid 1 returns arg1 + 100 — so a call
// ecall3(16, 1, 41) must print 141, which only happens if a1 actually
// arrived. Unknown EIDs return -2.
//
// Honest scope note: this is the three-register call (a7, a0, a1).
// Real SBI additionally uses a6 for the function id; calling firmware
// SBI exactly still needs an a6-carrying call, which is a future slice.
// Expected model UART transcript: "2\n141\n-2\nDONE\n", halted.

fn put(c: int) {
  poke32(268435456, c);
}

fn print_int(v: int) {
  if v < 0 {
    put(45);
    print_int(0 - v);
    return;
  }
  if v >= 10 {
    print_int(v / 10);
  }
  put(48 + v % 10);
}

fn trap_handler(frame: int) {
  let cause = csr_read(834);
  if cause < 0 {
    // Timer interrupt: silence it by pushing mtimecmp to the far future,
    // then return to the interrupted instruction.
    poke32(268435480, 0 - 1);
    poke32(268435484, 0 - 1);
    return;
  }
  let ret = csr_read(833) + 4;
  let eid = peek32(frame + 60);
  let fid = peek32(frame + 32);
  let arg1 = peek32(frame + 36);
  if eid == 16 {
    if fid == 0 {
      poke32(frame + 32, 2);
    } else {
      if fid == 1 {
        poke32(frame + 32, arg1 + 100);
      } else {
        poke32(frame + 32, 0 - 2);
      }
    }
    poke32(frame + 36, 0);
    csr_write(833, ret);
    return;
  }
  poke32(frame + 32, 0 - 2);
  poke32(frame + 36, 0);
  csr_write(833, ret);
}

fn main() {
  let v = ecall3(16, 0, 0);
  print_int(v);
  put(10);
  let w = ecall3(16, 1, 41);
  print_int(w);
  put(10);
  let e = ecall3(99, 0, 0);
  print_int(e);
  put(10);
  put(68);
  put(79);
  put(78);
  put(69);
  put(10);
  csr_write(773, 0);
  let h = ecall(0, 0);
}
