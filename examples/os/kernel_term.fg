    return 136;
  }
  if row == 2 {
    return 8;
  }
  if row == 3 {
    return 16;
  }
  if row == 4 {
    return 32;
  }
  if row == 5 {
    return 0;
  }
  if row == 6 {
    return 32;
  }
  if row == 7 {
    return 0;
  }
  return 0;
}

fn glyph_f(row: int) -> int {
  if row == 0 {
    return 48;
  }
  if row == 1 {
    return 72;
  }
  if row == 2 {
    return 64;
  }
  if row == 3 {
    return 240;
  }
  if row == 4 {
    return 64;
  }
  if row == 5 {
    return 64;
  }
  if row == 6 {
    return 64;
  }
  if row == 7 {
    return 64;
  }
  return 0;
}

fn mac_font_row(ch: int, row: int) -> int {
  if ch == 75 {
    return glyph_capK(row);
  }
  if ch == 69 {
    return glyph_capE(row);
  }
  if ch == 82 {
    return glyph_capR(row);
  }
  if ch == 78 {
    return glyph_capN(row);
  }
  if ch == 65 {
    return glyph_capA(row);
  }
  if ch == 66 {
    return glyph_capB(row);
  }
  if ch == 67 {
    return glyph_capC(row);
  }
  if ch == 70 {
    return glyph_capF(row);
  }
  if ch == 72 {
    return glyph_capH(row);
  }
  if ch == 79 {
    return glyph_capO(row);
  }
  if ch == 83 {
    return glyph_capS(row);
  }
  if ch == 84 {
    return glyph_capT(row);
  }
  if ch == 86 {
    return glyph_capV(row);
  }
  if ch == 87 {
    return glyph_capW(row);
  }
  if ch == 97 {
    return glyph_a(row);
  }
  if ch == 99 {
    return glyph_c(row);
  }
  if ch == 100 {
    return glyph_d(row);
  }
  if ch == 101 {
    return glyph_e(row);
  }
  if ch == 104 {
    return glyph_h(row);
  }
  if ch == 105 {
    return glyph_i(row);
  }
  if ch == 108 {
    return glyph_l(row);
  }
  if ch == 109 {
    return glyph_m(row);
  }
  if ch == 110 {
    return glyph_n(row);
  }
  if ch == 111 {
    return glyph_o(row);
  }
  if ch == 112 {
    return glyph_p(row);
  }
  if ch == 114 {
    return glyph_r(row);
  }
  if ch == 115 {
    return glyph_s(row);
  }
  if ch == 116 {
    return glyph_t(row);
  }
  if ch == 117 {
    return glyph_u(row);
  }
  if ch == 119 {
    return glyph_w(row);
  }
  if ch == 48 {
    return glyph_d0(row);
  }
  if ch == 49 {
    return glyph_d1(row);
  }
  if ch == 50 {
    return glyph_d2(row);
  }
  if ch == 51 {
    return glyph_d3(row);
  }
  if ch == 52 {
    return glyph_d4(row);
  }
  if ch == 53 {
    return glyph_d5(row);
  }
  if ch == 54 {
    return glyph_d6(row);
  }
  if ch == 55 {
    return glyph_d7(row);
  }
  if ch == 56 {
    return glyph_d8(row);
  }
  if ch == 57 {
    return glyph_d9(row);
  }
  if ch == 32 {
    return glyph_space(row);
  }
  if ch == 58 {
    return glyph_colon(row);
  }
  if ch == 46 {
    return glyph_dot(row);
  }
  if ch == 45 {
    return glyph_minus(row);
  }
  if ch == 47 {
    return glyph_slash(row);
  }
  if ch == 40 {
    return glyph_lparen(row);
  }
  if ch == 41 {
    return glyph_rparen(row);
  }
  if ch == 62 {
    return glyph_gt(row);
  }
  if ch == 63 {
    return glyph_qmark(row);
  }
  if ch == 102 {
    return glyph_f(row);
  }
  return 0;
}
// Finder app, stage 1 (SOC2-only, 640x480): interactive desktop
// + filesystem v2. Finder window lists real boot-created files
// (ids 1, 2, 3) read from the FS table; body click selects a row.
// FS v2 has numeric ids, no filenames — rows read FILE 1/2/3.
// SOC2-only: FS v2 data lives in high RAM (0x800E0000+) ABOVE the
// kernel code, so boot_files() can never overwrite instructions.
// (Old model-space FS bases 0x8060-0xE000 sat INSIDE this kernel's
// code image and corrupted the press path — found 28 Oct 2026.)
// No rebase needed: all MMIO/FS addresses are full SOC2 addresses.
fn put(c: int) {
  poke32(268435456, c);
}

fn block_addr(b: int) -> int {
  return 2148405248 + b * 256;
}

fn find(id: int) -> int {
  let mut s = 0;
  while s < 8 {
    let base = 2148401168 + s * 16;
    if peek32(base + 4) == 1 {
      if peek32(base) == id {
        return base;
      }
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_format() {
  let mut s = 0;
  while s < 8 {
    let base = 2148401168 + s * 16;
    poke32(base, 0);
    poke32(base + 4, 0);
    poke32(base + 8, 0);
    poke32(base + 12, 0);
    s = s + 1;
  }
  let mut m = 0;
  while m < 128 {
    poke32(2148401408 + m * 4, 0 - 1);
    m = m + 1;
  }
  poke32(2148401152, 0);
  poke32(2148401156, 0 - 1);
}

fn alloc_block() -> int {
  let head = peek32(2148401156);
  if head != 0 - 1 {
    poke32(2148401156, peek32(block_addr(head)));
    return head;
  }
  let bump = peek32(2148401152);
  if bump >= 16 {
    return 0 - 1;
  }
  poke32(2148401152, bump + 1);
  return bump;
}

fn free_block(b: int) {
  poke32(block_addr(b), peek32(2148401156));
  poke32(2148401156, b);
}

fn fs_create(id: int, nwords: int) -> int {
  if find(id) != 0 - 1 {
    return 0 - 1;
  }
  let mut s = 0;
  while s < 8 {
    let base = 2148401168 + s * 16;
    if peek32(base + 4) == 0 {
      let need = (nwords + 63) / 64;
      let map = 2148401408 + s * 64;
      let mut k = 0;
      while k < need {
        let b = alloc_block();
        if b == 0 - 1 {
          let mut j = 0;
          while j < k {
            free_block(peek32(map + j * 4));
            j = j + 1;
          }
          return 0 - 1;
        }
        poke32(map + k * 4, b);
        k = k + 1;
      }
      while k < 16 {
        poke32(map + k * 4, 0 - 1);
        k = k + 1;
      }
      poke32(base, id);
      poke32(base + 4, 1);
      poke32(base + 8, nwords);
      poke32(base + 12, 0);
      return 0;
    }
    s = s + 1;
  }
  return 0 - 1;
}

fn fs_delete(id: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  let slot = (base - 2148401168) / 16;
  let map = 2148401408 + slot * 64;
  let mut k = 0;
  while k < 16 {
    let b = peek32(map + k * 4);
    if b != 0 - 1 {
      free_block(b);
      poke32(map + k * 4, 0 - 1);
    }
    k = k + 1;
  }
  poke32(base + 4, 0);
  return 0;
}

fn fs_write(id: int, index: int, value: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 2148401168) / 16;
  let b = peek32(2148401408 + slot * 64 + (index / 64) * 4);
  let addr = 2148405248 + b * 256 + (index % 64) * 4;
  poke32(addr, value);
  return 0;
}

fn fs_read(id: int, index: int) -> int {
  let base = find(id);
  if base == 0 - 1 {
    return 0 - 1;
  }
  if index < 0 {
    return 0 - 1;
  }
  if index >= peek32(base + 8) {
    return 0 - 1;
  }
  let slot = (base - 2148401168) / 16;
  let b = peek32(2148401408 + slot * 64 + (index / 64) * 4);
  let addr = 2148405248 + b * 256 + (index % 64) * 4;
  return peek32(addr);
}


fn draw_finder_rows(x: int, y: int, sel: int) {
  let mut s = 0;
  let mut row = 0;
  while s < 8 {
    let base = 2148401168 + s * 16;
    if peek32(base + 4) == 1 {
      let id = peek32(base);
      let ry = y + 24 + row * 16;
      if sel == row {
        pix_fill_rect(x + 8, ry - 1, 64, 10, 0);
        mac_draw_char(x + 16, ry, 70, 1, 0);
        mac_draw_char(x + 24, ry, 73, 1, 0);
        mac_draw_char(x + 32, ry, 76, 1, 0);
        mac_draw_char(x + 40, ry, 69, 1, 0);
        mac_draw_char(x + 48, ry, 32, 1, 0);
        mac_draw_char(x + 56, ry, 48 + id, 1, 0);
      } else {
        mac_draw_char(x + 16, ry, 70, 0, 1);
        mac_draw_char(x + 24, ry, 73, 0, 1);
        mac_draw_char(x + 32, ry, 76, 0, 1);
        mac_draw_char(x + 40, ry, 69, 0, 1);
        mac_draw_char(x + 48, ry, 32, 0, 1);
        mac_draw_char(x + 56, ry, 48 + id, 0, 1);
      }
      row = row + 1;
    }
    s = s + 1;
  }
}

fn finder_select(py: int, fy: int, fcount: int, selected: int) -> int {
  if py < fy + 24 {
    return selected;
  }
  let r = (py - (fy + 24)) / 16;
  if r >= fcount {
    return selected;
  }
  return r;
}

fn boot_files() -> int {
  fs_format();
  let mut c = 0;
  if fs_create(1, 4) == 0 {
    c = c + 1;
  }
  if fs_create(2, 8) == 0 {
    c = c + 1;
  }
  if fs_create(3, 12) == 0 {
    c = c + 1;
  }
  return c;
}

fn pix_set(x: int, y: int, color: int) {
  let idx = y * 640 + x;
  let widx = idx / 4;
  let addr = 268566528 + widx * 4;
  let mut word = peek32(addr);
  let shift = (idx % 4) * 8;
  let mask = 255 << shift;
  word = (word & ~mask) | (color << shift);
  poke32(addr, word);
}

fn pix_hline(x0: int, x1: int, y: int, color: int) {
  let mut x = x0;
  while x <= x1 {
    pix_set(x, y, color);
    x = x + 1;
  }
}

fn pix_vline(x: int, y0: int, y1: int, color: int) {
  let mut y = y0;
  while y <= y1 {
    pix_set(x, y, color);
    y = y + 1;
  }
}

fn pix_fill_rect(x: int, y: int, w: int, h: int, color: int) {
  let cword = color | (color << 8) | (color << 16) | (color << 24);
  let mut r = y;
  while r < y + h {
    let mut xx = x;
    while xx < x + w {
      if xx % 4 == 0 {
        let mut addr = 268566528 + ((r * 640 + xx) / 4) * 4;
        while xx + 3 < x + w {
          poke32(addr, cword);
          addr = addr + 4;
          xx = xx + 4;
        }
        if xx < x + w {
          pix_set(xx, r, color);
          xx = xx + 1;
        }
      } else {
        pix_set(xx, r, color);
        xx = xx + 1;
      }
    }
    r = r + 1;
  }
}

fn mac_draw_char(x: int, y: int, ch: int, ink: int, paper: int) {
  let mut row = 0;
  let mut bits = 0;
  while row < 8 {
    bits = mac_font_row(ch, row);
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, ink);
      } else {
        pix_set(x + col, y + row, paper);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn draw_circle8(x: int, y: int, color: int) {
  let mut row = 0;
  while row < 8 {
    let mut bits = 0;
    if row == 0 {
      bits = 60;
    }
    if row == 1 {
      bits = 126;
    }
    if row == 2 {
      bits = 255;
    }
    if row == 3 {
      bits = 255;
    }
    if row == 4 {
      bits = 255;
    }
    if row == 5 {
      bits = 255;
    }
    if row == 6 {
      bits = 126;
    }
    if row == 7 {
      bits = 60;
    }
    let mut col = 0;
    while col < 8 {
      let bit = (bits >> (7 - col)) & 1;
      if bit == 1 {
        pix_set(x + col, y + row, color);
      }
      col = col + 1;
    }
    row = row + 1;
  }
}

fn mac_window(x: int, y: int, w: int, h: int, body: int) {
  pix_fill_rect(x + 1, y + 17, w - 2, h - 18, body);
  pix_fill_rect(x + 1, y + 1, w - 2, 15, 2);
  pix_hline(x, x + w - 1, y, 0);
  pix_hline(x, x + w - 1, y + h - 1, 0);
  pix_vline(x, y, y + h - 1, 0);
  pix_vline(x + w - 1, y, y + h - 1, 0);
  draw_circle8(x + 6, y + 4, 4);
  draw_circle8(x + 18, y + 4, 5);
  draw_circle8(x + 30, y + 4, 6);
}

fn draw_finder_window(x: int, y: int, sel: int) {
  mac_window(x, y, 320, 240, 1);
  draw_finder_rows(x, y, sel);
  mac_draw_char(x + 44, y + 4, 70, 0, 2);
  mac_draw_char(x + 52, y + 4, 105, 0, 2);
  mac_draw_char(x + 60, y + 4, 110, 0, 2);
  mac_draw_char(x + 68, y + 4, 100, 0, 2);
  mac_draw_char(x + 76, y + 4, 101, 0, 2);
  mac_draw_char(x + 84, y + 4, 114, 0, 2);
}


fn term_cell(line: int, col: int) -> int {
  return 2148413440 + (line * 38 + col) * 4;
}

fn term_draw_cell(tx: int, ty: int, line: int, col: int) {
  let ch = peek32(term_cell(line, col));
  mac_draw_char(tx + 8 + col * 8, ty + 24 + line * 10, ch, 0, 1);
}

fn term_draw_body(tx: int, ty: int) {
  let mut line = 0;
  while line < 16 {
    let mut col = 0;
    while col < 38 {
      term_draw_cell(tx, ty, line, col);
      col = col + 1;
    }
    line = line + 1;
  }
}

fn term_prompt(tx: int, ty: int) {
  let line = peek32(2148415872);
  poke32(term_cell(line, 0), 62);
  poke32(term_cell(line, 1), 32);
  term_draw_cell(tx, ty, line, 0);
  term_draw_cell(tx, ty, line, 1);
  poke32(2148415876, 2);
}

fn term_next_line(tx: int, ty: int, prompt: int) {
  let mut line = peek32(2148415872);
  line = line + 1;
  if line >= 16 {
    let mut s = 0;
    while s < 15 {
      let mut c = 0;
      while c < 38 {
        poke32(term_cell(s, c), peek32(term_cell(s + 1, c)));
        c = c + 1;
      }
      s = s + 1;
    }
    let mut c2 = 0;
    while c2 < 38 {
      poke32(term_cell(15, c2), 0);
      c2 = c2 + 1;
    }
    term_draw_body(tx, ty);
    line = 15;
  }
  poke32(2148415872, line);
  poke32(2148415876, 0);
  if prompt == 1 {
    term_prompt(tx, ty);
  }
}

fn term_write_ch(tx: int, ty: int, ch: int) {
  let line = peek32(2148415872);
  let col = peek32(2148415876);
  poke32(term_cell(line, col), ch);
  term_draw_cell(tx, ty, line, col);
  poke32(2148415876, col + 1);
  if col + 1 >= 38 {
    term_next_line(tx, ty, 0);
  }
}

fn term_clear(tx: int, ty: int) {
  let mut i = 0;
  while i < 608 {
    poke32(2148413440 + i * 4, 0);
    i = i + 1;
  }
  poke32(2148415872, 0);
  poke32(2148415876, 0);
  term_draw_body(tx, ty);
  term_prompt(tx, ty);
}

fn term_files(tx: int, ty: int) {
  let mut s = 0;
  while s < 8 {
    let base = 2148401168 + s * 16;
    if peek32(base + 4) == 1 {
      let id = peek32(base);
      term_write_ch(tx, ty, 102);
      term_write_ch(tx, ty, 105);
      term_write_ch(tx, ty, 108);
      term_write_ch(tx, ty, 101);
      term_write_ch(tx, ty, 32);
      term_write_ch(tx, ty, 48 + id);
      term_next_line(tx, ty, 0);
    }
    s = s + 1;
  }
}

fn term_handle_key(tx: int, ty: int) {
  let c = peek32(268435460);
  if c != 0 - 1 {
    if c == 10 || c == 13 {
      let line = peek32(2148415872);
      let cmd = peek32(term_cell(line, 2));
      if cmd == 104 {
        term_next_line(tx, ty, 0);
        term_write_ch(tx, ty, 104);
        term_write_ch(tx, ty, 32);
        term_write_ch(tx, ty, 104);
        term_write_ch(tx, ty, 101);
        term_write_ch(tx, ty, 108);
        term_write_ch(tx, ty, 112);
        term_write_ch(tx, ty, 32);
        term_write_ch(tx, ty, 102);
        term_write_ch(tx, ty, 32);
        term_write_ch(tx, ty, 102);
        term_write_ch(tx, ty, 105);
        term_write_ch(tx, ty, 108);
        term_write_ch(tx, ty, 101);
        term_write_ch(tx, ty, 115);
        term_write_ch(tx, ty, 32);
        term_write_ch(tx, ty, 99);
        term_write_ch(tx, ty, 32);
        term_write_ch(tx, ty, 99);
        term_write_ch(tx, ty, 108);
        term_write_ch(tx, ty, 101);
        term_write_ch(tx, ty, 97);
        term_write_ch(tx, ty, 114);
        term_next_line(tx, ty, 1);
      } else if cmd == 102 {
        term_next_line(tx, ty, 0);
        term_files(tx, ty);
        term_next_line(tx, ty, 1);
      } else if cmd == 99 {
        term_clear(tx, ty);
      } else if cmd == 0 || cmd == 32 {
        term_next_line(tx, ty, 1);
      } else {
        term_next_line(tx, ty, 0);
        term_write_ch(tx, ty, 63);
        term_next_line(tx, ty, 1);
      }
    } else if c == 8 || c == 127 {
      let col = peek32(2148415876);
      if col > 2 {
        let line2 = peek32(2148415872);
        poke32(term_cell(line2, col - 1), 32);
        term_draw_cell(tx, ty, line2, col - 1);
        poke32(2148415876, col - 1);
      }
    } else if c >= 32 {
      if c < 127 {
        let col3 = peek32(2148415876);
        if col3 < 38 {
          let line3 = peek32(2148415872);
          poke32(term_cell(line3, col3), c);
          term_draw_cell(tx, ty, line3, col3);
          poke32(2148415876, col3 + 1);
        }
      }
    }
  }
}

fn draw_term_window(x: int, y: int) {
  mac_window(x, y, 320, 240, 0);
  mac_draw_char(x + 44, y + 4, 84, 0, 2);
  mac_draw_char(x + 52, y + 4, 101, 0, 2);
  mac_draw_char(x + 60, y + 4, 114, 0, 2);
  mac_draw_char(x + 68, y + 4, 109, 0, 2);
  mac_draw_char(x + 76, y + 4, 105, 0, 2);
  mac_draw_char(x + 84, y + 4, 110, 0, 2);
  mac_draw_char(x + 92, y + 4, 97, 0, 2);
  mac_draw_char(x + 100, y + 4, 108, 0, 2);
    term_draw_body(x, y);
}


fn hit_window(px: int, py: int, x: int, y: int, closed: int) -> int {
  if closed == 1 {
    return 0;
  }
  if px >= x + 6 && px < x + 14 && py >= y + 4 && py < y + 12 {
    return 1;
  }
  if px >= x && px < x + 320 && py >= y && py < y + 16 {
    return 2;
  }
  if px >= x && px < x + 320 && py >= y && py < y + 240 {
    return 3;
  }
  return 0;
}

fn draw_clock(h: int, m: int) {
  mac_draw_char(592, 4, 48 + h / 10, 0, 2);
  mac_draw_char(600, 4, 48 + h % 10, 0, 2);
  mac_draw_char(608, 4, 58, 0, 2);
  mac_draw_char(616, 4, 48 + m / 10, 0, 2);
  mac_draw_char(624, 4, 48 + m % 10, 0, 2);
}

fn draw_desktop(fx: int, fy: int, tx: int, ty: int, state: int, h: int, m: int) {
  let focus = state % 2;
  let sel = (state / 8) % 4;
  let fclosed = (state / 2) % 2;
  let tclosed = (state / 4) % 2;
  pix_fill_rect(0, 0, 640, 160, 9);
  pix_fill_rect(0, 160, 640, 160, 8);
  pix_fill_rect(0, 320, 640, 160, 7);
  pix_fill_rect(0, 0, 640, 16, 2);
  mac_draw_char(8, 4, 70, 0, 2);
  mac_draw_char(16, 4, 105, 0, 2);
  mac_draw_char(24, 4, 110, 0, 2);
  mac_draw_char(32, 4, 100, 0, 2);
  mac_draw_char(40, 4, 101, 0, 2);
  mac_draw_char(48, 4, 114, 0, 2);
  mac_draw_char(72, 4, 70, 0, 2);
  mac_draw_char(80, 4, 105, 0, 2);
  mac_draw_char(88, 4, 108, 0, 2);
  mac_draw_char(96, 4, 101, 0, 2);
  mac_draw_char(120, 4, 69, 0, 2);
  mac_draw_char(128, 4, 100, 0, 2);
  mac_draw_char(136, 4, 105, 0, 2);
  mac_draw_char(144, 4, 116, 0, 2);
  mac_draw_char(168, 4, 86, 0, 2);
  mac_draw_char(176, 4, 105, 0, 2);
  mac_draw_char(184, 4, 101, 0, 2);
  mac_draw_char(192, 4, 119, 0, 2);
  mac_draw_char(216, 4, 87, 0, 2);
  mac_draw_char(224, 4, 105, 0, 2);
  mac_draw_char(232, 4, 110, 0, 2);
  mac_draw_char(240, 4, 100, 0, 2);
  mac_draw_char(248, 4, 111, 0, 2);
  mac_draw_char(256, 4, 119, 0, 2);
  mac_draw_char(280, 4, 72, 0, 2);
  mac_draw_char(288, 4, 101, 0, 2);
  mac_draw_char(296, 4, 108, 0, 2);
  mac_draw_char(304, 4, 112, 0, 2);
  draw_clock(h, m);
  pix_fill_rect(196, 440, 248, 40, 3);
  pix_fill_rect(204, 444, 32, 32, 7);
  mac_draw_char(216, 456, 70, 1, 7);
  pix_fill_rect(252, 444, 32, 32, 0);
  mac_draw_char(264, 456, 84, 1, 0);
  pix_fill_rect(300, 444, 32, 32, 1);
  mac_draw_char(312, 456, 78, 0, 1);
  pix_fill_rect(348, 444, 32, 32, 5);
  mac_draw_char(360, 456, 67, 0, 5);
  pix_fill_rect(396, 444, 32, 32, 2);
  mac_draw_char(408, 456, 84, 0, 2);
  if focus == 1 {
    if fclosed == 0 {
      draw_finder_window(fx, fy, sel);
    }
    if tclosed == 0 {
      draw_term_window(tx, ty);
    }
  } else {
    if tclosed == 0 {
      draw_term_window(tx, ty);
    }
    if fclosed == 0 {
      draw_finder_window(fx, fy, sel);
    }
  }
}

fn main() {
  let mut fx = 80;
  let mut fy = 60;
  let mut tx = 200;
  let mut ty = 140;
  let mut focus = 1;
  let mut fclosed = 0;
  let mut tclosed = 0;
  let mut dragging = 0;
  let mut drag_win = 0;
  let mut grab_dx = 0;
  let mut grab_dy = 0;
  let mut prev_btn = 0;
  let mut px = 0;
  let mut py = 0;
  let mut btn = 0;
  let mut mt = 0;
  let mut secs = 0;
  let mut hours = 0;
  let mut mins = 0;
  let mut last_min = 0;
  let mut running = 1;
  let mut nx = 0;
  let mut ny = 0;
  let mut act = 0;
  let mut win = 0;
  let mut oldf = 0;
  let mut selected = 3;
  let mut fcount = 0;
  let mut oldsel = 3;
  mt = peek32(268435472);
  secs = mt / 100000000;
  hours = (secs / 3600) % 24;
  mins = (secs / 60) % 60;
  last_min = mins;
  fcount = boot_files();
  let mut ti = 0;
  while ti < 608 {
    poke32(2148413440 + ti * 4, 0);
    ti = ti + 1;
  }
  poke32(2148415872, 0);
  poke32(2148415876, 2);
  poke32(2148413440, 62);
  poke32(2148413440 + 4, 32);
  draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4 + selected * 8, hours, mins);
  put(77);
  put(65);
  put(67);
  put(10);
  while running == 1 {
    px = peek32(268460032);
    py = peek32(268460036);
    btn = peek32(268460040);
    if btn == 1 && prev_btn == 0 {
      oldf = focus;
      oldsel = selected;
      if focus == 1 {
        act = hit_window(px, py, tx, ty, tclosed);
        win = 2;
        if act == 0 {
          act = hit_window(px, py, fx, fy, fclosed);
          win = 1;
        }
      } else {
        act = hit_window(px, py, fx, fy, fclosed);
        win = 1;
        if act == 0 {
          act = hit_window(px, py, tx, ty, tclosed);
          win = 2;
        }
      }
      if act == 1 {
        if win == 1 {
          fclosed = 1;
        } else {
          tclosed = 1;
        }
        dragging = 0;
        draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4 + selected * 8, hours, mins);
      } else {
        if act == 2 {
          focus = win - 1;
          dragging = 1;
          drag_win = win;
          if win == 1 {
            grab_dx = px - fx;
            grab_dy = py - fy;
          } else {
            grab_dx = px - tx;
            grab_dy = py - ty;
          }
          if focus != oldf {
            draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4 + selected * 8, hours, mins);
          }
        } else {
          if act == 3 {
            focus = win - 1;
            if win == 1 {
              selected = finder_select(py, fy, fcount, selected);
            }
            if focus != oldf || selected != oldsel {
              draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4 + selected * 8, hours, mins);
            }
          }
        }
      }
    }
    if btn == 1 && prev_btn == 1 && dragging == 1 {
      if drag_win == 1 {
        nx = px - grab_dx;
        ny = py - grab_dy;
        if nx != fx || ny != fy {
          fx = nx;
          fy = ny;
          draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4 + selected * 8, hours, mins);
        }
      } else {
        if drag_win == 2 {
          nx = px - grab_dx;
          ny = py - grab_dy;
          if nx != tx || ny != ty {
            tx = nx;
            ty = ny;
            draw_desktop(fx, fy, tx, ty, focus + fclosed * 2 + tclosed * 4 + selected * 8, hours, mins);
          }
        }
      }
    }
    if btn == 0 && prev_btn == 1 {
      dragging = 0;
      drag_win = 0;
    }
    mt = peek32(268435472);
    secs = mt / 100000000;
    hours = (secs / 3600) % 24;
    mins = (secs / 60) % 60;
    if mins != last_min {
      draw_clock(hours, mins);
      last_min = mins;
    }
    if focus == 1 {
      term_handle_key(tx, ty);
    }
    prev_btn = btn;
  }
}
