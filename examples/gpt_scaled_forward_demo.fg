// Scaled GPT forward demo (no training): one window, loss, and
// the size of the autograd graph for the 2-block, 2-head model.
import "gpt2.fg";
import "tokenizer.fg";

fn main() -> int {
    let vocab: str = "abcdefghijklmnopqrstuvwxyz .,";
    let text: str = "the sun is warm today. a small cat sits on the mat.";
    let ids: [int] = char_encode(text, vocab);
    let mut x: [int] = [];
    let mut y: [int] = [];
    let mut i: int = 0;
    while i < 16 {
        push(x, ids[i]);
        push(y, ids[i + 1]);
        i = i + 1;
    }
    let params: [float] = g2_init_params(29, 16, 16, 32, 2, 42);
    println("params =", len(params));
    let mut s: Ag = ag_input(tape_new(), params[0]);
    i = 1;
    while i < len(params) {
        s = ag_input(s.tape, params[i]);
        i = i + 1;
    }
    let logits: NodeVec = g2_logits(s, x, 16, 16, 2, 32, 29, 2);
    println("logits =", len(logits.ids));
    let loss: Ag = g2_loss(logits.ag, logits.ids, y, 16, 29);
    println("loss =", loss.tape.vals[loss.last]);
    println("graph nodes =", len(loss.tape.vals));
    return 0;
}
