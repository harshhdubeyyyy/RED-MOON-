fn main() -> int {
    let n: int = 128;
    let mut a: [float] = [];
    let mut b: [float] = [];
    let mut i: int = 0;
    while i < n * n {
        push(a, 1.0);
        push(b, 2.0);
        i = i + 1;
    }
    let start: int = clock_micros();
    let mut c: [float] = [];
    i = 0;
    while i < n * n {
        push(c, 0.0);
        i = i + 1;
    }
    let mut r: int = 0;
    while r < n {
        let mut col: int = 0;
        while col < n {
            let mut s: float = 0.0;
            let mut k: int = 0;
            while k < n {
                s = s + a[r * n + k] * b[k * n + col];
                k = k + 1;
            }
            c[r * n + col] = s;
            col = col + 1;
        }
        r = r + 1;
    }
    let mut total: float = 0.0;
    i = 0;
    while i < n * n {
        total = total + c[i];
        i = i + 1;
    }
    let elapsed: int = clock_micros() - start;
    println("matmul checksum =", total, "us =", elapsed);
    return 0;
}
