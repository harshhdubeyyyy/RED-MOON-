// The Jal Pari Language — fuzzy string matching (roadmap item 36).
// Import with: import "fuzzy.fg";
// Levenshtein distance by dynamic programming over a flat
// (m+1) x (n+1) table. Characters are compared directly with
// string indexing, so no ord() builtin is needed.

fn levenshtein(a: str, b: str) -> int {
    let m: int = len(a);
    let n: int = len(b);
    let mut d: [int] = [];
    let mut k: int = 0;
    while k < (m + 1) * (n + 1) {
        push(d, 0);
        k = k + 1;
    }
    let mut i: int = 0;
    while i <= m {
        d[i * (n + 1)] = i;
        i = i + 1;
    }
    let mut j: int = 0;
    while j <= n {
        d[j] = j;
        j = j + 1;
    }
    i = 1;
    while i <= m {
        j = 1;
        while j <= n {
            let mut cost: int = 1;
            if a[i - 1] == b[j - 1] {
                cost = 0;
            }
            let del: int = d[(i - 1) * (n + 1) + j] + 1;
            let ins: int = d[i * (n + 1) + (j - 1)] + 1;
            let sub: int = d[(i - 1) * (n + 1) + (j - 1)] + cost;
            let mut best: int = del;
            if ins < best {
                best = ins;
            }
            if sub < best {
                best = sub;
            }
            d[i * (n + 1) + j] = best;
            j = j + 1;
        }
        i = i + 1;
    }
    return d[m * (n + 1) + n];
}
