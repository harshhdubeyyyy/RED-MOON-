// The Jal Pari Language — polynomials (roadmap item 11).
// Import with: import "polynomials.fg";
// Coefficients are low-to-high: [1, 2, 3] means 1 + 2x + 3x^2.

fn poly_eval(c: [float], x: float) -> float {
    let mut r: float = 0.0;
    let mut i: int = len(c) - 1;
    while i >= 0 {
        r = r * x + c[i];
        i = i - 1;
    }
    return r;
}

fn poly_deriv(c: [float]) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 0;
    while i + 1 < len(c) {
        push(out, c[i + 1] * (i + 1) as float);
        i = i + 1;
    }
    return out;
}

fn poly_add(a: [float], b: [float]) -> [float] {
    let mut out: [float] = [];
    let mut n: int = len(a);
    if len(b) > n {
        n = len(b);
    }
    let mut i: int = 0;
    while i < n {
        let mut v: float = 0.0;
        if i < len(a) {
            v = v + a[i];
        }
        if i < len(b) {
            v = v + b[i];
        }
        push(out, v);
        i = i + 1;
    }
    return out;
}

struct QuadRoots {
    has_real: bool;
    r1: float;
    r2: float;
}

fn quad_roots(a: float, b: float, c: float) -> QuadRoots {
    let disc: float = b * b - 4.0 * a * c;
    if disc < 0.0 {
        return QuadRoots { has_real: false, r1: 0.0, r2: 0.0 };
    }
    let s: float = sqrt(disc);
    return QuadRoots { has_real: true, r1: (0.0 - b - s) / (2.0 * a), r2: (0.0 - b + s) / (2.0 * a) };
}
