// The Jal Pari Language — small XML tag parser (roadmap item 19).
// Import with: import "xml.fg";
// No namespaces, no entities, no validation in v1: xml_tag
// reads the first element's name, xml_attr reads one attribute
// of the first element, xml_child_text reads the text of the
// first <tag>...</tag> child. Malformed input returns "" or
// fails on a missing attribute lookup via xml_attr_or.

fn xml_find(s: str, pat: str, from: int) -> int {
    let mut i: int = from;
    while i + len(pat) <= len(s) {
        if substr(s, i, len(pat)) == pat {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn xml_tag(s: str) -> str {
    let lt: int = xml_find(s, "<", 0);
    if lt < 0 {
        return "";
    }
    let mut i: int = lt + 1;
    let mut name: str = "";
    while i < len(s) {
        if s[i] == " " {
            break;
        }
        if s[i] == ">" {
            break;
        }
        if s[i] == "/" {
            break;
        }
        name = name + s[i];
        i = i + 1;
    }
    return name;
}

fn xml_attr(s: str, name: str) -> str {
    let pat: str = name + "=\"";
    let at: int = xml_find(s, pat, 0);
    if at < 0 {
        fail("xml_attr: attribute not found");
    }
    let start: int = at + len(pat);
    let mut i: int = start;
    let mut val: str = "";
    while i < len(s) {
        if s[i] == "\"" {
            break;
        }
        val = val + s[i];
        i = i + 1;
    }
    return val;
}

fn xml_attr_or(s: str, name: str, fallback: str) -> str {
    let pat: str = name + "=\"";
    let at: int = xml_find(s, pat, 0);
    if at < 0 {
        return fallback;
    }
    let start: int = at + len(pat);
    let mut i: int = start;
    let mut val: str = "";
    while i < len(s) {
        if s[i] == "\"" {
            break;
        }
        val = val + s[i];
        i = i + 1;
    }
    return val;
}

fn xml_child_text(s: str, tag: str) -> str {
    let open: str = "<" + tag + ">";
    let at: int = xml_find(s, open, 0);
    if at < 0 {
        return "";
    }
    let start: int = at + len(open);
    let close: str = "</" + tag + ">";
    let end: int = xml_find(s, close, start);
    if end < 0 {
        return "";
    }
    return substr(s, start, end - start);
}

fn xml_inner(s: str) -> str {
    let gt: int = xml_find(s, ">", 0);
    if gt < 0 {
        return "";
    }
    let tag: str = xml_tag(s);
    let close: str = "</" + tag + ">";
    let end: int = xml_find(s, close, gt + 1);
    if end < 0 {
        return "";
    }
    return substr(s, gt + 1, end - (gt + 1));
}
