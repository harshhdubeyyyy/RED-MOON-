#!/usr/bin/env python3
"""The Jal Pari Language — command wrapper.
Resolves symlinks (e.g. ~/.local/bin/jalpari -> repo/bin/jalpari)
so it always finds forge.py in the real checkout, then runs it.
"""
import os
import sys

_real = os.path.realpath(__file__)
_repo = os.path.dirname(os.path.dirname(_real))
os.execv(sys.executable, [sys.executable, os.path.join(_repo, "forge.py")] + sys.argv[1:])
