// statistics: mean, min, max, range, median, variance, stddev. Pure functions, no dependencies.
fn sum_float(xs: [float]) -> float {
    let mut s: float = 0.0;
    let mut i: int = 0;
    while i < len(xs) { s = s + xs[i]; i = i + 1; }
    return s;
}
fn mean_float(xs: [float]) -> float { return sum_float(xs) / (len(xs) as float); }
fn min_float(xs: [float]) -> float {
    let mut m: float = xs[0];
    let mut i: int = 1;
    while i < len(xs) {
        if xs[i] < m { m = xs[i]; }
        i = i + 1;
    }
    return m;
}
fn max_float(xs: [float]) -> float {
    let mut m: float = xs[0];
    let mut i: int = 1;
    while i < len(xs) {
        if xs[i] > m { m = xs[i]; }
        i = i + 1;
    }
    return m;
}
fn range_float(xs: [float]) -> float { return max_float(xs) - min_float(xs); }
fn sorted_copy_float(xs: [float]) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 0;
    while i < len(xs) { push(out, xs[i]); i = i + 1; }
    let mut a: int = 0;
    while a < len(out) {
        let mut b: int = 0;
        while b + 1 < len(out) - a {
            if out[b] > out[b + 1] {
                let t: float = out[b];
                out[b] = out[b + 1];
                out[b + 1] = t;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return out;
}
fn median_float(xs: [float]) -> float {
    let s: [float] = sorted_copy_float(xs);
    let n: int = len(s);
    if n % 2 == 1 { return s[n / 2]; }
    return (s[n / 2 - 1] + s[n / 2]) / 2.0;
}
fn variance_float(xs: [float]) -> float {
    let m: float = mean_float(xs);
    let mut s: float = 0.0;
    let mut i: int = 0;
    while i < len(xs) {
        let d: float = xs[i] - m;
        s = s + d * d;
        i = i + 1;
    }
    return s / (len(xs) as float);
}
fn stddev_float(xs: [float]) -> float { return sqrt(variance_float(xs)); }
