// colors: hex/rgb conversion and lightness. Pure functions, no dependencies.
fn hex_digit_value(ch: str) -> int {
    if ch == "0" { return 0; }
    if ch == "1" { return 1; }
    if ch == "2" { return 2; }
    if ch == "3" { return 3; }
    if ch == "4" { return 4; }
    if ch == "5" { return 5; }
    if ch == "6" { return 6; }
    if ch == "7" { return 7; }
    if ch == "8" { return 8; }
    if ch == "9" { return 9; }
    if ch == "a" { return 10; }
    if ch == "A" { return 10; }
    if ch == "b" { return 11; }
    if ch == "B" { return 11; }
    if ch == "c" { return 12; }
    if ch == "C" { return 12; }
    if ch == "d" { return 13; }
    if ch == "D" { return 13; }
    if ch == "e" { return 14; }
    if ch == "E" { return 14; }
    if ch == "f" { return 15; }
    if ch == "F" { return 15; }
    return -1;
}
fn hex_to_rgb(hex: str) -> [int] {
    let mut s: str = hex;
    if starts_with(hex, "#") { s = substr(hex, 1, 6); }
    let r: int = hex_digit_value(s[0]) * 16 + hex_digit_value(s[1]);
    let g: int = hex_digit_value(s[2]) * 16 + hex_digit_value(s[3]);
    let b: int = hex_digit_value(s[4]) * 16 + hex_digit_value(s[5]);
    return [r, g, b];
}
fn hex_digit_char(v: int) -> str { return "0123456789abcdef"[v]; }
fn rgb_to_hex(r: int, g: int, b: int) -> str {
    return "#" + hex_digit_char(r / 16) + hex_digit_char(r % 16) + hex_digit_char(g / 16) + hex_digit_char(g % 16) + hex_digit_char(b / 16) + hex_digit_char(b % 16);
}
fn luminance(r: int, g: int, b: int) -> float { return 0.2126 * (r as float) + 0.7152 * (g as float) + 0.0722 * (b as float); }
fn is_light(r: int, g: int, b: int) -> bool { return luminance(r, g, b) > 128.0; }
