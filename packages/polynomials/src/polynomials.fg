// polynomials: ascending-coefficient polynomials. Pure functions, no dependencies.
fn poly_eval(coeffs: [float], x: float) -> float {
    let mut r: float = 0.0;
    let mut i: int = len(coeffs) - 1;
    while i >= 0 { r = r * x + coeffs[i]; i = i - 1; }
    return r;
}
fn poly_add(a: [float], b: [float]) -> [float] {
    let mut n: int = len(a);
    if len(b) > n { n = len(b); }
    let mut out: [float] = [];
    let mut i: int = 0;
    while i < n {
        let mut av: float = 0.0;
        if i < len(a) { av = a[i]; }
        let mut bv: float = 0.0;
        if i < len(b) { bv = b[i]; }
        push(out, av + bv);
        i = i + 1;
    }
    return out;
}
fn poly_mul(a: [float], b: [float]) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 0;
    while i < len(a) + len(b) - 1 { push(out, 0.0); i = i + 1; }
    i = 0;
    while i < len(a) {
        let mut j: int = 0;
        while j < len(b) {
            out[i + j] = out[i + j] + a[i] * b[j];
            j = j + 1;
        }
        i = i + 1;
    }
    return out;
}
fn poly_deriv(coeffs: [float]) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 1;
    while i < len(coeffs) { push(out, coeffs[i] * (i as float)); i = i + 1; }
    return out;
}
