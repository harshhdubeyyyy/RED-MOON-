// NOTE: helper is named approx, not close: a Jal Pari fn named close
// collides with libc close() (unistd.h) in the generated C build.
import "interest.fg";
fn approx(a: float, b: float, tol: float) -> bool {
    let mut d: float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d < tol;
}
fn main() -> int {
    let mut bad: int = 0;
    if !approx(simple_interest(10000.0, 5.0, 2.0), 1000.0, 0.000001) { println("FAIL simple"); bad = 1; }
    if !approx(compound_amount(1000.0, 10.0, 2.0), 1210.0, 0.000001) { println("FAIL compound"); bad = 1; }
    if !approx(emi(100000.0, 12.0, 12.0), 8884.88, 0.01) { println("FAIL emi, got", emi(100000.0, 12.0, 12.0)); bad = 1; }
    println("interest demo: EMI on 100000 at 12% for 12 months =", emi(100000.0, 12.0, 12.0));
    if bad == 0 { println("interest demo ok"); }
    return bad;
}
