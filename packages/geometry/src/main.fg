// NOTE: helper is named approx, not close: a Jal Pari fn named close
// collides with libc close() (unistd.h) in the generated C build.
import "geometry.fg";
fn approx(a: float, b: float, tol: float) -> bool {
    let mut d: float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d < tol;
}
fn main() -> int {
    let mut bad: int = 0;
    if !approx(circle_area(1.0), 3.141592653589793, 0.000001) { println("FAIL circle_area"); bad = 1; }
    if !approx(rect_area(3.0, 4.0), 12.0, 0.000001) { println("FAIL rect_area"); bad = 1; }
    if !approx(triangle_area(4.0, 5.0), 10.0, 0.000001) { println("FAIL triangle_area"); bad = 1; }
    if !approx(sphere_volume(1.0), 4.188790204786391, 0.000001) { println("FAIL sphere_volume"); bad = 1; }
    if !approx(hypotenuse(3.0, 4.0), 5.0, 0.000001) { println("FAIL hypotenuse"); bad = 1; }
    println("geometry demo: circle r=2 area =", circle_area(2.0));
    if bad == 0 { println("geometry demo ok"); }
    return bad;
}
