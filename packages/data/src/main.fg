import "data.fg";
fn approx(a: float, b: float, tol: float) -> bool {
    let mut d: float = a - b;
    if d < 0.0 { d = 0.0 - d; }
    return d < tol;
}
fn main() -> int {
    let mut bad: int = 0;
    if !approx(bytes_to_kb(2048.0), 2.0, 0.000001) { println("FAIL kb"); bad = 1; }
    if !approx(bytes_to_mb(1048576.0), 1.0, 0.000001) { println("FAIL mb"); bad = 1; }
    if !approx(bytes_to_gb(1073741824.0), 1.0, 0.000001) { println("FAIL gb"); bad = 1; }
    if !approx(kb_to_bytes(2.0), 2048.0, 0.000001) { println("FAIL kb bytes"); bad = 1; }
    if !approx(mb_to_bytes(1.5), 1572864.0, 0.000001) { println("FAIL mb bytes"); bad = 1; }
    if !approx(gb_to_bytes(0.5), 536870912.0, 0.000001) { println("FAIL gb bytes"); bad = 1; }
    println("data demo: 2048 bytes =", bytes_to_kb(2048.0), "KB");
    if bad == 0 { println("data demo ok"); }
    return bad;
}
