// fractions: rational numbers. Pure functions, no dependencies.
struct Fraction {
    num: int;
    den: int;
}
fn frac(num: int, den: int) -> Fraction { return Fraction { num: num, den: den }; }
fn frac_gcd(a: int, b: int) -> int {
    let mut x: int = a;
    let mut y: int = b;
    if x < 0 { x = 0 - x; }
    if y < 0 { y = 0 - y; }
    while y != 0 {
        let t: int = y;
        y = x % y;
        x = t;
    }
    return x;
}
fn frac_reduce(f: Fraction) -> Fraction {
    let g: int = frac_gcd(f.num, f.den);
    return Fraction { num: f.num / g, den: f.den / g };
}
fn frac_add(a: Fraction, b: Fraction) -> Fraction {
    return frac_reduce(Fraction { num: a.num * b.den + b.num * a.den, den: a.den * b.den });
}
fn frac_sub(a: Fraction, b: Fraction) -> Fraction {
    return frac_reduce(Fraction { num: a.num * b.den - b.num * a.den, den: a.den * b.den });
}
fn frac_mul(a: Fraction, b: Fraction) -> Fraction {
    return frac_reduce(Fraction { num: a.num * b.num, den: a.den * b.den });
}
fn frac_div(a: Fraction, b: Fraction) -> Fraction {
    return frac_reduce(Fraction { num: a.num * b.den, den: a.den * b.num });
}
fn frac_to_float(f: Fraction) -> float { return (f.num as float) / (f.den as float); }
fn frac_equal(a: Fraction, b: Fraction) -> bool {
    let ra: Fraction = frac_reduce(a);
    let rb: Fraction = frac_reduce(b);
    return ra.num == rb.num && ra.den == rb.den;
}
