// sorting: small array sorts and helpers. Pure functions, no dependencies.
fn bubble_sort_int(xs: [int]) -> [int] {
    let mut out: [int] = [];
    let mut i: int = 0;
    while i < len(xs) { push(out, xs[i]); i = i + 1; }
    let mut a: int = 0;
    while a < len(out) {
        let mut b: int = 0;
        while b + 1 < len(out) - a {
            if out[b] > out[b + 1] {
                let t: int = out[b];
                out[b] = out[b + 1];
                out[b + 1] = t;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return out;
}
fn bubble_sort_float(xs: [float]) -> [float] {
    let mut out: [float] = [];
    let mut i: int = 0;
    while i < len(xs) { push(out, xs[i]); i = i + 1; }
    let mut a: int = 0;
    while a < len(out) {
        let mut b: int = 0;
        while b + 1 < len(out) - a {
            if out[b] > out[b + 1] {
                let t: float = out[b];
                out[b] = out[b + 1];
                out[b + 1] = t;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    return out;
}
fn is_sorted_int(xs: [int]) -> bool {
    let mut i: int = 0;
    while i + 1 < len(xs) {
        if xs[i] > xs[i + 1] { return false; }
        i = i + 1;
    }
    return true;
}
fn is_sorted_float(xs: [float]) -> bool {
    let mut i: int = 0;
    while i + 1 < len(xs) {
        if xs[i] > xs[i + 1] { return false; }
        i = i + 1;
    }
    return true;
}
fn reverse_int(xs: [int]) -> [int] {
    let mut out: [int] = [];
    let mut i: int = len(xs) - 1;
    while i >= 0 { push(out, xs[i]); i = i - 1; }
    return out;
}
fn reverse_float(xs: [float]) -> [float] {
    let mut out: [float] = [];
    let mut i: int = len(xs) - 1;
    while i >= 0 { push(out, xs[i]); i = i - 1; }
    return out;
}
