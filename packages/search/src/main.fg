import "search.fg";
fn main() -> int {
    let mut bad: int = 0;
    if linear_search_int([10, 20, 30], 20) != 1 { println("FAIL linear found"); bad = 1; }
    if linear_search_int([10, 20, 30], 99) != -1 { println("FAIL linear missing"); bad = 1; }
    if linear_search_str(["a", "b", "c"], "b") != 1 { println("FAIL linear str"); bad = 1; }
    if binary_search_int([1, 3, 5, 7, 9], 7) != 3 { println("FAIL binary found"); bad = 1; }
    if binary_search_int([1, 3, 5, 7, 9], 4) != -1 { println("FAIL binary missing"); bad = 1; }
    if count_int([1, 2, 2, 3, 2], 2) != 3 { println("FAIL count"); bad = 1; }
    if !contains_int([1, 2], 2) { println("FAIL contains true"); bad = 1; }
    if contains_int([1, 2], 9) { println("FAIL contains false"); bad = 1; }
    println("search demo: index of 20 in [10,20,30] =", linear_search_int([10, 20, 30], 20));
    if bad == 0 { println("search demo ok"); }
    return bad;
}
